@* The description belongs to the field, so it is announced after the name rather than as part
   of it — and the switch stays a switch rather than becoming a paragraph with a control in it. *@
<Field Orientation="horizontal" Class="w-[440px] items-start">
    <FieldContent>
        <FieldLabel For="sw-tracking">Share anonymous usage data</FieldLabel>
        <FieldDescription>Counts of which screens are opened. No content, ever.</FieldDescription>
    </FieldContent>
    <Switch id="sw-tracking" name="tracking" value="yes" />
</Field>
