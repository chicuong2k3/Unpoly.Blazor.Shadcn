@* The whole card is the label, so the panel is the hit target and the state is legible from the
   border — has-[:checked] reading the input rather than a copy of it. *@
<RadioGroup Class="w-[460px]">
    @foreach (var (id, title, price) in Options)
    {
        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-lg border p-4 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-start gap-3">
                <RadioGroupItem id="@id" name="shipping" value="@id" Class="mt-0.5" checked="@(id == "standard")" />
                <span class="flex flex-col gap-1">
                    <span class="text-sm font-medium">@title</span>
                    <span class="text-sm text-muted-foreground">Arrives in 2–4 working days.</span>
                </span>
            </span>
            <span class="num text-sm">@price</span>
        </label>
    }
</RadioGroup>

@code {
    static readonly (string Id, string Title, string Price)[] Options =
    [
        ("standard", "Standard", "Free"), ("express", "Express", "$12"),
    ];
}
