@* Consecutive turns by one author, drawn as one block and named once rather than once per
   bubble — which is the difference between hearing "From Mai Linh" and hearing it three times. *@
<div class="flex w-[440px] flex-col gap-3">
    <BubbleGroup AriaLabel="From Mai Linh">
        <Bubble Variant="muted"><BubbleContent>Did the invoice go out?</BubbleContent></Bubble>
        <Bubble Variant="muted"><BubbleContent>No rush.</BubbleContent></Bubble>
        <Bubble Variant="muted"><BubbleContent>Whenever you get a minute.</BubbleContent></Bubble>
    </BubbleGroup>
</div>
