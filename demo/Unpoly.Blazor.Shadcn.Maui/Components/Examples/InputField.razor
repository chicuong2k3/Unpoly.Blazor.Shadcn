@* A label, a control and a description, tied together by the field rather than by three
   hand-written ids. *@
<Field Class="w-[360px]">
    <FieldLabel For="in-email">Email</FieldLabel>
    <Input id="in-email" name="email" type="email" placeholder="you@example.com" />
    <FieldDescription>We only use it for receipts.</FieldDescription>
</Field>
