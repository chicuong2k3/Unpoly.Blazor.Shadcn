@* A real tooltip card, not a title attribute. Recharts draws its onto a canvas that nothing else
   can read; this one is an element, filled from the data attributes of the bar under the pointer
   and positioned by ui.js.

   The chart is still a table, so every number stays in the DOM for a screen reader, a print
   stylesheet and Find in Page. The card is the pointer view of the same data — which is why it
   is aria-hidden and why nothing breaks when it never appears. *@
<Chart Id="tooltip" Series="@Palette" Class="h-[240px] w-full max-w-lg">
    <table class="h-full w-full">
        <caption class="sr-only">Desktop and mobile visitors by month</caption>
        <thead class="sr-only">
            <tr><th scope="col">Month</th><th scope="col">Desktop</th><th scope="col">Mobile</th></tr>
        </thead>
        <tbody class="flex h-full items-stretch gap-3 pb-5">
            @foreach (var (month, desktop, mobile) in Months)
            {
                <tr class="flex flex-1 flex-col justify-end">
                    <td class="flex flex-1 items-end gap-1" data-chart-point
                        data-chart-label="@month"
                        data-chart-series="desktop,mobile"
                        data-chart-name="Desktop,Mobile"
                        data-chart-value="@desktop,@mobile">
                        <span class="flex-1 rounded-t-[4px]"
                              style="@($"height: {desktop * 100 / 320}%; background: var(--color-desktop)")"></span>
                        <span class="flex-1 rounded-t-[4px]"
                              style="@($"height: {mobile * 100 / 320}%; background: var(--color-mobile)")"></span>
                        <span class="sr-only">Desktop @desktop, mobile @mobile</span>
                    </td>
                    <th scope="row" class="pt-2.5 text-center text-xs font-normal text-muted-foreground">
                        @month[..3]
                    </th>
                </tr>
            }
        </tbody>
    </table>

    <ChartTooltip />
</Chart>

@code {
    static readonly Dictionary<string, string> Palette = new()
    {
        ["desktop"] = "var(--chart-1)",
        ["mobile"] = "var(--chart-2)",
    };

    static readonly (string Month, int Desktop, int Mobile)[] Months =
    [
        ("January", 186, 80), ("February", 305, 200), ("March", 237, 120),
        ("April", 73, 190), ("May", 209, 130), ("June", 214, 140),
    ];
}
