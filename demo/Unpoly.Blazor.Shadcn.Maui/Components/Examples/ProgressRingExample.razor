@* A dial rather than a bar: the same role="progressbar", the same value, read at a glance from
   anywhere on the panel. Pure SVG — no script, no animation driver. *@
<div class="flex flex-wrap items-center gap-6">
    <ProgressRing Value="12" AriaLabel="Uploaded" />
    <ProgressRing Value="64" AriaLabel="Analysed" />
    <ProgressRing Value="100" AriaLabel="Complete" />
</div>
