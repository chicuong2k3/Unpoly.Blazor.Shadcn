@* This is the public visual primitive, not an <option> child: an option cannot contain
   markup. The enhanced Select builds its own indicator in ui.js. *@
<div class="flex flex-col gap-3">
    <Field Class="w-[220px]">
        <FieldLabel For="si-indicator-example">Product type</FieldLabel>
        <Select id="si-indicator-example" name="indicator-product">
            <SelectItem Value="top" Selected>Top</SelectItem>
            <SelectItem Value="shoes">Shoes</SelectItem>
        </Select>
    </Field>
    @* flex items-center, as on a real SelectItem: the indicator is absolute with no top, so it sits
       where the row's own alignment would put it — in a block that is below the text. *@
    <div class="relative flex w-[220px] items-center rounded-md border border-border px-3 py-2 pe-9 text-control">
        <span>Indicator preview</span>
        <SelectItemIndicator aria-hidden="true"><Icon Name="check" Class="size-3.5" /></SelectItemIndicator>
    </div>
</div>
