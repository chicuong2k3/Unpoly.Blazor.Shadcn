<Menubar>
    <MenubarMenu>
        <MenubarTrigger Target="mbr-zoom">Zoom</MenubarTrigger>
        <MenubarContent Id="mbr-zoom">
            <MenubarLabel Inset>Level</MenubarLabel>
            <MenubarRadioGroup>
                <MenubarRadioItem Name="mbr" Value="100" Checked>100%</MenubarRadioItem>
                <MenubarRadioItem Name="mbr" Value="125">125%</MenubarRadioItem>
                <MenubarRadioItem Name="mbr" Value="150">150%</MenubarRadioItem>
            </MenubarRadioGroup>
        </MenubarContent>
    </MenubarMenu>
</Menubar>
