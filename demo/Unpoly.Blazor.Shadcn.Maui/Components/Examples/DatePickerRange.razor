@* A range is two inputs with two names, which is also what a server wants to read — and it means
   the second one can refuse a date before the first without any script. *@
<div class="flex w-[420px] items-end gap-3">
    <Field Class="flex-1">
        <FieldLabel For="dp-from">From</FieldLabel>
        <DatePicker id="dp-from" name="from" value="2026-03-11" max="2026-12-31" />
    </Field>
    <Field Class="flex-1">
        <FieldLabel For="dp-to">To</FieldLabel>
        <DatePicker id="dp-to" name="to" value="2026-03-18" min="2026-03-11" />
    </Field>
</div>
