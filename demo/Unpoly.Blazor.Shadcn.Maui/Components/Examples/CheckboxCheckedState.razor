@* Three states, and the third is the platform's: `indeterminate` is a DOM property rather than
   an attribute, so it is set by the compiler on a parent box whose children disagree. *@
<div data-select-scope class="flex flex-col gap-3">
    <Field Orientation="horizontal">
        <Checkbox id="c-mixed" data-select-all="demo-checkbox-state" />
        <FieldLabel For="c-mixed">Select all — some children selected</FieldLabel>
    </Field>
    <Field Orientation="horizontal">
        <Checkbox id="c-on" name="demo-checkbox-state" checked />
        <FieldLabel For="c-on">Checked</FieldLabel>
    </Field>
    <Field Orientation="horizontal">
        <Checkbox id="c-off" name="demo-checkbox-state" />
        <FieldLabel For="c-off">Unchecked</FieldLabel>
    </Field>
</div>
