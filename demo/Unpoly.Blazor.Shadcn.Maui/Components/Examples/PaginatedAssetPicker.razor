@namespace Unpoly.Blazor.Shadcn.Maui.Components.Examples
<DialogTrigger Target="creative-assets">Choose assets</DialogTrigger>
<AssetPicker Id="creative-assets" Items="@Items">
    <FilterContent>
        <p>Browse 101 example assets, ten at a time. Select items on different pages and return to check your selection.</p>
        <nav aria-label="Asset pages">
            <button type="button" @onclick="() => page = 1">Page 1</button>
            <button type="button" @onclick="() => page = 2">Page 2</button>
            <button type="button" @onclick="() => page = 11">Page 11</button>
        </nav>
    </FilterContent>
</AssetPicker>
@code {
    int page = 1;
    const string Photo = "_content/Unpoly.Blazor.Shadcn/media-demo.svg";
    IReadOnlyList<MediaAsset> Items => Enumerable.Range((page - 1) * 10, 10)
        .Where(i => i < 101).Select(Asset).ToArray();
    // The shared SVG is a stand-in for a thumbnail; the query string distinguishes the full URL.
    static MediaAsset Asset(int i) => i switch {
        0 => new MediaAsset("landscape", Photo, "Mountain landscape"),
        1 => new MediaAsset("reference", Photo, "Reference image"),
        10 => new MediaAsset("sketch", Photo, "Concept sketch"),
        11 => new MediaAsset("texture", Photo, "Texture reference"),
        _ => new MediaAsset($"asset-{i}", $"{Photo}?full={i}", $"Example asset {i}") { ThumbnailSrc = Photo }
    };
}
