@* The whole card is the label, so the entire panel is the hit target and the state is legible
   from the border — has-[:checked] on the label, reading the input rather than a copy of it. *@
<div class="flex w-[460px] flex-col gap-3">
    @foreach (var (id, title, note) in Options)
    {
        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-lg border p-4 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex flex-col gap-1">
                <span class="text-sm font-medium">@title</span>
                <span class="text-sm text-muted-foreground">@note</span>
            </span>
            <Switch id="@id" name="@id" value="yes" />
        </label>
    }
</div>

@code {
    static readonly (string Id, string Title, string Note)[] Options =
    [
        ("emails", "Order emails", "A receipt when an order is placed, and a note when it ships."),
        ("sms", "Text messages", "Only for delivery windows. Standard rates apply."),
    ];
}
