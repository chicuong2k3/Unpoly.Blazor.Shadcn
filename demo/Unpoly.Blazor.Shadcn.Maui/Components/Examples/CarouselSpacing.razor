@* The gap is a negative margin on the track and padding on each item, which is upstream's own
   trick: it keeps the first and last slides flush with the edges while the middle ones are
   spaced. Change both numbers together or the ends drift. *@
<div class="relative w-full max-w-[12rem] px-12 sm:max-w-xs md:max-w-sm">
    <Carousel AriaLabel="Wider gaps">
        <CarouselContent Class="-ms-1">
            @foreach (var n in Enumerable.Range(1, 5))
            {
                <CarouselItem Class="basis-1/2 ps-1 lg:basis-1/3">
                    <div class="p-1">
                        <Card>
                            <CardContent Class="flex aspect-square items-center justify-center p-6">
                                <span class="num text-2xl font-semibold">@n</span>
                            </CardContent>
                        </Card>
                    </div>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious />
        <CarouselNext />
    </Carousel>
</div>
