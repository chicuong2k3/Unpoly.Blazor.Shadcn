@* The whole card is the label, so the panel is the hit target and the chosen state is legible
   from the border — has-[:checked] reading the input rather than a second copy of the truth. *@
<RadioGroup Class="w-[460px]">
    @foreach (var (id, title, note, price) in Plans)
    {
        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-lg border p-4 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-start gap-3">
                <RadioGroupItem id="@id" name="plan" value="@id" Class="mt-0.5" checked="@(id == "pro")" />
                <span class="flex flex-col gap-1">
                    <span class="text-sm font-medium">@title</span>
                    <span class="text-sm text-muted-foreground">@note</span>
                </span>
            </span>
            <span class="num text-sm">@price</span>
        </label>
    }
</RadioGroup>

@code {
    static readonly (string Id, string Title, string Note, string Price)[] Plans =
    [
        ("free", "Free", "One project, community support.", "$0"),
        ("pro", "Pro", "Unlimited projects, email support.", "$19"),
    ];
}
