@* Left and Right swap along the bar, because the compiler moves focus by reading order rather
   than by screen position. *@
<div dir="rtl">
    <Menubar>
        <MenubarMenu>
            <MenubarTrigger Target="mb-rtl-file">ملف</MenubarTrigger>
            <MenubarContent Id="mb-rtl-file">
                <MenubarItem>علامة تبويب جديدة</MenubarItem>
                <MenubarItem>نافذة جديدة</MenubarItem>
            </MenubarContent>
        </MenubarMenu>
        <MenubarMenu>
            <MenubarTrigger Target="mb-rtl-edit">تحرير</MenubarTrigger>
            <MenubarContent Id="mb-rtl-edit">
                <MenubarItem>تراجع</MenubarItem>
            </MenubarContent>
        </MenubarMenu>
    </Menubar>
</div>
