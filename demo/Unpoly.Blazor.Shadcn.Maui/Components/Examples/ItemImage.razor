@* A thumbnail rather than an icon. Real width and height on the image, so the row does not
   change height as it loads. *@
<Item Variant="outline" Class="w-[420px]">
    <ItemMedia Class="overflow-hidden rounded-md">
        <img src="https://placehold.co/96" alt="" width="96" height="96" loading="lazy"
             class="size-12 object-cover" />
    </ItemMedia>
    <ItemContent>
        <ItemTitle>Weekender</ItemTitle>
        <ItemDescription>Waxed canvas, leather trim</ItemDescription>
    </ItemContent>
    <ItemActions><span class="num text-sm">$189</span></ItemActions>
</Item>
