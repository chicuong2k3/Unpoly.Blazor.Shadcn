@* Any control, not only InputGroupControl. What the frame needs is a child that fills it and
   draws no border of its own — a select, a date input, a file input all qualify. *@
<div class="flex w-[420px] flex-col gap-4">
    <InputGroup>
        <InputGroupAddon><Icon Name="calendar" /></InputGroupAddon>
        <input type="date" name="from" value="2026-03-11"
               class="min-w-0 flex-1 bg-transparent px-3 text-control outline-none" aria-label="From" />
    </InputGroup>

    <InputGroup>
        <InputGroupAddon><Icon Name="folder" /></InputGroupAddon>
        <select name="folder" class="min-w-0 flex-1 appearance-none bg-transparent px-3 text-control outline-none"
                aria-label="Folder">
            <option>Contracts</option>
            <option>Invoices</option>
        </select>
    </InputGroup>
</div>
