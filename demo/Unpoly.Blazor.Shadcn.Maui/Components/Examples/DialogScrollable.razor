@* Everything scrolls, header included. Reach for this when the header is not worth the vertical
   space on a phone — and for the other case, pin it, which is the example above. *@
<DialogTrigger Target="dlg-scroll">Open</DialogTrigger>

<Dialog Id="dlg-scroll" Class="max-h-[70vh] overflow-y-auto">
    <DialogHeader>
        <DialogTitle>Release notes</DialogTitle>
        <DialogDescription>Everything in 2.4.</DialogDescription>
    </DialogHeader>
    <div class="flex flex-col gap-3 px-6 text-sm text-muted-foreground">
        @foreach (var n in Enumerable.Range(1, 14))
        {
            <p>Change @n — one line about what moved and why.</p>
        }
    </div>
</Dialog>
