@* useLayouts' menu with its five buttons. Open one, then another — the panel morphs from one
   size to the next and the new content blurs in. A click outside or Escape closes it; that is
   the popover's own light dismiss, not code. The panels' contents are ordinary markup. *@
<div class="flex h-80 w-full items-end justify-center pb-2">
    <BottomMenu Label="Quick actions">
        <BottomMenuItem Value="new" Label="New">
            <IconContent><Icon Name="plus" /></IconContent>
            <ChildContent>
            <div class="min-w-[210px] space-y-0.5 p-1.5 py-0.5">
                <button type="button" class="@Row"><Icon Name="pencil" Class="size-5" />Note</button>
                <button type="button" class="@Row"><Icon Name="mic" Class="size-5" />Voice</button>
                <button type="button" class="@Row"><Icon Name="camera" Class="size-5" />Screenshot</button>
            </div>
            </ChildContent>
        </BottomMenuItem>
        <BottomMenuItem Value="search" Label="Search">
            <IconContent><Icon Name="search" /></IconContent>
            <ChildContent>
            <div class="w-[240px] space-y-2 p-2 py-1 md:min-w-[270px]">
                <InputGroup>
                    <InputGroupAddon><Icon Name="search" /></InputGroupAddon>
                    <InputGroupControl type="search" placeholder="Search..." aria-label="Search" />
                </InputGroup>
                <div class="flex gap-1.5">
                    <button type="button" class="@Chip"><Icon Name="sliders-horizontal" Class="size-3.5" />Filter</button>
                    <button type="button" class="@Chip"><Icon Name="trending-up" Class="size-3.5" />Trending</button>
                </div>
            </div>
            </ChildContent>
        </BottomMenuItem>
        <BottomMenuItem Value="notifications" Label="Notifications">
            <IconContent><Icon Name="bell" /></IconContent>
            <ChildContent>
            <div class="min-w-[210px] space-y-0.5 p-1.5 py-0.5">
                <button type="button" class="@Row">Messages</button>
                <button type="button" class="@Row">System alerts</button>
            </div>
            </ChildContent>
        </BottomMenuItem>
        <BottomMenuItem Value="profile" Label="Profile">
            <IconContent><Icon Name="user" /></IconContent>
            <ChildContent>
            <div class="w-[200px] space-y-0.5 p-1.5 py-0.5 md:min-w-[230px]">
                <a href="/live-demo" class="@Row">My account</a>
                <a href="/theming" class="@Row">Settings</a>
                <a href="/blocks" class="@Row">Subscription / billing</a>
                <Separator Class="my-0.5" />
                <button type="button" class="@Danger">Log out</button>
            </div>
            </ChildContent>
        </BottomMenuItem>
    </BottomMenu>
</div>

@code {
    // Upstream's shared row: muted until hovered, 12px corners inside the 18px panel.
    const string Row = "flex w-full items-center gap-3 rounded-[12px] px-3 py-2 text-start text-[15px] text-muted-foreground transition-all duration-75 hover:bg-muted/80 hover:text-foreground";
    // Its own string, not Row plus text-destructive: two colour utilities on one element are
    // settled by stylesheet order, and muted came later.
    const string Danger = "flex w-full items-center gap-3 rounded-[12px] px-3 py-2 text-start text-[15px] text-destructive transition-all duration-75 hover:bg-destructive/10";
    const string Chip = "flex flex-1 items-center justify-center gap-1.5 rounded-[12px] bg-muted px-3 py-2 text-[15px] text-muted-foreground transition-all duration-75 hover:bg-accent hover:text-foreground";
}
