@* Two sizes, as upstream: data-size on the input, which is what the recipe keys off. *@
<div class="flex items-center gap-6">
    <Field Orientation="horizontal">
        <FieldLabel For="sw-md">Default</FieldLabel>
        <Switch id="sw-md" checked />
    </Field>
    <Field Orientation="horizontal">
        <FieldLabel For="sw-sm">Small</FieldLabel>
        <Switch id="sw-sm" Size="sm" checked />
    </Field>
</div>
