@* Vertical is CSS: writing-mode on the input, and the browser rotates its own track and thumb.
   The keys follow — Up increases — with nothing bound. *@
<div class="flex h-48 items-end gap-8">
    <Slider name="bass" Orientation="vertical" Value="70" aria-label="Bass" />
    <Slider name="mid" Orientation="vertical" Value="45" aria-label="Mid" />
    <Slider name="treble" Orientation="vertical" Value="60" aria-label="Treble" />
</div>
