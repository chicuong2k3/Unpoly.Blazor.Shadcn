@* The thumb travels the other way on its own: it is placed with `place-items: center start`, a
   logical value, and translated by a logical distance. *@
<div dir="rtl" class="flex w-[440px] flex-col gap-3">
    <Field Orientation="horizontal">
        <FieldLabel For="sw-rtl-1">منشور</FieldLabel>
        <Switch id="sw-rtl-1" checked />
    </Field>
    <Field Orientation="horizontal">
        <FieldLabel For="sw-rtl-2">مميز</FieldLabel>
        <Switch id="sw-rtl-2" />
    </Field>
</div>
