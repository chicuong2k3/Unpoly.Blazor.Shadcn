@* How many slides fit is basis-* on the item, so it is a class and it is responsive. Nothing
   measures anything. *@
<div class="relative w-full max-w-[12rem] px-12 sm:max-w-xs md:max-w-sm">
    <Carousel AriaLabel="Several at a time">
        <CarouselContent>
            @foreach (var n in Enumerable.Range(1, 5))
            {
                <CarouselItem Class="basis-1/2 lg:basis-1/3">
                    <div class="p-1">
                        <Card>
                            <CardContent Class="flex aspect-square items-center justify-center p-6">
                                <span class="num text-3xl font-semibold">@n</span>
                            </CardContent>
                        </Card>
                    </div>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious />
        <CarouselNext />
    </Carousel>
</div>
