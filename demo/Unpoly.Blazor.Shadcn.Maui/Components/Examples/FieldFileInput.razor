<Field Class="w-[380px]">
    <FieldLabel For="fi-receipt-maui">Receipt attachment</FieldLabel>
    <FileInput Id="fi-receipt-maui" Accept=".pdf,image/*"
               Prompt="No file selected" Hint="PDF, PNG, or JPG up to your app limit"
               ChooseLabel="Browse" AriaLabel="Choose receipt attachment" />
    <FieldDescription>Use FileInput when the form needs a styled upload control.</FieldDescription>
</Field>
