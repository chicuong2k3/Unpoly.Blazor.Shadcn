@* The columns run from the reading edge because a table follows the document direction, and the
   month navigation flips with it. *@
<div dir="rtl">
    <Calendar Name="day-rtl" Month="@(new DateOnly(2026, 3, 1))" Today="@(new DateOnly(2026, 3, 11))"
              MonthUrl="@(m => $"/components/calendar?month={m:yyyy-MM}")"
              Class="w-fit rounded-lg border p-3" />
</div>
