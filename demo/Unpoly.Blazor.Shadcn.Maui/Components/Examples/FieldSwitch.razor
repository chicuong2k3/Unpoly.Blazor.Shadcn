@* A switch usually wants the label first and the control at the far end, which is the layout a
   settings screen has — so the field is horizontal and the switch is pushed with ms-auto. *@
<Field Orientation="horizontal" Class="w-[380px]">
    <FieldLabel For="fsw-published">Published</FieldLabel>
    <Switch id="fsw-published" name="published" value="yes" Class="ms-auto" checked />
</Field>
