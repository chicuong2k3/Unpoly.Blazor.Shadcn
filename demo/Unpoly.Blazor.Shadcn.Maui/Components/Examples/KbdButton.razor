@* The hint on the button that does the thing. It is the standard way to teach a shortcut, and
   the reason the search box in this site's own header carries one. *@
<div class="flex flex-wrap items-center gap-3">
    <Button Variant="outline" Class="w-56 justify-between text-muted-foreground">
        <span class="flex items-center gap-2"><Icon Name="search" />Search…</span>
        <KbdGroup><Kbd>⌘</Kbd><Kbd>K</Kbd></KbdGroup>
    </Button>
    <Button Variant="secondary">Save<KbdGroup Class="ms-2"><Kbd>⌘</Kbd><Kbd>S</Kbd></KbdGroup></Button>
</div>
