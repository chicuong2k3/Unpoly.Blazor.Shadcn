@* Consecutive turns by one author. The avatar appears once, which is what makes a thread read as
   a conversation rather than as a list of identical rows. *@
<MessageGroup Class="w-[440px]">
    <Message>
        <MessageAvatar><Avatar><AvatarFallback>ML</AvatarFallback></Avatar></MessageAvatar>
        <MessageContent>
            <MessageHeader><span class="font-medium">Mai Linh</span></MessageHeader>
            <BubbleGroup AriaLabel="From Mai Linh">
                <Bubble Variant="muted"><BubbleContent>Did the invoice go out?</BubbleContent></Bubble>
                <Bubble Variant="muted"><BubbleContent>No rush.</BubbleContent></Bubble>
            </BubbleGroup>
        </MessageContent>
    </Message>
</MessageGroup>
