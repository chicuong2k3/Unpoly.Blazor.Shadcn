@* Radix computes a padding-bottom trick; CSS has had aspect-ratio for years. *@
<AspectRatio Ratio="16 / 9" Class="w-[320px] overflow-hidden rounded-lg bg-muted">
    <div class="grid size-full place-items-center text-sm text-muted-foreground">16 / 9</div>
</AspectRatio>
<AspectRatio Ratio="1" Class="w-[160px] overflow-hidden rounded-lg bg-muted">
    <div class="grid size-full place-items-center text-sm text-muted-foreground">1 / 1</div>
</AspectRatio>
