@* A toast with something to do. Keep it to an undo or a link: a toast disappears, so anything
   that has to be done cannot live only in one. *@
<div class="flex flex-wrap items-center gap-3">
    <Button Variant="outline"
            data-toast='{"text":"Order archived","type":"success","action":{"label":"Undo","toast":{"text":"Restored"}}}'>
        With an undo
    </Button>
</div>
