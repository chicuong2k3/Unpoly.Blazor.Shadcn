@* A rule between two buttons that are joined but not the same kind of thing. It is a Separator
   with the group's own colour, which is why upstream gives the slot bg-input rather than
   bg-border. *@
<ButtonGroup>
    <Button Variant="outline">Save</Button>
    <ButtonGroupSeparator />
    <Button Variant="outline">Save and close</Button>
</ButtonGroup>
