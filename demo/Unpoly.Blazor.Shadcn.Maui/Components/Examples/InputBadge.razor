@* A status beside the label, for a field whose state is worth saying before it is read. *@
<Field Class="w-[360px]">
    <div class="flex items-center justify-between gap-2">
        <FieldLabel For="in-domain">Custom domain</FieldLabel>
        <Badge Variant="secondary">Verified</Badge>
    </div>
    <Input id="in-domain" name="domain" value="shop.example.com" />
</Field>
