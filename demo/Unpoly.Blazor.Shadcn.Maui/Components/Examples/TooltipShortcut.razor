@* Where the shortcut does not fit on the control itself. It opens on focus as well as on hover,
   so the hint is reachable by the keyboard it describes. *@
<div class="flex items-center gap-3">
    <TooltipTrigger Target="tip-save" Variant="outline" Size="icon" aria-label="Save">
        <Icon Name="upload" />
    </TooltipTrigger>
    <TooltipContent Id="tip-save">
        Save <KbdGroup Class="ms-1"><Kbd>⌘</Kbd><Kbd>S</Kbd></KbdGroup>
    </TooltipContent>
</div>
