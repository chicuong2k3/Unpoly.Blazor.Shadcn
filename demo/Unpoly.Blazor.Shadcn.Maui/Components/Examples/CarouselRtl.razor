@* Nothing to configure: scroll-snap runs in the inline direction, so the slides start from the
   reading edge and the arrows scroll the right way. *@
<div dir="rtl" class="relative w-full max-w-lg px-12">
    <Carousel AriaLabel="عرض">
        <CarouselContent>
            @foreach (var n in Enumerable.Range(1, 6))
            {
                <CarouselItem Class="basis-1/2 md:basis-1/3">
                    <Card Class="m-1"><CardContent Class="flex aspect-square items-center justify-center p-6">
                        <span class="num text-2xl font-semibold">@n</span>
                    </CardContent></Card>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious />
        <CarouselNext />
    </Carousel>
</div>
