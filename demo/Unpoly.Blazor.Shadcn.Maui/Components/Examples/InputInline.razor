@* Label beside the control rather than above it, which is what a horizontal Field is for — and
   why it is an attribute the recipe reads rather than a class to remember. *@
<FieldGroup Class="w-[460px]">
    <Field Orientation="horizontal">
        <FieldLabel For="il-width" Class="w-24">Width</FieldLabel>
        <Input id="il-width" name="width" type="number" value="1280" />
    </Field>
    <Field Orientation="horizontal">
        <FieldLabel For="il-height" Class="w-24">Height</FieldLabel>
        <Input id="il-height" name="height" type="number" value="720" />
    </Field>
</FieldGroup>
