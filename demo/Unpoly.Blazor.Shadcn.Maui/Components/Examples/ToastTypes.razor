@* Sonner's API over Toastify: toast(), toast.success(), toast.error(). The call sites read the
   same, which is the point — a model that knows sonner writes this correctly first time. *@
<div class="flex flex-wrap items-center gap-3">
    <Button Variant="outline" data-toast='{"text":"Saved"}'>Default</Button>
    <Button Variant="outline" data-toast='{"text":"Order refunded","type":"success"}'>Success</Button>
    <Button Variant="outline" data-toast='{"text":"The card was declined","type":"error"}'>Error</Button>
    <Button Variant="outline" data-toast='{"text":"Two addresses on this account","type":"info"}'>Info</Button>
</div>
