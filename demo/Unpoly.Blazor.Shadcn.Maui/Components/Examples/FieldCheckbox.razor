@* Horizontal, which is what a checkbox wants: the label belongs beside the box, not above it.
   That is an attribute the recipe reads rather than a class to remember. *@
<Field Orientation="horizontal" Class="w-[380px]">
    <Checkbox id="fc-terms" name="terms" value="yes" />
    <FieldLabel For="fc-terms">Accept the terms</FieldLabel>
</Field>
