@page "/components/creative-media"
<PageTitle>Creative Media — Unpoly.Blazor.Shadcn</PageTitle>
<h1 class="doc-h1">Creative Media</h1>
<p class="doc-lede">A focused workspace for masks, annotations and media clips.</p>
<Button Href="/components/creative-media/audit" Variant="outline" data-audit-link>View component audit cases</Button>
<div data-creative-workspace>
    <section data-creative-section data-creative-editor>
        <header data-creative-heading>
            <div><h2>Canvas editor</h2><p>Draw a mask, position an annotation, then export your work.</p></div>
            <Badge Variant="secondary">640 × 480</Badge>
        </header>
        <div data-creative-body>
            <ImageCanvas Src="@Photo" Width="640" Height="480">
                <MaskBrush Size="24" Opacity="0.8" />
                <DraggableOverlay CoordinateWidth="640" CoordinateHeight="480"><p>Annotation</p></DraggableOverlay>
            </ImageCanvas>
            <details data-creative-help><summary>Keyboard shortcuts</summary><p>Canvas: arrows pan, +/− zoom, Home fits. Mask: arrows move, Space paints, Shift + arrows draws. Overlay: focus Move or Resize and use arrows; Shift makes larger steps.</p></details>
            <div data-creative-timeline-heading><h3>Timeline</h3><span>30 seconds · 2 tracks</span></div>
            <MediaTimeline Duration="30" Clips="@Clips" />
            <p data-creative-hint>Drag a clip to move it; drag its edge to trim. With a handle focused, Left/Right edits time and Up/Down on the clip changes tracks.</p>
        </div>
    </section>
    <section data-creative-section>
        <header data-creative-heading>
            <div><h2>Asset library</h2><p>Preview your references or choose assets for the editor.</p></div>
            <DialogTrigger Target="creative-assets">Choose assets</DialogTrigger>
        </header>
        <div data-creative-body>
            <MediaGrid Items="@MediaItems" LightboxTarget="creative-preview" />
            <details data-creative-help><summary>Video without a thumbnail</summary><MediaGrid Items="@VideoItems" Label="Video without a thumbnail" /></details>
        </div>
        <MediaLightbox Id="creative-preview" Items="@MediaItems" />
        <AssetPicker Id="creative-assets" Items="@MediaItems">
            <FilterContent><p data-creative-hint>Select references for your canvas. The footer tracks all selections; Clear selection removes them across pages.</p></FilterContent>
        </AssetPicker>
    </section>
    <div data-creative-image-tools>
        <section data-creative-section data-creative-comparison>
            <header data-creative-heading><div><h2>Image comparison</h2><p>Drag the divider to compare the original and edited image.</p></div></header>
            <div data-creative-body><ImageCompare BeforeSrc="@Photo" AfterSrc="@Photo" InitialPosition="30" Label="Compare original and edited image" BeforeLabel="Original" AfterLabel="Edited" /></div>
        </section>
        <section data-creative-section>
            <header data-creative-heading><div><h2>Image crop</h2><p>Free crop resizes each edge independently. Choose a ratio to lock the shape.</p></div></header>
            <div data-creative-body><ImageCrop Src="@Photo" MaxImageSize="2097152" ApplyLabel="Export PNG" /></div>
        </section>
    </div>
</div>
@code {
    const string Photo = "_content/Unpoly.Blazor.Shadcn/media-demo.svg";
    static readonly IReadOnlyList<MediaAsset> MediaItems = new[] {
        new MediaAsset("landscape", Photo, "Mountain landscape"),
        new MediaAsset("reference", Photo, "Reference image")
    };
    static readonly IReadOnlyList<MediaAsset> VideoItems = new[] {
        new MediaAsset("flower", "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4", "Flower clip") { IsVideo = true }
    };
    static readonly IReadOnlyList<MediaClip> Clips = new[] {
        new MediaClip("intro", "Introduction", 0, 8),
        new MediaClip("scene", "Scene", 10, 12, 1)
    };
}
