@page "/theming"

<PageTitle>Theming — Unpoly.Blazor.Shadcn</PageTitle>

<h1 class="doc-h1">Theming</h1>
<p class="doc-lede">
    A theme is a set of CSS custom properties. Choose one in the header to recolour this page
    without rebuilding; components read the same tokens in both Web and MAUI.
</p>

<h2 class="doc-h2">Live tokens</h2>
<p class="doc-note">These swatches read CSS variables directly. Try the header's theme and dark-mode controls.</p>
<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    @foreach (var token in Tokens)
    {
        <div class="rounded-xl border bg-card p-3 text-card-foreground">
            <span class="block h-12 rounded-lg border" style="@($"background:var(--{token})")"></span>
            <p class="mt-2 text-xs font-medium">--@token</p>
        </div>
    }
</div>
<p class="doc-note">
    In addition to shadcn's colour, chart, sidebar and radius tokens, this port provides
    <code>--control-h</code>, <code>--control-text</code>, <code>--radius-control</code>,
    <code>--elevation-1..4</code>, <code>--ease-ui</code>, <code>--duration-ui</code> and
    <code>--font-numeric</code>. These are additive; class recipes stay in sync with upstream.
</p>

<h2 class="doc-h2">One component tree, six themes</h2>
<p class="doc-note">
    Each card sets <code>data-theme</code> on its wrapper. To theme the whole app, set it on
    <code>&lt;html&gt;</code> instead. The controls below have identical markup in every card.
</p>
<div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    @foreach (var theme in PreviewThemes)
    {
        <div data-theme="@theme" class="rounded-xl border bg-background p-5 text-foreground">
            <p class="num mb-3 text-xs text-muted-foreground">@theme</p>
            <div class="flex flex-wrap items-center gap-2">
                <Button Variant="default" Size="sm">Save</Button>
                <Button Variant="outline" Size="sm">Cancel</Button>
                <Badge Variant="secondary">New</Badge>
            </div>
            <Input Type="text" name="@($"theme-{theme}")" placeholder="Email" Class="mt-3" />
        </div>
    }
</div>

<h2 class="doc-h2">Use a theme</h2>
<p class="doc-note">Switch tabs to copy the import or the attribute. Import the CSS before your own overrides.</p>
<Snippet Items="@Setup" />

<h2 class="doc-h2">Write your own</h2>
<p class="doc-note">
    Define the light and dark palettes under the same name. The filename tabs and copy button
    below are the library's <code>CodeBlock</code>; copying always uses the selected file.
</p>
<CodeBlock Files="@ThemeFiles" ShowFileLineNumbers="false" />
<p class="doc-note">
    Start with radius and control height, then the background/card relationship, elevation,
    primary, accent and border. <code>--accent</code> also colours ghost buttons, menu rows and
    selection surfaces. A palette cannot replace markup-specific behaviour such as a Material
    ripple or Fluent acrylic.
</p>

@code {
    static readonly string[] Tokens = [
        "primary", "secondary", "muted", "accent", "destructive",
        "card", "chart-1", "chart-2", "chart-3", "ring"
    ];

    static readonly string[] PreviewThemes = [
        "supabase", "notebook", "dracula", "nord", "cupertino", "claymorphism"
    ];

    static readonly IReadOnlyList<SnippetItem> Setup = [
        new("CSS", "@import \"./themes/mine.css\";"),
        new("HTML", "<html data-theme=\"mine\">"),
        new("Dark mode", "<html data-theme=\"mine\" class=\"dark\">")
    ];

    static readonly IReadOnlyList<CodeBlockFile> ThemeFiles = [
        new("mine.css", "css", """
            [data-theme="mine"] {
              --background: oklch(98% 0 0);
              --foreground: oklch(15% 0 0);
              --primary: oklch(55% 0.2 265);
              --primary-foreground: oklch(100% 0 0);
              --accent: oklch(95% 0.01 265);
              --border: oklch(90% 0 0);
              --radius: 0.75rem;
              --radius-control: 0.5rem;
              --control-h: 2.5rem;
            }
            """),
        new("mine.dark.css", "css", """
            [data-theme="mine"].dark {
              --background: oklch(18% 0.02 265);
              --foreground: oklch(97% 0 0);
              --primary: oklch(75% 0.14 265);
              --primary-foreground: oklch(18% 0.02 265);
              --accent: oklch(30% 0.04 265);
              --border: oklch(35% 0.02 265);
            }
            """)
    ];
}
