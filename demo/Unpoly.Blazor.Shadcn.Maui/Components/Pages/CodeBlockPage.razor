@page "/components/code-block"

<PageTitle>Code Block — Unpoly.Blazor.Shadcn</PageTitle>

<h1 class="doc-h1">Code Block</h1>
<p class="doc-lede">
    Kibo-style CodeBlock, highlighted with <a href="https://shiki.style" class="underline">Shiki</a> and its notation transformers.
</p>
<p class="doc-note">
    Server renders escaped code immediately. The WebView platform compiler lazy-loads local Shiki and applies Kibo's light/dark themes and notation transformers.
</p>

<Example Source="CodeBlockExample.razor">
    <CodeBlockExample />
</Example>

<h2 class="doc-h2">Languages</h2>
<p class="doc-note">Shiki grammars are bundled locally; highlighting works offline.</p>

<CodeBlock Language="csharp" Title="csharp" Code="@csharpSample" />
<CodeBlock Language="razor" Title="cshtml / razor" Code="@razorSample" Class="mt-4" />
<CodeBlock Language="javascript" Title="javascript" Code="@jsSample" Class="mt-4" />
<CodeBlock Language="bash" Title="bash" Code="@bashSample" Class="mt-4" />

<h2 class="doc-h2">Line numbers</h2>
<CodeBlock Language="csharp" Title="With ShowLineNumbers" ShowLineNumbers Code="@csharpSample" />

<h2 class="doc-h2">Long block (scrollable)</h2>
<CodeBlock Language="yaml" Title="yaml — scroll" Code="@yamlSample" />

<h2 class="doc-h2">Multiple files (Kibo)</h2>
<p class="doc-note">Select a filename to switch code. Copy uses the selected file.</p>
<CodeBlock Files="@files" DefaultFile="package.json" />

<h2 class="doc-h2">Inline annotations</h2>
<p class="doc-note">Diff, line highlight, focus and word highlight rendered in the WebView.</p>
<CodeBlock Files="@annotatedFiles" />

<h2 class="doc-h2">Without syntax colouring</h2>
<CodeBlock Files="@files" SyntaxHighlighting="false" ShowFileLineNumbers="false" />

@code {
    readonly IReadOnlyList<CodeBlockFile> files = [
        new("Program.cs", "csharp", "Console.WriteLine(\"Hello, world!\");"),
        new("package.json", "json", "{\"name\":\"demo\"}")
    ];

    readonly IReadOnlyList<CodeBlockFile> annotatedFiles = [
        new("changes.js", "javascript", "const total = 1; // [!code --]\nconst total = 2; // [!code ++]\nconsole.log(total); // [!code highlight]\nreturn total; // [!code focus]\nconst label = 'total'; // [!code word:total]")
    ];

    const string csharpSample = """
        // Shiki is loaded only when a code block is rendered
        up.compiler(''[data-slot="code-block"]'', root => {
            var code = root.querySelector(''[data-slot="code-block-code"]'');
            // ui.js invokes Shiki's codeToHtml and mounts its highlighted lines.
        });

        public sealed class CodeBlock : UiComponentBase
        {
            [Parameter, EditorRequired] public string Code { get; set; } = "";
            [Parameter] public string? Language { get; set; }
        }
        """;

    const string razorSample = """
        @* Code is a string, not ChildContent — Razor would parse <Button> as a component *@
        <CodeBlock Title="Program.cs" Language="csharp" Code="@Sample" />

        @code {
            const string Sample = "builder.Services.AddUnpoly(o => o.MainTargets = [\".content\"]);";
        }
        """;

    const string jsSample = """
        // ECharts — static SSR, Unpoly-safe
        up.compiler(''[data-echarts]'', el => {
          if (typeof echarts === ''undefined'') return;
          const chart = echarts.init(el);
          chart.setOption(JSON.parse(el.dataset.options));
          return () => chart.dispose();
        });
        """;

    const string bashSample = """
        dotnet add package Unpoly.Blazor.Shadcn
        dotnet add package Unpoly.Blazor.Shadcn.ECharts
        """;

    const string yamlSample = """
        languages:
          - csharp: 6.2kb
          - cshtml: 2.6kb
          - javascript: 4.6kb
          - typescript: 1.3kb
          - css: 1.2kb
          - json: 0.4kb
          - bash: 6.1kb
          - yaml: 1.9kb
          - sql: 3.2kb
        plugins:
          - autoloader
          - line-numbers
          - normalize-whitespace
        """;
}
