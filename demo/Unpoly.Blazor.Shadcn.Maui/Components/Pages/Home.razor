@page "/"

@* This page is the standing check for the MutationObserver bridge in wwwroot/index.html.
   Click "Re-render" first: that replaces DOM through Blazor's renderer, which Unpoly cannot
   see. If the dialog, the dropdown and the select still work afterwards, the bridge is doing
   its job. Without it they are dead on the very first render and nothing says so. *@

<PageTitle>Home</PageTitle>

<h1 class="text-2xl font-semibold tracking-tight">shadcn in a WebView</h1>
<p class="mt-2 max-w-prose text-muted-foreground">
    No server, no HTTP. Blazor renders interactively; the shadcn components below get their
    behaviour from <code>ui.js</code>, whose compilers only run because of the bridge.
</p>

<Card Class="mt-6 max-w-lg">
    <CardHeader>
        <CardTitle>Bridge check</CardTitle>
        <CardDescription>Re-render, then try each control.</CardDescription>
    </CardHeader>

    <CardContent Class="flex flex-wrap items-center gap-3">
        <Button Type="button" @onclick="() => renders++">Re-render (@renders)</Button>

        <DialogTrigger Target="demo-dialog" Variant="outline">Dialog</DialogTrigger>

        <DropdownMenuTrigger Target="demo-menu">
            Menu <Icon Name="chevron-down" Class="size-4" />
        </DropdownMenuTrigger>

        <Button Variant="secondary" Type="button" @onclick="Toast">Toast</Button>
    </CardContent>

    <CardFooter Class="flex flex-col items-stretch gap-2">
        <Label for="fruit">A real &lt;select&gt;, with a shadcn panel drawn beside it</Label>
        <Select id="fruit" name="fruit">
            <SelectItem Value="apple">Apple</SelectItem>
            <SelectItem Value="banana">Banana</SelectItem>
            <SelectItem Value="cherry">Cherry</SelectItem>
        </Select>
    </CardFooter>
</Card>

<DropdownMenuContent Id="demo-menu">
    <DropdownMenuItem>Profile</DropdownMenuItem>
    <DropdownMenuItem>Settings</DropdownMenuItem>
    <DropdownMenuSeparator />
    <DropdownMenuItem Variant="destructive">Sign out</DropdownMenuItem>
</DropdownMenuContent>

<Dialog Id="demo-dialog">
    <DialogHeader>
        <DialogTitle>Native &lt;dialog&gt;</DialogTitle>
        <DialogDescription>
            <code>showModal()</code> supplies the focus trap, the inert background and Escape.
            Re-rendered @renders time(s) and still alive.
        </DialogDescription>
    </DialogHeader>
</Dialog>

@code {
    int renders;

    // ui.js puts `toast` on window on purpose: that is sonner's API, so the call site reads
    // the same as it does in React.
    [Inject] public IJSRuntime JS { get; set; } = default!;
    Task Toast() => JS.InvokeVoidAsync("toast", "Toastify, through sonner's call shape").AsTask();
}
