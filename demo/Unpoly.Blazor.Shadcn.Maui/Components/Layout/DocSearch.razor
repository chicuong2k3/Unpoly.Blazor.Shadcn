@* Search, as a command palette. ⌘K on a Mac and Ctrl+K everywhere else — ui.js knows the
   difference, which is the part most implementations get wrong in one direction or the other.

   Every entry is a real link to a real page, so the palette is a list of links with scripting off
   and a filter with it. The filtering is in the browser because this list is forty items the
   server already rendered; a catalogue of ten thousand would put `up-autosubmit` on the input and
   let the server answer instead, swapping <CommandList>. Both shapes are the same markup. *@

<Button Variant="outline" Size="sm" Type="button" data-command-open="doc-search"
        Class="w-56 justify-between text-muted-foreground">
    <span class="flex items-center gap-2"><Icon Name="search" />Search…</span>
    <KbdGroup><Kbd>⌘</Kbd><Kbd>K</Kbd></KbdGroup>
</Button>

<CommandDialog Id="doc-search" Key="mod+k" Title="Search the documentation"
               Description="Jump to a component, a block or a page.">
    <CommandInput Placeholder="Search components, blocks, pages…" />
    <CommandList>
        <CommandEmpty Class="py-8 text-center text-sm text-muted-foreground">
            Nothing matches that.
        </CommandEmpty>

        @foreach (var (heading, entries) in Groups)
        {
            <CommandGroup Heading="@heading">
                @foreach (var (label, href, keywords) in entries)
                {
                    <CommandItem Href="@href" Keywords="@keywords">
                        <span>@label</span>
                    </CommandItem>
                }
            </CommandGroup>
        }
    </CommandList>
</CommandDialog>

@code {
    // Keywords are what someone types when they do not know what the thing is called: "modal"
    // for Dialog, "rtl" for Direction, "sonner" for Toast. Matching only the visible label is why
    // most site searches feel broken.
