@inherits LayoutComponentBase

@* The whole chrome is the library: Item and ScrollArea for the nav, Command for the search,
   Sheet for the Customizer, Tabs and CodeBlock for every example, Button, Badge, Kbd and
   Separator for the header.

   That is the point rather than a flourish. A component library whose own documentation is built
   from hand-rolled markup has not shown that its components are enough to build anything — it has
   shown the opposite, and hand-rolled chrome is exactly where the gaps hide.

   The web head wraps the chrome in <UpChrome> so fragment requests skip re-rendering it. The MAUI
   head has no fragments and no server — Blazor renders the whole page once per route, so the
   chrome is plain markup. Unpoly here is for `up.compiler` only (see index.html). *@

@inject IJSRuntime JS

<header class="doc-header sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-[1400px] items-center gap-4 px-6">
        <a href="/" class="font-semibold tracking-tight">
            Unpoly.Blazor.Shadcn
        </a>
        <Badge Variant="secondary" Class="hidden sm:inline-flex">shadcn/ui for Blazor</Badge>

        <div class="ml-auto flex items-center gap-2">
            <DocSearch />

            <Separator Orientation="vertical" Class="mx-1 h-6" />

            <Select data-theme-picker aria-label="Theme" Class="hidden w-[180px] md:flex">
                <SelectItem Value="shadcn">shadcn</SelectItem>
                <SelectItem Value="apple">Apple</SelectItem>
                <SelectItem Value="dracula">Dracula</SelectItem>
            </Select>

            <DocCustomizer />

            <Button Variant="ghost" Size="icon" Type="button" data-dark-toggle
                    aria-label="Toggle dark mode">
                <Icon Name="eye" />
            </Button>

            <Button Variant="outline" Size="icon"
                    Href="https://github.com/chicuong2k3/Unpoly.Blazor.Shadcn"
                    aria-label="Source on GitHub">
                <Icon Name="external-link" />
            </Button>
        </div>
    </div>
</header>

<div class="mx-auto flex max-w-[1400px] flex-col gap-8 px-6 lg:flex-row">
    @* Sticky under the header, which is 4rem tall and sticky itself. Same reason as the web
       head: without this the nav scrolls away and a reader three screens in has no way back. *@
        <div class="doc-nav top-16 block w-full lg:sticky lg:h-[calc(100dvh-4rem)] lg:w-auto">
        <DocNav />
    </div>

    <main class="doc-main min-w-0 flex-1 py-8">@Body</main>
</div>
