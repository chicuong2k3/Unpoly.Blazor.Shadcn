@* CTA — one headline, one action, full-width band. The band is a Card so it inherits the
   surface tokens; the button is a real link to where the action goes. *@

<section class="mx-auto max-w-6xl py-16">
    <Card Class="overflow-hidden">
        <CardContent Class="flex flex-col items-center gap-6 px-6 py-16 text-center sm:px-16">
            <h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
                Start building with static SSR today
            </h2>
            <p class="max-w-xl text-muted-foreground">
                Copy a block, wire your endpoints, and ship. The components are MIT licensed and
                the demo is your documentation.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <Button Size="lg" Href="/blocks">Browse the blocks</Button>
                <Button Size="lg" Variant="outline" Href="/theming">Read about theming</Button>
            </div>
        </CardContent>
    </Card>
</section>
