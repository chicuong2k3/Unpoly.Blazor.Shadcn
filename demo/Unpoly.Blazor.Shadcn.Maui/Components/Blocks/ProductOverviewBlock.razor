@* Product overview — the e-commerce detail page. Gallery on the left, summary and Buy on the
   right, tabs of description/specs/reviews below. Everything is a link or a real form. *@

<div class="mx-auto grid max-w-6xl gap-10 py-10 lg:grid-cols-2">
    <div class="space-y-4">
        <AspectRatio Ratio="1" Class="overflow-hidden rounded-lg border bg-muted">
            <img src="https://placehold.co/800x800" alt="The weekender, natural leather" class="size-full object-cover" width="800" height="800" />
        </AspectRatio>
        <div class="grid grid-cols-4 gap-2">
            @for (var i = 0; i < 4; i++)
            {
                <button type="button" class="aspect-square overflow-hidden rounded-md border bg-muted" aria-label="@($"Image {i + 1}")">
                    <img src="https://placehold.co/200x200" alt="" class="size-full object-cover" width="200" height="200" loading="lazy" />
                </button>
            }
        </div>
    </div>

    <div>
        <Breadcrumb Class="mb-4">
            <BreadcrumbList>
                <BreadcrumbItem><BreadcrumbLink Href="/">Shop</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem><BreadcrumbLink Href="/bags">Bags</BreadcrumbLink></BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem><BreadcrumbPage>The weekender</BreadcrumbPage></BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>
        <h1 class="text-3xl font-semibold tracking-tight">The weekender</h1>
        <p class="mt-2 num text-2xl font-semibold">$189</p>
        <p class="mt-4 text-muted-foreground">
            Vegetable-tanned leather, brass hardware, cotton-canvas lining. Two internal pockets, one
            external. 38 × 24 × 18 cm. Comes with a five-year repair guarantee.
        </p>

        <form method="post" up-target=".cart-badge" up-disable class="mt-8 space-y-4">
            <AntiforgeryToken />
            <div class="flex flex-wrap items-center gap-2">
                <Select name="colour" aria-label="Colour" Class="w-[200px]">
                    <SelectItem Value="natural" Selected>Natural</SelectItem>
                    <SelectItem Value="black">Black</SelectItem>
                    <SelectItem Value="tan">Tan</SelectItem>
                </Select>
                <Select name="size" aria-label="Size" Class="w-[120px]">
                    <SelectItem Value="s" Selected>Small</SelectItem>
                    <SelectItem Value="m">Medium</SelectItem>
                    <SelectItem Value="l">Large</SelectItem>
                </Select>
            </div>
            <div class="flex flex-wrap gap-3">
                <Button Size="lg" Type="submit">Add to cart</Button>
                <Button Size="lg" Variant="outline" Type="button">Save for later</Button>
            </div>
        </form>

        <Separator Class="my-8" />

        <Tabs Value="description">
            <TabsList>
                <TabsTrigger Value="description">Description</TabsTrigger>
                <TabsTrigger Value="specs">Specs</TabsTrigger>
                <TabsTrigger Value="shipping">Shipping</TabsTrigger>
            </TabsList>
            <TabsContent Value="description">
                <p class="pt-4 text-sm text-muted-foreground">
                    Designed in Hanoi, made in a 6-person workshop outside Milan. The leather is
                    sourced from a single Italian tannery and ages with the bag. The handle
                    stitch is double-pass linen, the lining is cotton canvas.
                </p>
            </TabsContent>
            <TabsContent Value="specs">
                <ul class="mt-4 space-y-1.5 text-sm">
                    <li><span class="font-medium">Material</span> · Vegetable-tanned leather</li>
                    <li><span class="font-medium">Dimensions</span> · 38 × 24 × 18 cm</li>
                    <li><span class="font-medium">Weight</span> · 1.4 kg</li>
                    <li><span class="font-medium">Hardware</span> · Solid brass</li>
                </ul>
            </TabsContent>
            <TabsContent Value="shipping">
                <p class="pt-4 text-sm text-muted-foreground">Free shipping over $80, two to four working days within Asia.</p>
            </TabsContent>
        </Tabs>
    </div>
</div>
