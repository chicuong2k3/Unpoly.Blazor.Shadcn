<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Windows only, because `dotnet build` for net10.0-android fails on this machine
             with NETSDK1147: the wasm-tools workload is missing. That is not this project —
             a pristine `dotnet new maui-blazor` fails identically. Run `dotnet workload
             restore`, then put the other three back:
               <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
               <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks> -->
        <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Unpoly.Blazor.Shadcn.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Unpoly.Blazor.Shadcn.Maui</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.unpolyblazor.shadcnmaui</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <!-- Only the component layer is used here — Unpoly.Blazor itself is deliberately
             absent, see wwwroot/index.html. -->
        <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn/Unpoly.Blazor.Shadcn.csproj" />
        <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.ECharts/Unpoly.Blazor.Shadcn.ECharts.csproj" />
        <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.Maps/Unpoly.Blazor.Shadcn.Maps.csproj" />
        <!-- Referenced ONLY for the static asset _content/Unpoly.Blazor/unpoly.min.js, which is
             where `up.compiler` comes from. Its C# half — AddUnpoly, UpChrome, UnpolyHead, the
             middleware — is unused and unusable here, and calling any of it is the mistake this
             comment exists to prevent. -->
        <PackageReference Include="Unpoly.Blazor" Version="0.1.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>


    <!-- Evaluated before any target runs, which is the only moment that can still tell
         whether the glob below saw wwwroot/app.css. Asking Exists() inside the Tailwind
         target is too late: the CLI has just written the file, so the answer is always
         yes and a fresh clone ships with no CSS. -->
    <PropertyGroup>
        <_AppCssWasMissing Condition="!Exists('wwwroot/app.css')">true</_AppCssWasMissing>
    </PropertyGroup>

    <!-- Build the v3 stylesheet for the demo by default; keep v4 for rollback. -->
    <PropertyGroup>
        <Tailwind3Preview Condition="'$(Tailwind3Preview)' == ''">true</Tailwind3Preview>
    </PropertyGroup>
    <Target Name="RequireTailwind3DemoCss" BeforeTargets="PrepareForBuild" Condition="'$(Tailwind3Preview)' != 'true'">
        <Error Text="The demo host links app.v3.css by default; Tailwind3Preview=false would create a broken build. Use ?demo-css=v4 for runtime comparison." />
    </Target>
    <Target Name="RemoveTailwind3Preview" BeforeTargets="PrepareForBuild"
            Condition="'$(Tailwind3Preview)' != 'true'">
        <Delete Files="wwwroot/app.v3.css;$(OutDir)wwwroot/app.v3.css;wwwroot/container-fallback.v3.js;$(OutDir)wwwroot/container-fallback.v3.js" />
    </Target>
    <ItemGroup Condition="'$(Tailwind3Preview)' != 'true'">
        <Content Remove="wwwroot/app.v3.css;wwwroot/container-fallback.v3.js" />
    </ItemGroup>
    <PropertyGroup>
        <_PreviewCssWasMissing Condition="!Exists('wwwroot/app.v3.css') Or !Exists('wwwroot/container-fallback.v3.js')">true</_PreviewCssWasMissing>
    </PropertyGroup>
    <Target Name="Tailwind3PreviewBuild" BeforeTargets="PrepareForBuild"
            DependsOnTargets="NpmInstall" Condition="'$(Tailwind3Preview)' == 'true'">
        <Exec Command="node ../../tools/build-tailwind3-probe.cjs --preview maui" />
        <ItemGroup Condition="'$(_PreviewCssWasMissing)' == 'true'">
            <Content Include="wwwroot/app.v3.css" />
            <Content Include="wwwroot/container-fallback.v3.js" />
        </ItemGroup>
    </Target>

    <!-- Tailwind v4 through its npm CLI. `dotnet build` stays the only command you run. -->
    <Target Name="NpmInstall" BeforeTargets="Tailwind">
        <Exec Command="npm ci" Condition="!Exists('node_modules')" />
        <!-- The shared postprocessor resolves modules relative to tools/. -->
        <Exec Command="npm ci --prefix ../../tools" Condition="!Exists('../../tools/node_modules')" />
    </Target>

    <!-- Every example is rendered AND shown as source, from the same file. In the web head the
         .razor files are copied to `samples/` in the output and <Example> reads them. In MAUI the
         output path is not knowable before the build, so they are copied to `wwwroot/samples` — a
         reliably-bundled static path — and fetched by URL. Same files, same guarantee the two
         cannot drift. Excluded from Razor compilation: they are source, not components here. -->
    <!-- wwwroot/samples holds source .razor copies served to <Example>. The Razor SDK globs
         **/*.razor and would compile them as components (and fail — they are not standalone
         components, and 'Command'/'Calendar' resolve wrong in that context). Exclude them from
         every default item glob so they are served, not compiled. DefaultItemExcludes is a
         PROPERTY, so it must sit in a PropertyGroup. -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/samples/**</DefaultItemExcludes>
    </PropertyGroup>
    <Target Name="CopySamples" BeforeTargets="ResolveStaticWebAssetsInputs">
        <ItemGroup>
            <SampleFile Include="Components/Examples/**/*.razor;Components/Blocks/**/*.razor" />
        </ItemGroup>
        <Copy SourceFiles="@(SampleFile)"
              DestinationFolder="wwwroot/samples"
              SkipUnchangedFiles="true" />
        <!-- The copied .razor files are served as static assets, not compiled. -->
        <ItemGroup Condition="Exists('wwwroot/samples')">
            <Content Include="wwwroot/samples/**/*.razor" />
        </ItemGroup>
    </Target>

    <!-- Always rebuild: the previous incremental Inputs omitted the CLI/postprocessor config,
         imported themes and other transitive CSS. A stale MAUI v4 asset silently lacked behavior
         slots; minification also hoisted a ring fallback above its layered /50 rule.
         This Windows-only demo has one target framework, so a subsecond CLI run is safer. -->
    <Target Name="Tailwind" BeforeTargets="ResolveStaticWebAssetsInputs">
        <Exec Command="npm run css" />
        <!-- Only on a first build. Adding it unconditionally gives Windows two sources for
             one file and the PRI compiler refuses:
               PRI277: Conflicting values for resource 'Files/wwwroot/app.css'. -->
        <ItemGroup Condition="'$(_AppCssWasMissing)' == 'true'">
            <Content Include="wwwroot/app.css" />
        </ItemGroup>
        <!-- MSBuild evaluated the wwwroot glob before this target ran, so on a fresh clone the
             file it just generated is not a static web asset and the app ships with no CSS —
             correct on the second build, broken on the first. -->
        <!-- Remove-then-Include, not a Condition: MSBuild compares item identities as
             strings, and the SDK glob spells this one with a backslash. A guard written
             with a forward slash never matches, fires on every build, and the second item
             reaches PRI generation as a second source for one resource:
               PRI277: Conflicting values for resource 'Files/wwwroot/app.css'. -->
    </Target>

</Project>
