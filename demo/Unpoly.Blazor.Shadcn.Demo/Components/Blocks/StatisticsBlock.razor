@* A statistics band — a headline, a row of four large numbers, and a row of company logos.
   The numbers are the credibility; the logos are who said it. *@

<section class="mx-auto max-w-6xl py-16">
    <div class="text-center">
        <h2 class="text-3xl font-semibold tracking-tight text-balance">Trusted by teams that ship to production</h2>
        <p class="mt-4 text-muted-foreground">From solo developers to Fortune 100 product teams.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
            <div class="num text-4xl font-semibold tracking-tight">12,000+</div>
            <p class="mt-1 text-sm text-muted-foreground">GitHub stars</p>
        </div>
        <div class="text-center">
            <div class="num text-4xl font-semibold tracking-tight">4.8M</div>
            <p class="mt-1 text-sm text-muted-foreground">npm downloads / mo</p>
        </div>
        <div class="text-center">
            <div class="num text-4xl font-semibold tracking-tight">99.9%</div>
            <p class="mt-1 text-sm text-muted-foreground">Uptime</p>
        </div>
        <div class="text-center">
            <div class="num text-4xl font-semibold tracking-tight">300+</div>
            <p class="mt-1 text-sm text-muted-foreground">Contributors</p>
        </div>
    </div>

    <div class="mt-12 grid grid-cols-2 items-center gap-8 sm:grid-cols-3 lg:grid-cols-6">
        <span class="text-2xl font-bold tracking-tighter text-muted-foreground">Northwind</span>
        <span class="text-2xl font-serif italic text-muted-foreground">Meridian</span>
        <span class="text-2xl font-semibold tracking-tight text-muted-foreground">Vela</span>
        <span class="text-2xl font-light tracking-widest text-muted-foreground">ATLAS</span>
        <span class="text-2xl font-black text-muted-foreground">koda.</span>
        <span class="text-2xl text-muted-foreground">⌘ Lighthouse</span>
    </div>
</section>
