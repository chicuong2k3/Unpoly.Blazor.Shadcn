@* Numbers and nothing else, which is upstream's Simple: five pages, the current one outlined,
   no arrows. For a list short enough to show every page, an arrow is a control that says less
   than the number beside it. *@
<Pagination>
    <PaginationContent>
        @foreach (var n in Enumerable.Range(1, 5))
        {
            var href = "/components/pagination?page=" + n;
            <PaginationItem>
                <PaginationLink Href="@href" IsActive="@(n == 2)">@n</PaginationLink>
            </PaginationItem>
        }
    </PaginationContent>
</Pagination>
