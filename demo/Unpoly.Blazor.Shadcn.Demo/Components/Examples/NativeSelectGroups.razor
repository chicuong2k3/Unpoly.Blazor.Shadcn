<Field Class="w-[280px]">
    <FieldLabel For="ns-tz">Timezone</FieldLabel>
    <NativeSelect id="ns-tz" name="tz">
        <optgroup label="Europe">
            <option value="lisbon">Lisbon</option>
            <option value="berlin">Berlin</option>
        </optgroup>
        <optgroup label="Asia">
            <option value="hanoi" selected>Ha Noi</option>
            <option value="tokyo">Tokyo</option>
        </optgroup>
    </NativeSelect>
</Field>
