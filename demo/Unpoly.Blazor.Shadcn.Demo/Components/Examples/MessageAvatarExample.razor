@* The avatar is aria-hidden, because the author's name is in the header right beside it —
   announcing "MR, Marta Ruiz" on every message is announcing it twice. *@
<Message Class="w-[440px]">
    <MessageAvatar><Avatar><AvatarFallback>MR</AvatarFallback></Avatar></MessageAvatar>
    <MessageContent>
        <MessageHeader>
            <span class="font-medium">Marta Ruiz</span>
            <time class="num text-xs text-muted-foreground" datetime="2026-03-11T09:12">09:12</time>
        </MessageHeader>
        <Bubble Variant="muted"><BubbleContent>Did the invoice go out?</BubbleContent></Bubble>
    </MessageContent>
</Message>
