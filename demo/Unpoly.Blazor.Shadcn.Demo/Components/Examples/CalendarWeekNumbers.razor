@* ShowWeekNumber puts an ISO week number in front of each row, which a planning screen needs and
   a booking screen does not. It is a th scope="row", so a screen reader announces it as the
   heading of the row rather than as another day. *@
<Card Class="mx-auto w-fit p-0">
    <CardContent Class="p-0">
        <Calendar Name="week-day" Month="@Month" Selected="@(Month.AddDays(11))" Today="@Today"
                  ShowWeekNumber Class="p-3" />
    </CardContent>
</Card>

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly Month = new(Today.Year, Today.Month, 1);
}
