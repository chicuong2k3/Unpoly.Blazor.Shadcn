@* How many slides fit is basis-* on the item, so it is a class and it is responsive. Nothing
   measures anything. *@
<div class="relative w-full max-w-lg px-12">
    <Carousel AriaLabel="Three at a time">
        <CarouselContent>
            @foreach (var n in Enumerable.Range(1, 8))
            {
                <CarouselItem Class="basis-1/2 md:basis-1/3">
                    <Card Class="m-1"><CardContent Class="flex aspect-square items-center justify-center p-6">
                        <span class="num text-2xl font-semibold">@n</span>
                    </CardContent></Card>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious />
        <CarouselNext />
    </Carousel>
</div>
