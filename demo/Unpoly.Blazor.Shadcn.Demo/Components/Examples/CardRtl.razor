@* shadcn's own RTL card is the sign-in card in Arabic, not a different card — which is the point:
   the same markup, and every edge follows the writing direction. CardAction moves to the other
   end without being told, because it is placed in the last grid column and grid columns follow
   the direction. *@
<div dir="rtl" class="w-full max-w-sm">
    <Card>
        <CardHeader>
            <CardTitle>تسجيل الدخول إلى حسابك</CardTitle>
            <CardDescription>أدخل بريدك الإلكتروني أدناه لتسجيل الدخول إلى حسابك</CardDescription>
            <CardAction>
                <Button Variant="link">إنشاء حساب</Button>
            </CardAction>
        </CardHeader>
        <CardContent>
            <div class="flex flex-col gap-6">
                <div class="grid gap-2">
                    <Label For="card-rtl-email">البريد الإلكتروني</Label>
                    <Input id="card-rtl-email" name="email" type="email" placeholder="m&#64;example.com" />
                </div>
                <div class="grid gap-2">
                    <div class="flex items-center">
                        <Label For="card-rtl-password">كلمة المرور</Label>
                        <a href="/account" class="ms-auto inline-block text-sm underline-offset-4 hover:underline">
                            هل نسيت كلمة المرور؟
                        </a>
                    </div>
                    <Input id="card-rtl-password" name="password" type="password" />
                </div>
            </div>
        </CardContent>
        <CardFooter Class="flex-col gap-2">
            <Button Class="w-full">تسجيل الدخول</Button>
            <Button Variant="outline" Class="w-full">تسجيل الدخول عبر Google</Button>
        </CardFooter>
    </Card>
</div>
