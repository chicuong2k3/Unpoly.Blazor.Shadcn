@* aria-invalid on the input, not a class: the ring is styled from the attribute, so the same
   markup a server-side validator sets is the markup that turns it red. *@
<div class="w-64">
    <Field>
        <FieldLabel For="cb-invalid">Framework</FieldLabel>
        <Combobox Target="cb-invalid-list">
            <input type="hidden" name="framework" value="" data-combobox-value />
            <ComboboxInput Id="cb-invalid" Target="cb-invalid-list"
                           Placeholder="Select a framework" Invalid />
            <ComboboxContent Id="cb-invalid-list">
                <ComboboxEmpty>No items found.</ComboboxEmpty>
                <ComboboxList>
                    <ComboboxItem Value="nextjs">Next.js</ComboboxItem>
                    <ComboboxItem Value="sveltekit">SvelteKit</ComboboxItem>
                </ComboboxList>
            </ComboboxContent>
        </Combobox>
        <FieldError>Pick a framework.</FieldError>
    </Field>
</div>
