@* The same chart the other sections show, under dir="rtl" — not a smaller one. The bars run from
   the reading edge because the row is a flex container, the labels follow them, and the tooltip
   flips to the other side of the cursor near the window edge. Nothing about the chart is told
   which way it is going. *@
<div dir="rtl">
    <Chart Id="rtl" Series="@Palette" Class="h-[240px] w-full max-w-lg">
        <div class="flex w-full flex-col">
            <table class="h-full w-full">
                <caption class="sr-only">الزوار من سطح المكتب والجوال حسب الشهر</caption>
                <thead class="sr-only">
                    <tr><th scope="col">الشهر</th><th scope="col">سطح المكتب</th><th scope="col">الجوال</th></tr>
                </thead>
                <tbody class="flex h-full items-stretch gap-3 pb-5">
                    @foreach (var (month, desktop, mobile) in Months)
                    {
                        <tr class="flex flex-1 flex-col justify-end">
                            <td class="flex flex-1 items-end gap-1" data-chart-point
                                data-chart-label="@month"
                                data-chart-series="desktop,mobile"
                                data-chart-name="سطح المكتب,الجوال"
                                data-chart-value="@desktop,@mobile">
                                <span class="flex-1 rounded-t-[4px]"
                                      style="@($"height: {desktop * 100 / 320}%; background: var(--color-desktop)")"></span>
                                <span class="flex-1 rounded-t-[4px]"
                                      style="@($"height: {mobile * 100 / 320}%; background: var(--color-mobile)")"></span>
                            </td>
                            <th scope="row" class="pt-2.5 text-center text-xs font-normal text-muted-foreground">
                                @month
                            </th>
                        </tr>
                    }
                </tbody>
            </table>

            <ChartLegend Series="@Names" />
        </div>

        <ChartTooltip />
    </Chart>
</div>

@code {
    static readonly Dictionary<string, string> Palette = new()
    {
        ["desktop"] = "var(--chart-1)",
        ["mobile"] = "var(--chart-2)",
    };

    static readonly Dictionary<string, string> Names = new()
    {
        ["desktop"] = "سطح المكتب",
        ["mobile"] = "الجوال",
    };

    static readonly (string Month, int Desktop, int Mobile)[] Months =
    [
        ("ينا", 186, 80), ("فبر", 305, 200), ("مار", 237, 120),
        ("أبر", 73, 190), ("ماي", 209, 130), ("يون", 214, 140),
    ];
}
