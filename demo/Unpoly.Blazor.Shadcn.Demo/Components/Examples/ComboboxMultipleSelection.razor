@* Multiple without chips: the trigger keeps a summary and the list shows a tick per choice. The
   hidden inputs are still one per value, so the server reads a list either way. *@
<div class="w-72">
    <Combobox Target="cb-ms-list" Multiple>
        <input type="hidden" name="sizes" value="m" data-combobox-value />
        <input type="hidden" name="sizes" value="l" data-combobox-value />
        <ComboboxTrigger id="cb-ms" Target="cb-ms-list">
            <ComboboxValue data-placeholder="Any size">2 selected</ComboboxValue>
        </ComboboxTrigger>

        <ComboboxContent Id="cb-ms-list" Class="w-72">
            <ComboboxList>
                <ComboboxEmpty>No such size.</ComboboxEmpty>
                <ComboboxItem Value="s">Small<ComboboxItemIndicator /></ComboboxItem>
                <ComboboxItem Value="m" Selected>Medium<ComboboxItemIndicator /></ComboboxItem>
                <ComboboxItem Value="l" Selected>Large<ComboboxItemIndicator /></ComboboxItem>
                <ComboboxItem Value="xl">Extra large<ComboboxItemIndicator /></ComboboxItem>
            </ComboboxList>
        </ComboboxContent>
    </Combobox>
</div>
