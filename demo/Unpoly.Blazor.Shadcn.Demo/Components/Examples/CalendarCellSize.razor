@* One custom property sizes every day box, as upstream's --cell-size does — and the week-number
   column and the month nav follow it, because they are laid out against the same value. Bigger
   is worth it on a touch screen: 44px is the smallest target most guidance accepts, and a month
   is a grid of thirty-one of them. *@
<Calendar Name="cell-b" Month="@Month" Selected="@(Month.AddDays(11))" Today="@Today"
          Class="mx-auto w-fit rounded-lg border p-3 [--cell-size:--spacing(11)] [&amp;_.num]:text-base" />

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly Month = new(Today.Year, Today.Month, 1);
}
