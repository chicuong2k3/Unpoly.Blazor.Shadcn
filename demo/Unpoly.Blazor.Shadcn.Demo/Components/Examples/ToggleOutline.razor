@* The outline variant carries a border and a shadow, so it reads as a control when it is off
   rather than only when it is on. *@
<div class="flex flex-wrap items-center gap-2">
    <Toggle Variant="outline" Name="italic" aria-label="Toggle italic">
        <Icon Name="italic" />Italic
    </Toggle>
    <Toggle Variant="outline" Name="bold" aria-label="Toggle bold">
        <Icon Name="bold" />Bold
    </Toggle>
</div>
