@* The turn marked ScrollAnchor settles at the TOP of the viewport with a peek of the exchange
   above it, instead of the thread snapping to its own bottom. That is the difference between
   this component and a box with overflow: auto — when a long answer arrives you are left looking
   at the question that caused it, not at the end of the answer. *@
<MessageScroller OpenAt="anchor" ScrollMargin="16"
                 Class="relative h-80 w-full max-w-xl rounded-lg border">
    <MessageScrollerViewport Class="h-full p-4">
        <MessageScrollerContent>
            @foreach (var (id, mine, text) in Turns)
            {
                <MessageScrollerItem MessageId="@id" ScrollAnchor="@mine">
                    <Message Align="@(mine ? "end" : "start")">
                        <MessageContent>
                            <Bubble Variant="@(mine ? "default" : "muted")">
                                <BubbleContent>@text</BubbleContent>
                            </Bubble>
                        </MessageContent>
                    </Message>
                </MessageScrollerItem>
            }
        </MessageScrollerContent>
    </MessageScrollerViewport>
    <MessageScrollerButton />
</MessageScroller>

@code {
    static readonly (string Id, bool Mine, string Text)[] Turns =
    [
        ("q1", true, "What broke the build?"),
        ("a1", false, "The lock file was missing, so install had nothing to resolve against."),
        ("q2", true, "Why would it go missing?"),
        ("a2", false, "It is in .gitignore. That is fine for a library and wrong for an application: an application wants the exact tree it was tested with, and a library wants whatever its consumer resolves. The fix is one line, and the reason it went unnoticed for so long is that a fresh install happened to resolve the same versions every time until last week."),
    ];
}
