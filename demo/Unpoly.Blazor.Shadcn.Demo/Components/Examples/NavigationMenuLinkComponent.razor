@* shadcn writes asChild here so the link can be a router Link. There is no router: it is an
   <a href>, wearing the trigger recipe so a bar of plain links matches a bar of triggers, and
   [up-nav] is what marks the current one — Unpoly compares each href with the address bar, which
   keeps working after a fragment swap because the swap is what changed the address bar. *@
<NavigationMenu AriaLabel="Docs" up-nav>
    <NavigationMenuList>
        <NavigationMenuItem>
            <NavigationMenuLink Href="/" Class="@NavigationMenuTriggerStyle.Value"
                                up-target=".doc-main" up-preload>Overview</NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
            <NavigationMenuLink Href="/theming" Class="@NavigationMenuTriggerStyle.Value"
                                up-target=".doc-main">Theming</NavigationMenuLink>
        </NavigationMenuItem>
        <NavigationMenuItem>
            <NavigationMenuLink Href="/blocks" Class="@NavigationMenuTriggerStyle.Value"
                                up-target=".doc-main">Blocks</NavigationMenuLink>
        </NavigationMenuItem>
    </NavigationMenuList>
</NavigationMenu>
