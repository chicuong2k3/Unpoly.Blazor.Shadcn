@* The same bookmark toggle in Arabic. Nothing here names a side: the gap between the icon and
   the word is a flex gap, so the icon leads in both directions. *@
<div dir="rtl">
    <Toggle Size="sm" Variant="outline" Name="bookmark-rtl" aria-label="إشارة مرجعية">
        <Icon Name="bookmark" Class="group-has-[:checked]/toggle:fill-foreground" />
        إشارة مرجعية
    </Toggle>
</div>
