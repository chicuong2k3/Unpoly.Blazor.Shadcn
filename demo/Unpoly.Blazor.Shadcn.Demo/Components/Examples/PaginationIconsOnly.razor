@* Arrows without words, for a toolbar with no room. They still need names: an arrow announced as
   "button" is a button nobody can identify in a list of them. *@
<Pagination>
    <PaginationContent>
        <PaginationItem>
            <PaginationLink Href="/components/pagination?page=1" Size="icon" aria-label="First page">
                <Icon Name="chevrons-left" />
            </PaginationLink>
        </PaginationItem>
        <PaginationItem>
            <PaginationLink Href="/components/pagination?page=2" Size="icon" aria-label="Previous page">
                <Icon Name="chevron-left" />
            </PaginationLink>
        </PaginationItem>
        <PaginationItem>
            <PaginationLink Href="/components/pagination?page=4" Size="icon" aria-label="Next page">
                <Icon Name="chevron-right" />
            </PaginationLink>
        </PaginationItem>
        <PaginationItem>
            <PaginationLink Href="/components/pagination?page=9" Size="icon" aria-label="Last page">
                <Icon Name="chevrons-right" />
            </PaginationLink>
        </PaginationItem>
    </PaginationContent>
</Pagination>
