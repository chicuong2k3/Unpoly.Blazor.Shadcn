@* Upstream's Icons Only is a table footer: rows-per-page on one side, the two arrows on the
   other. mx-0 w-auto is what stops the nav centring itself — here it is one half of a row rather
   than the whole width. *@
<div class="flex items-center justify-between gap-4">
    <Field Orientation="horizontal" Class="w-fit">
        <FieldLabel For="pagination-rows">Rows per page</FieldLabel>
        <Select id="pagination-rows" name="rows" Class="w-20">
            @foreach (var size in new[] { 10, 25, 50, 100 })
            {
                <SelectItem Value="@size.ToString()" Selected="@(size == 25)">@size</SelectItem>
            }
        </Select>
    </Field>

    <Pagination Class="mx-0 w-auto">
        <PaginationContent>
            <PaginationItem><PaginationPrevious Href="/components/pagination?page=1" /></PaginationItem>
            <PaginationItem><PaginationNext Href="/components/pagination?page=3" /></PaginationItem>
        </PaginationContent>
    </Pagination>
</div>
