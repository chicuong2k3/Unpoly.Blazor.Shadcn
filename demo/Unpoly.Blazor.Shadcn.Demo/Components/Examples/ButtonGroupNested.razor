@* Groups inside a group, for a toolbar with related sets. The outer group spaces them; each
   inner one joins its own. *@
<ButtonGroup Class="gap-2">
    <ButtonGroup>
        <Button Variant="outline" Size="icon" aria-label="Bold"><span class="font-bold">B</span></Button>
        <Button Variant="outline" Size="icon" aria-label="Italic"><span class="italic">I</span></Button>
    </ButtonGroup>
    <ButtonGroup>
        <Button Variant="outline" Size="icon" aria-label="Align start"><Icon Name="menu" /></Button>
        <Button Variant="outline" Size="icon" aria-label="Align centre"><Icon Name="minus" /></Button>
    </ButtonGroup>
</ButtonGroup>
