<Field>
    <FieldLabel For="folder-picker-web">Backup folder</FieldLabel>
    <FolderPicker Id="folder-picker-web" Value="C:\Backups"
                  Disabled="true" BrowseLabel="Browse" AriaLabel="Selected backup folder" />
    <FieldDescription>
        Browsers cannot reveal an absolute local folder path. Native and hybrid hosts provide
        <code>PickAsync</code>; web hosts should keep the picker disabled or supply a server flow.
    </FieldDescription>
    <div class="flex justify-end">
        <Button Type="button" Disabled="true"><Icon Name="upload" />Run manual backup</Button>
    </div>
</Field>
