@* The legend reads the same --color-* the bars do, which is the whole point of declaring them on
   the container: one place decides the colour, and the drawing and the labelling cannot disagree. *@
<Chart Id="legend" Series="@Palette" Class="w-full max-w-lg">
    <div class="flex h-48 items-stretch gap-3">
        @foreach (var (label, revenue, refunds) in Weeks)
        {
            <div class="flex flex-1 flex-col justify-end gap-1">
                <div class="flex flex-1 items-end gap-1">
                    <div class="flex-1 rounded-sm" style="@($"height: {revenue}%; background: var(--color-revenue)")"></div>
                    <div class="flex-1 rounded-sm" style="@($"height: {refunds}%; background: var(--color-refunds)")"></div>
                </div>
                <div class="text-center text-[10px] text-muted-foreground">@label</div>
            </div>
        }
    </div>

    <ul class="mt-3 flex flex-wrap items-center gap-4 text-xs">
        @foreach (var (key, label) in Legend)
        {
            <li class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-[2px]" style="@($"background: var(--color-{key})")"></span>
                @label
            </li>
        }
    </ul>
</Chart>

@code {
    static readonly Dictionary<string, string> Palette = new()
    {
        ["revenue"] = "var(--chart-1)",
        ["refunds"] = "var(--chart-2)",
    };

    static readonly (string Key, string Label)[] Legend = [("revenue", "Revenue"), ("refunds", "Refunds")];

    static readonly (string Label, int Revenue, int Refunds)[] Weeks =
    [
        ("W1", 60, 18), ("W2", 72, 22), ("W3", 65, 12), ("W4", 88, 30), ("W5", 80, 16),
    ];
}
