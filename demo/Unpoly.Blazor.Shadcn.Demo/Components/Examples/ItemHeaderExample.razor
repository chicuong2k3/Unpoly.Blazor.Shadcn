@* A header and a footer around the row, for a card that is a row rather than a panel. *@
<Item Variant="outline" Class="w-[420px] flex-col items-stretch gap-3">
    <ItemHeader>
        <ItemTitle>Order #3201</ItemTitle>
        <Badge Variant="secondary">Paid</Badge>
    </ItemHeader>
    <ItemContent>
        <ItemDescription>Two items, shipped on 12 March.</ItemDescription>
    </ItemContent>
    <ItemFooter>
        <span class="num text-sm font-medium">$248.00</span>
        <Button Variant="ghost" Size="sm" Href="/components/table">Details</Button>
    </ItemFooter>
</Item>
