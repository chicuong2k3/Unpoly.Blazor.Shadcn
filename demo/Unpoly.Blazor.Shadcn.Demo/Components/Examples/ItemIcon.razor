@* An icon in the media slot. It is decorative when the title says the same thing, which here it
   does — so it stays out of the accessible name. *@
<div class="flex w-[420px] flex-col gap-2">
    <Item Variant="outline">
        <ItemMedia><Icon Name="folder" Class="size-5 text-muted-foreground" /></ItemMedia>
        <ItemContent><ItemTitle>Contracts</ItemTitle>
            <ItemDescription>12 files</ItemDescription></ItemContent>
    </Item>
    <Item Variant="outline">
        <ItemMedia><Icon Name="file" Class="size-5 text-muted-foreground" /></ItemMedia>
        <ItemContent><ItemTitle>rate-card.xlsx</ItemTitle>
            <ItemDescription>212 KB</ItemDescription></ItemContent>
    </Item>
</div>
