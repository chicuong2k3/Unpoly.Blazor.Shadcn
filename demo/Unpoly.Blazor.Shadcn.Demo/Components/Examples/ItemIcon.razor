@* The icon media variant: a bordered, muted tile with the icon sized to fit it. The icon is
   decorative when the title says the same thing, which here it does, so it stays out of the
   accessible name. *@
<Item Variant="outline" Class="w-full max-w-md">
    <ItemMedia Variant="icon"><Icon Name="triangle-alert" /></ItemMedia>
    <ItemContent>
        <ItemTitle>Security Alert</ItemTitle>
        <ItemDescription>New login detected from an unknown device.</ItemDescription>
    </ItemContent>
    <ItemActions>
        <Button Variant="outline" Size="sm">Review</Button>
    </ItemActions>
</Item>
