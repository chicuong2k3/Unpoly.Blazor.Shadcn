@* Both variants, both unavailable. The label dims with the input because the recipe reads the
   input's own :disabled, not because the two were set separately and have to agree. *@
<div class="flex flex-wrap items-center gap-2">
    <Toggle Disabled aria-label="Toggle disabled">Disabled</Toggle>
    <Toggle Variant="outline" Disabled aria-label="Toggle disabled outline">Disabled</Toggle>
</div>
