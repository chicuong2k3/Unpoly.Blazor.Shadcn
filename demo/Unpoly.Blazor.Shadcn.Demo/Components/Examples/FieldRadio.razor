<FieldSet Class="w-[380px]">
    <FieldLegend Variant="label">Shipping</FieldLegend>
    <RadioGroup>
        <Field Orientation="horizontal">
            <RadioGroupItem id="fr-std" name="ship" value="standard" checked />
            <FieldLabel For="fr-std">Standard</FieldLabel>
        </Field>
        <Field Orientation="horizontal">
            <RadioGroupItem id="fr-exp" name="ship" value="express" />
            <FieldLabel For="fr-exp">Express</FieldLabel>
        </Field>
    </RadioGroup>
</FieldSet>
