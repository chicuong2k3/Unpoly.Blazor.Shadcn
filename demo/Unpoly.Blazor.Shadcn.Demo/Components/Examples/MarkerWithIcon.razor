@* The icon is aria-hidden: the marker's text is the label, and reading the shape beside it aloud
   adds nothing. *@
<div class="flex flex-wrap items-center gap-3">
    <Marker><MarkerIcon><Icon Name="check" Class="size-3" /></MarkerIcon><MarkerContent>Read</MarkerContent></Marker>
    <Marker Variant="border"><MarkerIcon><Icon Name="info" Class="size-3" /></MarkerIcon><MarkerContent>Cited</MarkerContent></Marker>
</div>
