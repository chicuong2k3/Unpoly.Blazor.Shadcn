@* Upstream reaches for react-textarea-autosize here; CSS has since grown the same feature.
   field-sizing-content makes the textarea track its own text, no script anywhere. *@
<InputGroup Class="w-full max-w-sm">
    <textarea data-slot="input-group-control" name="note" placeholder="Autoresize textarea…"
              class="field-sizing-content flex min-h-16 w-full resize-none rounded-md bg-transparent px-3 py-2.5 text-base outline-none md:text-sm"></textarea>
    <InputGroupAddon Align="block-end">
        <InputGroupButton Variant="default" Size="sm" Class="ms-auto">Submit</InputGroupButton>
    </InputGroupAddon>
</InputGroup>
