@* shadcn's date-of-birth picker: a narrow button that says "Select date", a popover, a calendar
   inside it. Same shape as the basic one — the difference upstream is a caption of two dropdowns
   instead of two arrows, which is a month someone can jump forty years back in. *@
<Field Class="mx-auto w-48">
    <FieldLabel For="dp-bday">Date of birth</FieldLabel>
    <PopoverTrigger Target="dp-bday-panel" id="dp-bday" Variant="outline"
                    Class="w-full justify-between font-normal">
        <span data-date-label data-empty>Select date</span>
        <Icon Name="chevron-down" Class="opacity-50" />
    </PopoverTrigger>
    <PopoverContent Id="dp-bday-panel" Align="start" Class="w-fit overflow-hidden p-0">
        <Calendar Name="bday" Month="@Month" Today="@Today" Class="p-3" />
    </PopoverContent>
</Field>

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly Month = new(Today.Year - 30, Today.Month, 1);
}
