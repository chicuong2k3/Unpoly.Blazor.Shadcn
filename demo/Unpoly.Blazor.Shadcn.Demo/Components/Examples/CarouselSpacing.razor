@* The gap is a negative margin on the track and padding on each item, which is upstream's own
   trick: it keeps the first and last slides flush with the edges while the middle ones are
   spaced. Change both numbers together or the ends drift. *@
<div class="relative w-full max-w-lg px-12">
    <Carousel AriaLabel="Wider gaps">
        <CarouselContent Class="-ml-6">
            @foreach (var n in Enumerable.Range(1, 6))
            {
                <CarouselItem Class="basis-1/2 pl-6 md:basis-1/3">
                    <Card><CardContent Class="flex aspect-square items-center justify-center p-6">
                        <span class="num text-2xl font-semibold">@n</span>
                    </CardContent></Card>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious />
        <CarouselNext />
    </Carousel>
</div>
