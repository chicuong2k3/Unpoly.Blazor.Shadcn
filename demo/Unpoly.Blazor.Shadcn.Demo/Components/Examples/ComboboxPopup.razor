@* Upstream's popup pattern: a select-like button opens the panel, and the search box lives
   INSIDE it — focus lands there on open, typing filters, choosing resets the search. The list
   is a [popover], so it sits in the top layer and escapes the scrolling card unclipped. *@
<Card Class="h-40 w-96 overflow-y-auto">
    <CardContent Class="flex flex-col gap-3">
        <p class="text-sm text-muted-foreground">A short, scrolling card.</p>
        <Combobox Target="cb-popup-list">
            <input type="hidden" name="country" value="" data-combobox-value />
            <ComboboxTrigger id="cb-popup" Target="cb-popup-list" Class="w-64">
                <ComboboxValue data-placeholder="Select country">Select country</ComboboxValue>
            </ComboboxTrigger>
            <ComboboxContent Id="cb-popup-list">
                <ComboboxInput Target="cb-popup-list" Placeholder="Search" ShowTrigger="false" />
                <ComboboxEmpty>No items found.</ComboboxEmpty>
                <ComboboxList>
                    <ComboboxItem Value="argentina">Argentina</ComboboxItem>
                    <ComboboxItem Value="australia">Australia</ComboboxItem>
                    <ComboboxItem Value="brazil">Brazil</ComboboxItem>
                    <ComboboxItem Value="canada">Canada</ComboboxItem>
                    <ComboboxItem Value="france">France</ComboboxItem>
                    <ComboboxItem Value="germany">Germany</ComboboxItem>
                    <ComboboxItem Value="japan">Japan</ComboboxItem>
                    <ComboboxItem Value="vietnam">Việt Nam</ComboboxItem>
                </ComboboxList>
            </ComboboxContent>
        </Combobox>
        <p class="text-sm text-muted-foreground">Open it: the list escapes this box.</p>
    </CardContent>
</Card>
