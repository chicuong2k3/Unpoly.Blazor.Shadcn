@* Two different disablings: the whole control, and one item inside an otherwise usable list.
   The second is a real disabled button, so the filter skips it and so does the keyboard. *@
<div class="flex w-64 flex-col gap-4">
    <Combobox Target="cb-dis-a">
        <ComboboxInput Target="cb-dis-a" Placeholder="Select a framework" Disabled />
        <ComboboxContent Id="cb-dis-a" Class="w-64">
            <ComboboxList><ComboboxItem Value="nextjs">Next.js</ComboboxItem></ComboboxList>
        </ComboboxContent>
    </Combobox>

    <Combobox Target="cb-dis-b">
        <input type="hidden" name="plan" value="pro" data-combobox-value />
        <ComboboxTrigger id="cb-dis-b-trigger" Target="cb-dis-b">
            <ComboboxValue data-placeholder="Choose a plan…">Pro</ComboboxValue>
        </ComboboxTrigger>
        <ComboboxContent Id="cb-dis-b" Class="w-64">
            <ComboboxList>
                <ComboboxItem Value="free">Free</ComboboxItem>
                <ComboboxItem Value="pro" Selected>Pro</ComboboxItem>
                <ComboboxItem Value="enterprise" Disabled>Enterprise — talk to sales</ComboboxItem>
            </ComboboxList>
        </ComboboxContent>
    </Combobox>
</div>
