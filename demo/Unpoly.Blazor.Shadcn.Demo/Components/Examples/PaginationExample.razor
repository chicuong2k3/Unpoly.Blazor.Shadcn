@* Every page is a real URL: Unpoly swaps the list in place, and with
   scripting off the browser loads the page. Disabled uses aria-disabled rather than removing the
   href, so the control keeps its place and the row does not reflow at the ends. *@
<Pagination>
    <PaginationContent>
        <PaginationItem><PaginationPrevious Href="/components/pagination?page=1" Disabled /></PaginationItem>
        <PaginationItem><PaginationLink Href="/components/pagination?page=1" IsActive>1</PaginationLink></PaginationItem>
        <PaginationItem><PaginationLink Href="/components/pagination?page=2">2</PaginationLink></PaginationItem>
        <PaginationItem><PaginationLink Href="/components/pagination?page=3">3</PaginationLink></PaginationItem>
        <PaginationItem><PaginationEllipsis /></PaginationItem>
        <PaginationItem><PaginationLink Href="/components/pagination?page=9">9</PaginationLink></PaginationItem>
        <PaginationItem><PaginationNext Href="/components/pagination?page=2" /></PaginationItem>
    </PaginationContent>
</Pagination>
