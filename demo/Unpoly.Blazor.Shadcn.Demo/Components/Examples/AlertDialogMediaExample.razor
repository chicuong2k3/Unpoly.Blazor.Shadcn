@* An icon above the question, which is what shadcn’s media slot is for. It is decorative: the
   title already says what kind of question this is, and announcing it first says it twice. *@
<AlertDialogTrigger Target="ad-media" Variant="outline">Share Project</AlertDialogTrigger>

<AlertDialog Id="ad-media">
    <AlertDialogHeader>
        <AlertDialogMedia aria-hidden="true"><Icon Name="circle-fading-plus" /></AlertDialogMedia>
        <AlertDialogTitle>Share this project?</AlertDialogTitle>
        <AlertDialogDescription>
            Anyone with the link will be able to view and edit this project.
        </AlertDialogDescription>
    </AlertDialogHeader>
    <AlertDialogFooter>
        <AlertDialogCancel>Cancel</AlertDialogCancel>
        <AlertDialogAction>Share</AlertDialogAction>
    </AlertDialogFooter>
</AlertDialog>
