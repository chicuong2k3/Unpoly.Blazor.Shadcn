@* Opens on hover and on focus. A card only a mouse can reach is a card half the readers never
   see, which is the failure this component exists to avoid rather than to introduce. *@
<HoverCardTrigger Target="hc-basic" Class="underline underline-offset-4">@@marta</HoverCardTrigger>
<HoverCardContent Id="hc-basic" Class="w-72 p-4">
    <div class="flex gap-3">
        <Avatar><AvatarFallback>MR</AvatarFallback></Avatar>
        <div class="text-sm">
            <div class="font-medium">Marta Ruiz</div>
            <p class="text-muted-foreground">128 orders. Joined March 2024.</p>
        </div>
    </div>
</HoverCardContent>
