@* Upstream's own card: a link-styled trigger, then the handle, the blurb and the join date.
   It opens on focus too — a card only a mouse can reach is a card half the readers never see. *@
<HoverCardTrigger Target="hc-basic" OpenDelay="10" CloseDelay="100"
                  Class="@ButtonVariants.Of("link", "default")">Hover Here</HoverCardTrigger>
<HoverCardContent Id="hc-basic" Class="flex w-64 flex-col gap-0.5">
    <div class="font-semibold">@@nextjs</div>
    <div>The React Framework – created and maintained by @@vercel.</div>
    <div class="mt-1 text-xs text-muted-foreground">Joined December 2021</div>
</HoverCardContent>
