@* Variant="line" is the whole of it. The list drops its pill and its background, the triggers
   drop theirs, and the active one grows a rule along its trailing edge — an ::after the recipe
   already carries, positioned from the orientation so it sits under a row and beside a column.

   This example used to reproduce all of that by hand with six override classes, which is how it
   ended up with a border instead of the rule and a different offset from the text. *@
<Tabs Value="orders" Class="w-[460px]">
    <TabsList Variant="line">
        @foreach (var panel in Panels)
        {
            <TabsTrigger Value="@panel.Value">@panel.Label</TabsTrigger>
        }
    </TabsList>
    <TabsContent Value="orders" Class="pt-4 text-sm text-muted-foreground">Four orders this week.</TabsContent>
    <TabsContent Value="refunds" Hidden Class="pt-4 text-sm text-muted-foreground">None outstanding.</TabsContent>
</Tabs>

@code {
    static readonly (string Value, string Label)[] Panels = [("orders", "Orders"), ("refunds", "Refunds")];
}
