@* Align="end" is the reader's own side, so it follows the direction rather than the screen. *@
<div dir="rtl" class="flex flex-col gap-3">
    <Message Class="w-[440px]">
        <MessageAvatar><Avatar><AvatarFallback>مي</AvatarFallback></Avatar></MessageAvatar>
        <MessageContent>
            <Bubble Variant="muted"><BubbleContent>هل أُرسلت الفاتورة؟</BubbleContent></Bubble>
        </MessageContent>
    </Message>
    <Message Align="end" Class="w-[440px]">
        <MessageContent>
            <Bubble><BubbleContent>أرسلتها هذا الصباح.</BubbleContent></Bubble>
        </MessageContent>
    </Message>
</div>
