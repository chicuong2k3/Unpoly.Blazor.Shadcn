@* The whole thing: validate on blur without leaving the page, post on submit, and never persist
   anything on a validating request. up-validate fires the same handler with X-Up-Validate set;
   the server answers 422 and Unpoly swaps the field back carrying its error. *@
<form method="post" action="/account/email" up-target=".preview" up-disable class="w-[420px]">
    <AntiforgeryToken />
    <FieldGroup>
        <Field>
            <FieldLabel For="fm-email">Email</FieldLabel>
            <Input id="fm-email" name="email" type="email" required up-validate />
            <FieldDescription>Checked as you leave the field, without a page load.</FieldDescription>
        </Field>
        <Field>
            <FieldLabel For="fm-confirm">Confirm</FieldLabel>
            <Input id="fm-confirm" name="confirm" type="email" required up-validate />
        </Field>
        <Button Type="submit">Change it</Button>
    </FieldGroup>
</form>
