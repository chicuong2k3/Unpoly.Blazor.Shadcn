@* Quick replies: the bubble IS the button. Not a row of buttons under the thread — the reader
   presses the thing they read, which is why every Bubble variant styles
   `bubble-content:is(button,a):hover` in the first place.

   A form, so it posts. Unpoly swaps the thread and nothing here is a click handler. *@
<form method="post" action="/chat/1/reply" up-target=".preview" up-disable
      class="flex w-full max-w-sm flex-col gap-8">
    <AntiforgeryToken />

    <Bubble Variant="muted">
        <BubbleContent>How can I help you today?</BubbleContent>
    </Bubble>

    <BubbleGroup>
        @foreach (var (value, label) in Replies)
        {
            <Bubble Variant="tinted" Align="end">
                <BubbleContent Type="submit" name="reply" value="@value">@label</BubbleContent>
            </Bubble>
        }
    </BubbleGroup>
</form>

@code {
    static readonly (string Value, string Label)[] Replies =
    [
        ("password", "I forgot my password"),
        ("subscription", "I need help with my subscription"),
        ("human", "Something else. Talk to a human."),
    ];
}
