@* Waiting. animate-pulse rather than a spinner, because a marker is a word in a line of text and
   a turning circle in a sentence is a distraction rather than a signal. *@
<div class="flex flex-wrap items-center gap-3">
    <Marker Class="animate-pulse">
        <MarkerIcon><Icon Name="loader-circle" Class="size-3" /></MarkerIcon>
        <MarkerContent>Thinking</MarkerContent>
    </Marker>
    <Marker Variant="border" Class="animate-pulse"><MarkerContent>Searching the docs</MarkerContent></Marker>
</div>
