@* Length is what the compiler reads to know when the code is complete, so it has to match the
   number of boxes. Four is common for an email code. *@
<InputOtp Name="code4" Length="4">
    <InputOtpGroup>
        <InputOtpSlot First AriaLabel="Digit 1 of 4" />
        <InputOtpSlot AriaLabel="Digit 2 of 4" />
        <InputOtpSlot AriaLabel="Digit 3 of 4" />
        <InputOtpSlot AriaLabel="Digit 4 of 4" />
    </InputOtpGroup>
</InputOtp>
