@* Upstream's own sample: the combobox input with a leading icon addon, and a grouped list of
   timezones behind it. Anything nested inside ComboboxInput becomes an addon in the same frame,
   so the icon, the box and the chevron are one control rather than three lined up. *@
<div class="w-60">
    <Combobox Target="cb-ig-list">
        <input type="hidden" name="timezone" value="" data-combobox-value />
        <ComboboxInput Target="cb-ig-list" Placeholder="Select a timezone">
            <InputGroupAddon><Icon Name="clock" /></InputGroupAddon>
        </ComboboxInput>

        <ComboboxContent Id="cb-ig-list">
            <ComboboxEmpty>No timezones found.</ComboboxEmpty>
            <ComboboxList>
                @foreach (var (region, zones) in Timezones)
                {
                    <ComboboxGroup>
                        <ComboboxLabel>@region</ComboboxLabel>
                        @foreach (var zone in zones)
                        {
                            <ComboboxItem Value="@zone">@zone</ComboboxItem>
                        }
                    </ComboboxGroup>
                }
            </ComboboxList>
        </ComboboxContent>
    </Combobox>
</div>

@code {
    static readonly (string Region, string[] Zones)[] Timezones =
    [
        ("Americas", ["(GMT-5) New York", "(GMT-8) Los Angeles", "(GMT-6) Chicago", "(GMT-3) São Paulo"]),
        ("Europe", ["(GMT+0) London", "(GMT+1) Paris", "(GMT+1) Berlin", "(GMT+1) Madrid"]),
        ("Asia/Pacific", ["(GMT+9) Tokyo", "(GMT+8) Singapore", "(GMT+7) Hồ Chí Minh", "(GMT+11) Sydney"]),
    ];
}
