@* Upstream's own sample: a share link. The label is there for a screen reader and invisible to
   everyone else, the input is read-only because the point is to copy it, and the footer aligns
   its buttons to the start rather than the end. *@
<DialogTrigger Target="dlg-custom">Share</DialogTrigger>

<Dialog Id="dlg-custom">
    <DialogHeader>
        <DialogTitle>Share link</DialogTitle>
        <DialogDescription>Anyone who has this link will be able to view this.</DialogDescription>
    </DialogHeader>
    <div class="flex items-center gap-2">
        <Field Class="flex-1">
            <FieldLabel For="dlg-share-link" Class="sr-only">Link</FieldLabel>
            <Input id="dlg-share-link" value="https://ui.shadcn.com/docs/installation" readonly />
        </Field>
        <Button Type="button" Size="icon" Class="shrink-0" aria-label="Copy link">
            <Icon Name="copy" />
        </Button>
    </div>
    <DialogFooter Class="sm:justify-start">
        <DialogClose Variant="secondary">Close</DialogClose>
    </DialogFooter>
</Dialog>
