@* The rule between items is `border-b` on the item, so removing it is removing a class. *@
<div class="flex flex-col gap-8">
    <Accordion Class="w-[420px]">
        <AccordionItem Name="b1" Open><AccordionTrigger>With rules</AccordionTrigger>
            <AccordionContent>The default.</AccordionContent></AccordionItem>
        <AccordionItem Name="b1"><AccordionTrigger>Second</AccordionTrigger>
            <AccordionContent>And a rule above it.</AccordionContent></AccordionItem>
    </Accordion>

    <Accordion Class="w-[420px]">
        <AccordionItem Name="b2" Class="border-b-0" Open><AccordionTrigger>Without</AccordionTrigger>
            <AccordionContent>Separated by space instead.</AccordionContent></AccordionItem>
        <AccordionItem Name="b2" Class="border-b-0"><AccordionTrigger>Second</AccordionTrigger>
            <AccordionContent>No rule.</AccordionContent></AccordionItem>
    </Accordion>
</div>
