@* The separator variant is a rule with a word sitting on it, for a break in a stream of
   messages: "yesterday", "unread from here". *@
<div class="flex w-[420px] flex-col gap-3 text-sm">
    <p class="text-muted-foreground">Sent it this morning.</p>
    <Marker Variant="separator"><MarkerContent>Yesterday</MarkerContent></Marker>
    <p class="text-muted-foreground">Did the invoice go out?</p>
</div>
