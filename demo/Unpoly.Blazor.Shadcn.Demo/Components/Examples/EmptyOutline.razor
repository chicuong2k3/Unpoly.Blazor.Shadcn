@* A dashed frame says "this is where something will be" rather than "something went wrong",
   which is the right register for a list that is empty because nothing has been added yet. *@
<Empty Class="w-full max-w-lg rounded-lg border border-dashed">
    <EmptyHeader>
        <EmptyIcon><Icon Name="folder" Class="size-5" /></EmptyIcon>
        <EmptyTitle>No projects yet</EmptyTitle>
        <EmptyDescription>Everything you create will show up here.</EmptyDescription>
    </EmptyHeader>
    <EmptyContent><Button><Icon Name="plus" />New project</Button></EmptyContent>
</Empty>
