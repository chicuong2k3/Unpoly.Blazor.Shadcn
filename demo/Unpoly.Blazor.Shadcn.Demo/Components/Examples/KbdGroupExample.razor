@* A chord is a group, not three keys with spaces between them: the group is what says the keys
   are pressed together. *@
<div class="flex flex-wrap items-center gap-4 text-sm">
    <KbdGroup><Kbd>⌘</Kbd><Kbd>K</Kbd></KbdGroup>
    <KbdGroup><Kbd>Ctrl</Kbd><Kbd>Shift</Kbd><Kbd>P</Kbd></KbdGroup>
    <span class="flex items-center gap-1.5">then <Kbd>Enter</Kbd></span>
</div>
