@* Inside a Field it gets its label, its description and its error handling from the field
   rather than from three more attributes. *@
<Field Class="w-[420px]">
    <FieldLabel For="ta-bio">Bio</FieldLabel>
    <Textarea id="ta-bio" name="bio" rows="4" placeholder="A sentence or two." />
    <FieldDescription>Shown on your public profile. Two hundred characters or so.</FieldDescription>
</Field>
