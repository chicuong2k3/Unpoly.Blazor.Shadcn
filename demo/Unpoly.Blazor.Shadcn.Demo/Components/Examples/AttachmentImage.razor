@* The same thumbnails with the two controls a real file list needs: a remove button, and a
   trigger laid over the whole card so the card itself opens the file. Real width and height on
   the image, so the row does not resize as the thumbnails arrive. *@
<div class="w-full max-w-sm">
    <AttachmentGroup Class="w-full">
        @foreach (var (name, meta, src) in Images)
        {
            <li>
                <Attachment Orientation="vertical">
                    <AttachmentMedia Variant="image">
                        <img src="@src" alt="" width="160" height="120" loading="lazy" />
                    </AttachmentMedia>
                    <AttachmentContent>
                        <AttachmentTitle>@name</AttachmentTitle>
                        <AttachmentDescription>@meta</AttachmentDescription>
                    </AttachmentContent>
                    <AttachmentActions>
                        <AttachmentAction AriaLabel="@($"Remove {name}")"><Icon Name="x" /></AttachmentAction>
                    </AttachmentActions>
                    <AttachmentTrigger Href="@src">
                        <span class="sr-only">Open @name</span>
                    </AttachmentTrigger>
                </Attachment>
            </li>
        }
    </AttachmentGroup>
</div>

@code {
    static readonly (string Name, string Meta, string Src)[] Images =
    [
        ("workspace.png", "PNG · 820 KB", "https://placehold.co/160x120/e4e4e7/71717a?text=Workspace"),
        ("desk-reference.jpg", "JPG · 1.1 MB", "https://placehold.co/160x120/e4e4e7/71717a?text=Desk"),
        ("office-reference.jpg", "JPG · 940 KB", "https://placehold.co/160x120/e4e4e7/71717a?text=Office"),
    ];
}
