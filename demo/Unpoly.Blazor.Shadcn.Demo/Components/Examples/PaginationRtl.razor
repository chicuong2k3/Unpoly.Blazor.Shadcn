@* The arrows flip, because "previous" is a direction in the reading order rather than on the
   screen — which is the one place a mirrored layout usually gets wrong. *@
<div dir="rtl">
    <Pagination>
        <PaginationContent>
            <PaginationItem>
                <PaginationPrevious Href="/components/pagination?page=2" Class="[&_svg]:rotate-180" />
            </PaginationItem>
            <PaginationItem><PaginationLink Href="/components/pagination?page=3" IsActive>٣</PaginationLink></PaginationItem>
            <PaginationItem><PaginationLink Href="/components/pagination?page=4">٤</PaginationLink></PaginationItem>
            <PaginationItem>
                <PaginationNext Href="/components/pagination?page=4" Class="[&_svg]:rotate-180" />
            </PaginationItem>
        </PaginationContent>
    </Pagination>
</div>
