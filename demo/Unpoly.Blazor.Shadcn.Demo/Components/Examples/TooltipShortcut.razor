@* Where the shortcut does not fit on the control itself. It opens on focus as well as on hover,
   so the hint is reachable by the keyboard it describes — and the pointer can reach the key
   inside the tip, which is what hoverable content is for. *@
<TooltipTrigger Target="tip-save" Variant="outline" Size="icon-sm" aria-label="Save">
    <Icon Name="download" />
</TooltipTrigger>
<TooltipContent Id="tip-save">
    Save Changes <Kbd Class="ms-1">S</Kbd>
</TooltipContent>
