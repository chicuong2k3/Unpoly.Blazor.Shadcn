@* A marker that goes somewhere IS the link, and one that does something is the button — one
   element, one focus stop, and the status bar tells you where the first one leads. *@
<div class="flex w-full max-w-sm flex-col gap-8">
    <Marker Href="/components/button">
        <MarkerIcon><Icon Name="git-branch" /></MarkerIcon>
        <MarkerContent>View the pull request</MarkerContent>
    </Marker>

    <form method="post" action="/markers/revert" id="marker-revert-form"
          up-target="#preview-marker-links" up-disable>
        <AntiforgeryToken />
        <button type="submit" data-slot="marker" data-variant="default"
                class="group/marker relative flex min-h-4 w-full items-center gap-2 text-start text-control text-muted-foreground transition-colors hover:text-foreground [&amp;_svg:not([class*='size-'])]:size-4">
            <MarkerIcon><Icon Name="refresh-cw" /></MarkerIcon>
            <MarkerContent>Revert this change</MarkerContent>
        </button>
    </form>
</div>
