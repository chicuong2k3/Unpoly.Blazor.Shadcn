@* Air Datepicker, attached by an up.compiler so it is rebuilt after every
   fragment swap and torn down with the field. What the form posts is ISO; what the field shows
   is the locale format. *@
<div class="w-[220px]">
    <FormField For="from" Label="Starting">
        <DatePicker id="from" Name="from" Value="2026-03-01" />
    </FormField>
</div>
