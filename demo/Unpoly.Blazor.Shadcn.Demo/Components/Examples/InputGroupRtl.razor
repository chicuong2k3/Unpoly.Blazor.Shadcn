@* Align="inline-start" is the reading edge, so the icon moves with it — which is why the four
   alignments are named inline/block rather than left/right. *@
<div dir="rtl">
    <InputGroup Class="w-[360px]">
        <InputGroupAddon><Icon Name="search" /></InputGroupAddon>
        <InputGroupControl name="q" type="search" placeholder="ابحث في الطلبات…" />
        <InputGroupAddon Align="inline-end"><KbdGroup><Kbd>⌘</Kbd><Kbd>K</Kbd></KbdGroup></InputGroupAddon>
    </InputGroup>
</div>
