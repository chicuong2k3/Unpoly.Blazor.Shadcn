@* Upstream uses Item the other way round from every other sample here: not a row with a menu in
   it, but a row INSIDE each menu entry — which is how a picker shows an avatar, a name and an
   address without three separate class strings per row. *@
<DropdownMenuTrigger Target="item-dd" Variant="outline">
    Select <Icon Name="chevron-down" />
</DropdownMenuTrigger>

<DropdownMenuContent Id="item-dd" Align="end" Class="w-48">
    @foreach (var (username, email) in People)
    {
        <DropdownMenuItem>
            <Item Size="xs" Class="w-full p-2">
                <ItemMedia>
                    <Avatar Class="size-6.5">
                        <AvatarFallback>@username[..1].ToUpperInvariant()</AvatarFallback>
                    </Avatar>
                </ItemMedia>
                <ItemContent Class="gap-0">
                    <ItemTitle>@username</ItemTitle>
                    <ItemDescription Class="leading-none">@email</ItemDescription>
                </ItemContent>
            </Item>
        </DropdownMenuItem>
    }
</DropdownMenuContent>

@code {
    static readonly (string Username, string Email)[] People =
    [
        ("shadcn", "shadcn@vercel.com"),
        ("maxleiter", "maxleiter@vercel.com"),
        ("evilrabbit", "evilrabbit@vercel.com"),
    ];
}
