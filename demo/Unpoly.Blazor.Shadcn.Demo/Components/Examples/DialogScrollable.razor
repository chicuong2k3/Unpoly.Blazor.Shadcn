@* Only the middle scrolls. The header and the close button stay where they are, and the inner
   box is pulled out to the panel's own padding with -mx-4 px-4 so the scrollbar sits at the
   edge of the dialog rather than in a channel of its own — which is exactly what upstream does. *@
<DialogTrigger Target="dlg-scroll">Scrollable Content</DialogTrigger>

<Dialog Id="dlg-scroll">
    <DialogHeader>
        <DialogTitle>Scrollable Content</DialogTitle>
        <DialogDescription>This is a dialog with scrollable content.</DialogDescription>
    </DialogHeader>
    <div class="-mx-4 max-h-[50vh] overflow-y-auto px-4">
        @foreach (var n in Enumerable.Range(1, 10))
        {
            <p class="mb-4 leading-normal text-sm text-muted-foreground">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
                incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis
                nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
            </p>
        }
    </div>
</Dialog>
