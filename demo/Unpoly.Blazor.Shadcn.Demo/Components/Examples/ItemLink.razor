@* Href makes the WHOLE row the link: one target, one focus stop, and Unpoly follows it. A row
   with a link inside it gives you a small target and two tab stops instead. The second row
   leaves the site — target and rel ride through as ordinary attributes. *@
<div class="flex w-full max-w-md flex-col gap-6">
    <Item Variant="outline" Href="/components/card">
        <ItemContent>
            <ItemTitle>Visit our documentation</ItemTitle>
            <ItemDescription>Learn how to get started with our components.</ItemDescription>
        </ItemContent>
        <ItemActions><Icon Name="chevron-right" Class="size-4" /></ItemActions>
    </Item>

    <Item Variant="outline" Href="https://ui.shadcn.com/docs/components/base/item"
          target="_blank" rel="noopener noreferrer">
        <ItemContent>
            <ItemTitle>External resource</ItemTitle>
            <ItemDescription>Opens in a new tab with security attributes.</ItemDescription>
        </ItemContent>
        <ItemActions><Icon Name="external-link" Class="size-4" /></ItemActions>
    </Item>
</div>
