@* ShowValues prints each figure above its bar, outside the plot area so the tallest bar is still
   the full Height. Color takes any CSS colour; the chart-* tokens follow the theme in light and
   dark. With no Highlight every bar is drawn at full strength. *@
<div class="grid gap-8 sm:grid-cols-2">
    <BarChart Values="@Minutes"
              Labels="@Months"
              Height="80"
              ShowValues
              Color="var(--chart-2)"
              ValueSuffix=" min"
              AriaLabel="Minutes practised per month" />

    @* No labels: each bar is then named by its position ("Bar 3: 4 errors") for a screen reader,
       and the row under the chart is simply not drawn. *@
    <BarChart Values="@Errors"
              Height="80"
              Highlight="9"
              Color="var(--destructive)"
              ValueSuffix=" errors"
              AriaLabel="Errors per deploy, last 10 deploys" />
</div>

@code {
    static readonly double[] Minutes = [320, 410, 280, 505, 450, 610];
    static readonly string[] Months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
    static readonly double[] Errors = [2, 0, 1, 4, 0, 0, 3, 1, 0, 6];
}
