@* The description belongs to the field, not to the label, so it is announced after the name
   rather than as part of it. *@
<Field Orientation="horizontal" Class="w-[420px] items-start">
    <Checkbox id="marketing" name="marketing" value="yes" Class="mt-1" />
    <FieldContent>
        <FieldLabel For="marketing">Send me the newsletter</FieldLabel>
        <FieldDescription>Once a month. Unsubscribing is one click and we do not ask why.</FieldDescription>
    </FieldContent>
</Field>
