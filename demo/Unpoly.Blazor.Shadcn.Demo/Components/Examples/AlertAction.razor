@* An action in an alert is a link or a form, not a click handler — so it works before any
   JavaScript and can be opened in a tab. *@
<Alert Class="w-[520px]">
    <Icon Name="info" />
    <AlertTitle>Two addresses on this account</AlertTitle>
    <AlertDescription>
        We will ship to the newest unless you say otherwise.
        <div class="mt-3 flex gap-2">
            <Button Href="/account/addresses">Choose one</Button>
            <Button Variant="ghost" Href="/account">Not now</Button>
        </div>
    </AlertDescription>
</Alert>
