@* Inside the field's frame, which is where a search box usually carries it. *@
<InputGroup Class="w-[340px]">
    <InputGroupAddon><Icon Name="search" /></InputGroupAddon>
    <InputGroupControl name="q" type="search" placeholder="Search components…" />
    <InputGroupAddon Align="inline-end">
        <KbdGroup><Kbd>⌘</Kbd><Kbd>K</Kbd></KbdGroup>
    </InputGroupAddon>
</InputGroup>
