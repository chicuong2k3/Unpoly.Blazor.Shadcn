@* Recharts draws a floating tooltip on a canvas that nothing else can read. A table already has
   one: the browser's own title, plus the number in the DOM where a screen reader, a print
   stylesheet and Find in Page can all reach it. That is the trade this makes on purpose. *@
<Chart Id="tooltip" Series="@Palette" Class="h-56 w-full max-w-lg">
    <table class="h-full w-full">
        <caption class="sr-only">Revenue by week</caption>
        <thead class="sr-only"><tr><th scope="col">Week</th><th scope="col">Revenue</th></tr></thead>
        <tbody class="flex h-full items-stretch gap-2">
            @foreach (var (label, value) in Weeks)
            {
                <tr class="group flex flex-1 flex-col items-center justify-end gap-1.5">
                    <td class="w-full rounded-sm transition-opacity hover:opacity-80"
                        style="@($"height: {value * 100 / 62}%; background: var(--color-revenue)")"
                        title="@($"{label}: ${value}00")">
                        <span class="sr-only">$@(value)00</span>
                    </td>
                    <th scope="row" class="text-[10px] font-normal text-muted-foreground">@label</th>
                </tr>
            }
        </tbody>
    </table>
</Chart>

@code {
    static readonly Dictionary<string, string> Palette = new() { ["revenue"] = "var(--chart-1)" };

    static readonly (string Label, int Value)[] Weeks =
    [
        ("W1", 29), ("W2", 34), ("W3", 31), ("W4", 42), ("W5", 39),
        ("W6", 48), ("W7", 44), ("W8", 56), ("W9", 51), ("W10", 62),
    ];
}
