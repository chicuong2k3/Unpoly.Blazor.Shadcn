<form method="post" enctype="multipart/form-data" onsubmit="event.preventDefault()" class="max-w-md space-y-4">
    <FileUpload Name="image" Action="" SubmitWithForm="true" Required="true"
                Accept="image/png,image/jpeg,image/webp" MaxBytes="12582912"
                Prompt="Choose an image, or drop it here" Hint="PNG, JPG or WEBP · up to 12 MB" />
    <Button Type="submit">Save image</Button>
    <p class="text-xs text-muted-foreground">Preview only. This demo does not submit to a server.</p>
</form>
