@* Two months side by side and one range across them, as shadcn shows it — and two names, for
   the same reason the slider has no second thumb: a range is two values, and posting them as two
   fields is what a server reads and what the Back button preserves.

   The second month is the first plus one. Nothing is measured and no state is shared: the
   `from` calendar disables nothing, and `to` disables everything before the day `from` sits on. *@
<div class="flex flex-wrap items-start gap-4">
    <div class="flex flex-col gap-2">
        <Label>From</Label>
        <Calendar Name="from" Month="@ThisMonth" Selected="@From" Class="w-fit rounded-lg border p-3" />
    </div>
    <div class="flex flex-col gap-2">
        <Label>To</Label>
        <Calendar Name="to" Month="@ThisMonth.AddMonths(1)" Selected="@To"
                  Disabled="@(d => d < From)" Class="w-fit rounded-lg border p-3" />
    </div>
</div>

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly ThisMonth = new(Today.Year, Today.Month, 1);
    static readonly DateOnly From = ThisMonth.AddDays(11);
    static readonly DateOnly To = From.AddDays(30);
}
