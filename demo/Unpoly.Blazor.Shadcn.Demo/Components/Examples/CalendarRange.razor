@* One calendar, two months, one range across them — as shadcn draws it.

   With scripting off this is a grid of checkboxes: tick the first day and the last, and the
   server takes the min and the max. That is a working range picker before any JavaScript runs,
   which is not something a component built on a state variable can offer. ui.js then makes it
   behave the way one should — a third click starts again, and the band fills in as you go. *@
<form method="post" action="/bookings" up-target="#preview-calendar-range" up-disable
      id="calendar-range-form" class="flex flex-col items-start gap-3">
    <AntiforgeryToken />
    <Calendar Mode="range" Months="2" Name="stay" Month="@ThisMonth" From="@From" To="@To"
              Disabled="@(d => d < Today)" Class="w-fit rounded-lg border p-3" />
    <Button Type="submit" Size="sm">Book these nights</Button>
</form>

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly ThisMonth = new(Today.Year, Today.Month, 1);
    static readonly DateOnly From = ThisMonth.AddDays(11);
    static readonly DateOnly To = From.AddDays(9);
}
