@* Side is a hint, not a promise: the compiler flips it when there is no room, because a tooltip
   half off the screen is worse than one on the wrong side. *@
<div class="flex flex-wrap items-center gap-3">
    <TooltipTrigger Target="tip-top" Variant="outline">Top</TooltipTrigger>
    <TooltipContent Id="tip-top" Side="top">Above the trigger</TooltipContent>

    <TooltipTrigger Target="tip-bottom" Variant="outline">Bottom</TooltipTrigger>
    <TooltipContent Id="tip-bottom" Side="bottom">Below it</TooltipContent>
</div>
