@* Four sides, as upstream shows them. Side is a hint rather than a promise: the compiler flips
   it when there is no room, and the arrow follows the side the tip actually landed on. *@
<div class="flex flex-wrap gap-2">
    @foreach (var side in new[] { "left", "top", "bottom", "right" })
    {
        <TooltipTrigger Target="@($"tip-{side}")" Variant="outline" Class="w-fit capitalize">
            @side
        </TooltipTrigger>
        <TooltipContent Id="@($"tip-{side}")" Side="@side">Add to library</TooltipContent>
    }
</div>
