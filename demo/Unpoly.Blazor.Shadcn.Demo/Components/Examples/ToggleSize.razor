@* Three sizes, and each keeps a square minimum so an icon-only toggle stays square. *@
<div class="flex flex-wrap items-center gap-2">
    <Toggle Size="sm" Variant="outline" aria-label="Small"><Icon Name="italic" />Small</Toggle>
    <Toggle Variant="outline" aria-label="Default"><Icon Name="italic" />Default</Toggle>
    <Toggle Size="lg" Variant="outline" aria-label="Large"><Icon Name="italic" />Large</Toggle>
</div>
