@* shadcn's own four rows, and the last one is the point: the whole card is a <FieldLabel>, so
   clicking anywhere on it toggles the box. A label wrapping a control needs no `for`, no id and
   no handler — the platform gives you the hit target for free, and it is the difference between
   a checkbox you aim at and a card you press. *@
<div dir="rtl">
    <FieldGroup Class="max-w-sm">
        <Field Orientation="horizontal">
            <Checkbox id="rtl-terms" name="terms" />
            <FieldLabel For="rtl-terms">قبول الشروط والأحكام</FieldLabel>
        </Field>

        <Field Orientation="horizontal">
            <Checkbox id="rtl-terms-2" name="terms-2" checked />
            <FieldContent>
                <FieldLabel For="rtl-terms-2">قبول الشروط والأحكام</FieldLabel>
                <FieldDescription>بالنقر على هذا المربع، فإنك توافق على الشروط.</FieldDescription>
            </FieldContent>
        </Field>

        <Field Orientation="horizontal" data-disabled>
            <Checkbox id="rtl-notify" name="notify" disabled />
            <FieldLabel For="rtl-notify">تفعيل الإشعارات</FieldLabel>
        </Field>

        <FieldLabel Class="rounded-lg border p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <Field Orientation="horizontal">
                <Checkbox id="rtl-notify-2" name="notify-2" />
                <FieldContent>
                    <FieldTitle>تفعيل الإشعارات</FieldTitle>
                    <FieldDescription>يمكنك تفعيل أو إلغاء تفعيل الإشعارات في أي وقت.</FieldDescription>
                </FieldContent>
            </Field>
        </FieldLabel>
    </FieldGroup>
</div>
