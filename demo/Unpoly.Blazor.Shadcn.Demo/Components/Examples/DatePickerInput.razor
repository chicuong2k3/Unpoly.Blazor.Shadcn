@* Inside a field frame, with the icon as an addon. The browser still draws its own picker
   button — which is why the addon is on the leading edge and not on top of it. *@
<InputGroup Class="w-[280px]">
    <InputGroupAddon><Icon Name="calendar" /></InputGroupAddon>
    <input type="date" name="due" value="2026-03-20" aria-label="Due"
           class="min-w-0 flex-1 bg-transparent px-3 text-control outline-none" />
</InputGroup>
