@* Lines of unequal length. Equal ones read as a barcode rather than as text, and the last line
   of a paragraph is never full width. *@
<div class="flex w-[420px] flex-col gap-2">
    <Skeleton Class="h-4 w-full" />
    <Skeleton Class="h-4 w-[92%]" />
    <Skeleton Class="h-4 w-[97%]" />
    <Skeleton Class="h-4 w-[60%]" />
</div>
