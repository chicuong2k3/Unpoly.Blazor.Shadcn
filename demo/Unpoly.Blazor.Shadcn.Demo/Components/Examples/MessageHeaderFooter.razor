@* The header carries who and when; the footer carries what happened to it. Both are optional,
   and a thread that shows a timestamp on every line is a thread nobody reads. *@
<Message Align="end" Class="w-[440px]">
    <MessageContent>
        <MessageHeader>
            <time class="num text-xs text-muted-foreground" datetime="2026-03-11T09:14">09:14</time>
        </MessageHeader>
        <Bubble><BubbleContent>Sent it this morning.</BubbleContent></Bubble>
        <MessageFooter>
            <Marker Variant="border">
                <MarkerIcon><Icon Name="check" Class="size-3" /></MarkerIcon>
                <MarkerContent>Read</MarkerContent>
            </Marker>
        </MessageFooter>
    </MessageContent>
</Message>
