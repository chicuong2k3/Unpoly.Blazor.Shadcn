@* Four outline buttons, one per side, as upstream draws them. *@
<div class="flex flex-wrap justify-center gap-2">
    @foreach (var side in new[] { "left", "top", "bottom", "right" })
    {
        <HoverCardTrigger Target="@($"hc-side-{side}")" OpenDelay="100" CloseDelay="100"
                          Class="@ButtonVariants.Of("outline", "default", "capitalize")">
            @side
        </HoverCardTrigger>
        <HoverCardContent Id="@($"hc-side-{side}")" Side="@side" Class="w-64">
            <div class="flex flex-col gap-1">
                <h4 class="font-medium">Hover Card</h4>
                <p>This hover card appears on the @side side of the trigger.</p>
            </div>
        </HoverCardContent>
    }
</div>
