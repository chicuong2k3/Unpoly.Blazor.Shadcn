@* Leave Name off and each item is independent — the browser only closes siblings when they
   share a name. That is shadcn's type="multiple", written as the absence of an attribute. *@
<Accordion Class="w-[460px]">
    <AccordionItem Open>
        <AccordionTrigger>Shipping</AccordionTrigger>
        <AccordionContent>Two to four working days, tracked.</AccordionContent>
    </AccordionItem>
    <AccordionItem Open>
        <AccordionTrigger>Returns</AccordionTrigger>
        <AccordionContent>Thirty days, unworn, with the receipt.</AccordionContent>
    </AccordionItem>
</Accordion>
