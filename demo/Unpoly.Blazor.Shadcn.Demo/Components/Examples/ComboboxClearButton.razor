@* ShowClear puts an ✕ inside the frame that empties the selection — hidden while there is
   nothing to clear, so the control never offers an action that would do nothing. *@
<div class="w-64">
    <Combobox Target="cb-clear-list">
        <input type="hidden" name="framework" value="nextjs" data-combobox-value />
        <ComboboxInput Target="cb-clear-list" Placeholder="Select a framework" ShowClear
                       Value="Next.js" />
        <ComboboxContent Id="cb-clear-list" Class="w-64">
            <ComboboxEmpty>No items found.</ComboboxEmpty>
            <ComboboxList>
                <ComboboxItem Value="nextjs" Selected>Next.js</ComboboxItem>
                <ComboboxItem Value="sveltekit">SvelteKit</ComboboxItem>
                <ComboboxItem Value="nuxtjs">Nuxt.js</ComboboxItem>
                <ComboboxItem Value="remix">Remix</ComboboxItem>
                <ComboboxItem Value="astro">Astro</ComboboxItem>
            </ComboboxList>
        </ComboboxContent>
    </Combobox>
</div>
