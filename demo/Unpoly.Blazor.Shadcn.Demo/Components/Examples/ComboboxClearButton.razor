@* ComboboxClear hides itself while there is nothing to clear — the hidden attribute is toggled by
   the same script that owns the value, so there is one source of truth for "is anything chosen". *@
<div class="w-80">
    <Combobox Target="cb-clear-list" Multiple>
        <ComboboxChips data-name="topics">
            <ComboboxChip Value="css" Name="topics" Label="CSS">CSS</ComboboxChip>
            <ComboboxChipInput id="cb-clear-input" Placeholder="Add a topic…" AriaLabel="Topics" />
            <ComboboxClear Label="Clear all topics" />
        </ComboboxChips>

        <ComboboxContent Id="cb-clear-list" Class="w-80">
            <ComboboxList>
                <ComboboxEmpty>No topic by that name.</ComboboxEmpty>
                <ComboboxItem Value="css" Selected>CSS</ComboboxItem>
                <ComboboxItem Value="html">HTML</ComboboxItem>
                <ComboboxItem Value="a11y" Keywords="accessibility">Accessibility</ComboboxItem>
            </ComboboxList>
        </ComboboxContent>
    </Combobox>
</div>
