@* Mirrored: the chevron moves to the left of the button, the panel aligns to the right edge, and
   the calendar draws its own week in the direction the locale reads. Nothing here says "left" or
   "right" — the classes are logical, which is what makes one markup serve both directions. *@
<div dir="rtl">
    <Field Class="mx-auto w-52">
        <FieldLabel For="dp-rtl">التاريخ</FieldLabel>
        <PopoverTrigger Target="dp-rtl-panel" id="dp-rtl" Variant="outline"
                        Class="w-full justify-between font-normal">
            <span data-date-label data-empty>اختر تاريخًا</span>
            <Icon Name="chevron-down" Class="opacity-50" />
        </PopoverTrigger>
        <PopoverContent Id="dp-rtl-panel" Align="start" Class="w-fit overflow-hidden p-0">
            <Calendar Name="rtl-day" Month="@Month" Today="@Today" Culture="@Arabic"
                      FirstDay="DayOfWeek.Saturday" Class="p-3" />
        </PopoverContent>
    </Field>
</div>

@code {
    static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);
    static readonly DateOnly Month = new(Today.Year, Today.Month, 1);
    static readonly System.Globalization.CultureInfo Arabic = new("ar-SA");
}
