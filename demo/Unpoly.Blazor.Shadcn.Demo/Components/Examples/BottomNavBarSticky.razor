@* StickyBottom pins the bar above the bottom edge of the window. The outer box stands in for the
   window here: a transformed ancestor is the containing block for anything fixed inside it, so
   the bar stays put while the feed scrolls underneath. In an application, leave the box out. *@
<div class="relative h-96 w-full max-w-sm overflow-hidden rounded-xl border bg-background" style="transform: translateZ(0)">
    <div class="h-full space-y-3 overflow-y-auto p-4 pb-24">
        @for (var i = 1; i <= 8; i++)
        {
            <div class="rounded-lg border bg-card p-4">
                <p class="text-sm font-medium">Post @i</p>
                <p class="text-sm text-muted-foreground">Scroll the feed — the bar stays where it is.</p>
            </div>
        }
    </div>
    <BottomNavBar Label="App" StickyBottom>
        <BottomNavBarItem Label="Home" Active><Icon Name="house" /></BottomNavBarItem>
        <BottomNavBarItem Label="Explore"><Icon Name="compass" /></BottomNavBarItem>
        <BottomNavBarItem Label="Messages"><Icon Name="message-circle" /></BottomNavBarItem>
        <BottomNavBarItem Label="Profile"><Icon Name="user" /></BottomNavBarItem>
    </BottomNavBar>
</div>
