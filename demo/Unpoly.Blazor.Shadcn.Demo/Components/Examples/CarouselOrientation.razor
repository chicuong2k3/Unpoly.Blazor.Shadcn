@* Vertical: the snap axis changes in CSS and the arrows move above and below. The compiler reads
   the orientation to know which scroll offset to nudge. *@
<div class="relative h-72 w-full max-w-xs py-12">
    <Carousel Orientation="vertical" AriaLabel="Vertical">
        <CarouselContent Orientation="vertical" Class="h-48">
            @foreach (var n in Enumerable.Range(1, 5))
            {
                <CarouselItem Orientation="vertical" Class="basis-1/2">
                    <Card class="m-1"><CardContent Class="flex h-20 items-center justify-center">
                        <span class="num text-xl font-semibold">@n</span>
                    </CardContent></Card>
                </CarouselItem>
            }
        </CarouselContent>
        <CarouselPrevious Orientation="vertical" />
        <CarouselNext Orientation="vertical" />
    </Carousel>
</div>
