@* The theme lives on <html> as data-theme, and dark mode as the .dark class shadcn expects.
   Both are read from localStorage by an inline script that runs BEFORE the body paints — a
   theme applied after first paint is a flash of the wrong one, and no amount of transition
   hides it. *@
<!DOCTYPE html>
<html lang="en">

<head>
    <UpChrome>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <base href="/" />

        <link rel="stylesheet" href="_content/Unpoly.Blazor.Shadcn/airdatepicker/air-datepicker.css" />
        @* A theme names its typefaces; loading them is the application's job, and this demo
           ships four themes that between them ask for five faces. Unloaded, each family falls
           back and the theme is the same palette in the wrong voice — which is exactly how these
           themes looked before. preconnect first, because the stylesheet and the font files come
           from two different hosts and the second round trip is the expensive one. *@
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Geist:wght@400;500;600&family=Geist+Mono&family=Inter:wght@400;500;600&family=JetBrains+Mono&family=Outfit:wght@400;500;600&display=swap" />

        <link rel="stylesheet" href="@($"app.css?v={Stamp}")" />
        <link rel="stylesheet" href="_content/Unpoly.Blazor.Shadcn/toastify/toastify.css" />
        <link rel="stylesheet" href="_content/Unpoly.Blazor.Shadcn/prism/prism.css" />
        <link rel="stylesheet" href="_content/Unpoly.Blazor.Shadcn/prism/prism-line-numbers.css" />
        <link rel="stylesheet" href="_content/Unpoly.Blazor.Shadcn/prism/prism-shadcn.css" />

        <script>
            // Inline and synchronous on purpose. Anything deferred paints the default theme first.
            (function () {
                var t = localStorage.getItem('demo-theme');
                if (t && t !== 'shadcn') document.documentElement.dataset.theme = t;
                if (localStorage.getItem('demo-dark') === '1') document.documentElement.classList.add('dark');
            })();
        </script>

        @* Prism, QRCode, ECharts are lazy-loaded by up.compiler inside ui.js / echarts.js
           only when a [data-slot="code-block"], [data-slot="qr-code"] or [data-echarts] is actually
           on the page. No request for those ~1.1MB on a landing page that ships no chart or code. *@
        <script src="_content/Unpoly.Blazor.Shadcn/airdatepicker/air-datepicker.js" defer></script>
        <script src="_content/Unpoly.Blazor.Shadcn/toastify/toastify.js" defer></script>
        <script src="@($"_content/Unpoly.Blazor.Shadcn/ui.js?v={Stamp}")" defer></script>
        <script src="@($"_content/Unpoly.Blazor.Shadcn.ECharts/echarts.js?v={Stamp}")" defer></script>
        <script src="@($"_content/Unpoly.Blazor.Shadcn.Maps/map/map.js?v={Stamp}")" defer></script>
        <script src="@($"demo.js?v={Stamp}")" defer></script>

        <UnpolyHead />
    </UpChrome>

    @* Outside UpChrome, or <PageTitle> stops working on a fragment response. *@
    <HeadOutlet />
</head>

<body>
    <Routes />
</body>

</html>

@code {
    // One value per build, so a bumped demo never runs on yesterday's stylesheet or script --
    // the "component is broken" reports that were actually a cached app.css were this.
    static readonly string Stamp =
        typeof(App).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];
}
