@* The sidebar, built out of the library: ItemGroup, Item and ScrollArea, not a list of bare
   anchors with hand-written classes.

   The component list is shadcn's own — upstream/doc-components.txt, fetched from its docs index
   and committed — in shadcn's own order, which is alphabetical with one page each. Someone who
   knows those docs can guess the URL here: /docs/components/alert-dialog becomes
    /components/alert-dialog. The check-pages .NET command fails the build if the two ever disagree.

   [up-nav] is what marks the current page — Unpoly compares each href with the address bar and
   adds .up-current. No active-route parameter, no state, and it keeps working after a fragment
   swap because the swap is what updates the address bar. *@

<ScrollArea Class="max-h-[calc(100dvh-5rem)] w-full shrink-0 overflow-y-auto py-4 pr-2 lg:h-[calc(100dvh-4rem)] lg:w-56 lg:py-6" up-nav>
    <ItemGroup Class="mb-4">
        <ItemHeader Class="px-3 py-1">
            <ItemTitle Class="text-xs font-semibold tracking-wide uppercase opacity-60">
                Getting started
            </ItemTitle>
        </ItemHeader>
        @foreach (var (label, href) in Start)
        {
            <Item Href="@href" Size="sm" Class="doc-nav-item rounded-md px-3 py-1.5">
                <ItemContent><ItemTitle Class="text-sm font-normal">@label</ItemTitle></ItemContent>
            </Item>
        }
    </ItemGroup>

    <ItemGroup Class="mb-4">
        <ItemHeader Class="px-3 py-1">
            <ItemTitle Class="text-xs font-semibold tracking-wide uppercase opacity-60">
                Components
            </ItemTitle>
        </ItemHeader>
        @foreach (var (label, href) in Components)
        {
            <Item Href="@href" Size="sm" Class="doc-nav-item rounded-md px-3 py-1.5">
                <ItemContent><ItemTitle Class="text-sm font-normal">@label</ItemTitle></ItemContent>
            </Item>
        }
    </ItemGroup>

    <ItemGroup Class="mb-4">
        <ItemHeader Class="px-3 py-1">
            <ItemTitle Class="text-xs font-semibold tracking-wide uppercase opacity-60">
                Beyond shadcn
            </ItemTitle>
        </ItemHeader>
        @foreach (var (label, href) in Extra)
        {
            <Item Href="@href" Size="sm" Class="doc-nav-item rounded-md px-3 py-1.5">
                <ItemContent><ItemTitle Class="text-sm font-normal">@label</ItemTitle></ItemContent>
            </Item>
        }
    </ItemGroup>
</ScrollArea>

@code {
