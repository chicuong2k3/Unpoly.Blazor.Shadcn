@inherits LayoutComponentBase

@* The whole chrome is the library: Item and ScrollArea for the nav, Command for the search,
   Sheet for the Customizer, Tabs and CodeBlock for every example, Button, Badge, Kbd and
   Separator for the header.

   That is the point rather than a flourish. A component library whose own documentation is built
   from hand-rolled markup has not shown that its components are enough to build anything — it has
   shown the opposite, and hand-rolled chrome is exactly where the gaps hide. Writing this page is
   what surfaced the need for CodeBlock.

   The header and nav sit in <UpChrome>: on a fragment request neither is rendered, so moving
   between pages costs one .doc-main swap and the sidebar keeps its scroll. Provides names what
   the chrome contains that anything might target from outside. *@

<UpChrome Provides=".doc-nav, .doc-header">
    <header class="doc-header sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-[1400px] items-center gap-4 px-6">
            <a href="/" class="min-w-0 truncate font-semibold tracking-tight" up-target="body">
                Unpoly.Blazor.Shadcn
            </a>
            <Badge Variant="secondary" Class="hidden sm:inline-flex">shadcn/ui for Blazor SSR</Badge>

            <div class="ml-auto flex min-w-0 shrink-0 items-center gap-2">
                <DocSearch />

                <Separator Orientation="vertical" Class="hidden mx-1 h-6 sm:block" />

                <Select data-theme-picker aria-label="Theme" Class="flex w-[130px] sm:w-[180px]">
                    <SelectItem Value="shadcn">shadcn</SelectItem>
                    <SelectItem Value="vercel">Vercel</SelectItem>
                    <SelectItem Value="supabase">Supabase</SelectItem>
                    <SelectItem Value="modern-minimal">Modern Minimal</SelectItem>
                    <SelectItem Value="notebook">Notebook</SelectItem>
                    <SelectItem Value="catppuccin">Catppuccin</SelectItem>
                    <SelectItem Value="claymorphism">Claymorphism</SelectItem>
                    <SelectItem Value="amethyst-haze">Amethyst Haze</SelectItem>
                    <SelectItem Value="ocean-breeze">Ocean Breeze</SelectItem>
                    <SelectItem Value="tangerine">Tangerine</SelectItem>
                    <SelectItem Value="bubblegum">Bubblegum</SelectItem>
                    <SelectItem Value="perpetuity">Perpetuity</SelectItem>
                    <SelectItem Value="t3-chat">T3 Chat</SelectItem>
                    <SelectItem Value="stripe">★ Stripe</SelectItem>
                    <SelectItem Value="apple">★ Apple</SelectItem>
                    <SelectItem Value="airbnb">★ Airbnb</SelectItem>
                    <SelectItem Value="claude">★ Claude</SelectItem>
                    <SelectItem Value="cursor">Cursor</SelectItem>
                    <SelectItem Value="duolingo">Duolingo</SelectItem>
                    <SelectItem Value="ease-health">Ease Health</SelectItem>
                    <SelectItem Value="elevenlabs">ElevenLabs</SelectItem>
                    <SelectItem Value="fly">Fly.io</SelectItem>
                    <SelectItem Value="linear">Linear</SelectItem>
                    <SelectItem Value="raycast">Raycast</SelectItem>
                    <SelectItem Value="resend">Resend</SelectItem>
                    <SelectItem Value="superhuman">Superhuman</SelectItem>
                    <SelectItem Value="todoist">Todoist</SelectItem>
                    <SelectItem Value="wise">Wise</SelectItem>
                    <SelectItem Value="wiz">Wiz</SelectItem>
                    <SelectItem Value="amber-minimal">Amber Minimal</SelectItem>
                    <SelectItem Value="bold-tech">Bold Tech</SelectItem>
                    <SelectItem Value="clean-slate">Clean Slate</SelectItem>
                    <SelectItem Value="cosmic-night">Cosmic Night</SelectItem>
                    <SelectItem Value="elegant-luxury">Elegant Luxury</SelectItem>
                    <SelectItem Value="kodama-grove">Kodama Grove</SelectItem>
                    <SelectItem Value="midnight-bloom">Midnight Bloom</SelectItem>
                    <SelectItem Value="mocha-mousse">Mocha Mousse</SelectItem>
                    <SelectItem Value="neo-brutalism">Neo Brutalism</SelectItem>
                    <SelectItem Value="northern-lights">Northern Lights</SelectItem>
                    <SelectItem Value="pastel-dreams">Pastel Dreams</SelectItem>
                    <SelectItem Value="quantum-rose">Quantum Rose</SelectItem>
                    <SelectItem Value="retro-arcade">Retro Arcade</SelectItem>
                    <SelectItem Value="sage-garden">Sage Garden</SelectItem>
                    <SelectItem Value="soft-pop">Soft Pop</SelectItem>
                    <SelectItem Value="solar-dusk">Solar Dusk</SelectItem>
                    <SelectItem Value="starry-night">Starry Night</SelectItem>
                    <SelectItem Value="sunset-horizon">Sunset Horizon</SelectItem>
                    <SelectItem Value="vintage-paper">Vintage Paper</SelectItem>
                    <SelectItem Value="violet-bloom">Violet Bloom</SelectItem>
                    <SelectItem Value="github-dark">GitHub Dark</SelectItem>
                    <SelectItem Value="github-light">GitHub Light</SelectItem>
                    <SelectItem Value="discord">Discord</SelectItem>
                    <SelectItem Value="dracula">Dracula</SelectItem>
                    <SelectItem Value="nord">Nord</SelectItem>
                    <SelectItem Value="spotify">Spotify</SelectItem>
                    <SelectItem Value="slack">Slack</SelectItem>
                    <SelectItem Value="notion">Notion</SelectItem>
                    <SelectItem Value="cupertino">Cupertino</SelectItem>
                    <SelectItem Value="fluent">Fluent 2</SelectItem>
                </Select>

                <DocCustomizer />

                <Button Variant="ghost" Size="icon" Type="button" data-dark-toggle
                        aria-label="Toggle dark mode">
                    <Icon Name="eye" />
                </Button>

                <Button Variant="outline" Size="icon" Class="hidden sm:inline-flex"
                        Href="https://github.com/chicuong2k3/Unpoly.Blazor.Shadcn"
                        up-follow="false" aria-label="Source on GitHub">
                    <Icon Name="external-link" />
                </Button>
            </div>
        </div>
    </header>
</UpChrome>

<div class="mx-auto flex max-w-[1400px] flex-col gap-8 px-6 lg:flex-row">
    <UpChrome>
        @* Sticky under the header, which is 4rem tall and sticky itself. Without this the nav
           scrolled away with the page and a reader three screens into a component page had no
           way back to the list without scrolling all the way up — shadcn's own docs pin it. *@
        <div class="doc-nav top-16 block w-full lg:sticky lg:h-[calc(100dvh-4rem)] lg:w-auto">
            <DocNav />
        </div>
    </UpChrome>

    <main class="doc-main min-w-0 flex-1 py-8">@Body</main>
</div>
