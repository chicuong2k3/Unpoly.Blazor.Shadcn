<h2 class="doc-h2">SidebarTrigger</h2>
<p class="doc-note">
    The trigger ships hidden and <code>ui.js</code> reveals it: with no JavaScript there is nothing
    to toggle, and a button that does nothing is worse than one that is absent — the sidebar stays
    open and every link in it is still there. <code>SidebarRail</code> is the other way to do it.
</p>
<Example Source="SidebarTriggerExample.razor"><SidebarTriggerExample /></Example>

<h2 class="doc-h2">Controlled Sidebar</h2>
<p class="doc-note">
    The state is already outside the component, so "controlled" means passing <code>Open</code>
    yourself instead of reading the cookie. Both the provider and the panel take it, because Razor
    has no context for one to read it from the other.
</p>
<Example Source="SidebarControlled.razor"><SidebarControlled /></Example>

<h2 class="doc-h2">Theming</h2>
<p class="doc-note">
    The sidebar has its own eight tokens, separate from the page's, so a dark rail beside a light
    page needs no overrides — set them on <code>:root</code> and every part follows.
</p>
<CodeBlock Language="css" Title="Sidebar tokens" Class="mt-4 max-w-2xl" Code="@Tokens" />

<h2 class="doc-h2">RTL</h2>
<p class="doc-note">
    <code>Side="right"</code> and <code>dir="rtl"</code> are two different things and a mirrored
    layout needs both: the panel moves because that is where a sidebar goes in a right-to-left
    page, and the rows mirror because the text does.
</p>
<Example Source="SidebarRtl.razor"><SidebarRtl /></Example>

@code {
    const string Composition = """
        SidebarProvider
        ├── Sidebar
        │   ├── SidebarHeader
        │   ├── SidebarContent
        │   │   ├── SidebarGroup
        │   │   │   ├── SidebarGroupLabel
        │   │   │   ├── SidebarGroupAction
        │   │   │   ├── SidebarGroupContent
        │   │   │   └── SidebarMenu
        │   │   │       ├── SidebarMenuItem
        │   │   │       │   ├── SidebarMenuButton
        │   │   │       │   ├── SidebarMenuAction
        │   │   │       │   └── SidebarMenuBadge
        │   │   │       └── SidebarMenuItem
        │   │   │           ├── SidebarMenuButton
        │   │   │           └── SidebarMenuSub
        │   │   │               ├── SidebarMenuSubItem
        │   │   │               └── SidebarMenuSubItem
        │   │   └── SidebarGroup
        │   │       └── SidebarMenu
        │   │           ├── SidebarMenuItem
        │   │           └── SidebarMenuItem
        │   ├── SidebarFooter
        │   └── SidebarRail
        ├── SidebarInset
        └── SidebarTrigger
        """;

    const string Widths = """
        <SidebarProvider Width="20rem" IconWidth="4rem">
            <Sidebar Collapsible="icon">…</Sidebar>
        </SidebarProvider>
        """;

    const string Structure = """
        <SidebarProvider>
            <Sidebar Collapsible="icon">
                <SidebarHeader>…</SidebarHeader>
                <SidebarContent>
                    <SidebarGroup>
                        <SidebarGroupLabel>Platform</SidebarGroupLabel>
                        <SidebarGroupContent>
                            <SidebarMenu>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="/inbox">Inbox</SidebarMenuButton>
                                </SidebarMenuItem>
                            </SidebarMenu>
                        </SidebarGroupContent>
                    </SidebarGroup>
                </SidebarContent>
                <SidebarFooter>…</SidebarFooter>
                <SidebarRail />
            </Sidebar>
            <SidebarInset>@Body</SidebarInset>
        </SidebarProvider>
        """;

    const string Reading = """
        @* The cascading HttpContext every Unpoly.Blazor page already has. *@
        <SidebarProvider Open="@(Ctx.Request.Cookies["sidebar_state"] != "false")">
            <Sidebar Collapsible="icon" Open="@(Ctx.Request.Cookies["sidebar_state"] != "false")">…</Sidebar>
            <SidebarInset>@Body</SidebarInset>
        </SidebarProvider>
        """;

    const string Tokens = """
        :root {
          --sidebar: oklch(0.985 0 0);
          --sidebar-foreground: oklch(0.145 0 0);
          --sidebar-primary: oklch(0.205 0 0);
          --sidebar-primary-foreground: oklch(0.985 0 0);
          --sidebar-accent: oklch(0.97 0 0);
          --sidebar-accent-foreground: oklch(0.205 0 0);
          --sidebar-border: oklch(0.922 0 0);
          --sidebar-ring: oklch(0.708 0 0);
        }
        """;
}
