@page "/components/steps"

<PageTitle>Steps — Unpoly.Blazor.Shadcn</PageTitle>

<h1 class="doc-h1">Steps</h1>
<p class="doc-lede">Multi-step workflow tracker, Lumeo parity. Pure CSS + Blazor state, no JS library.</p>

<h2 class="doc-h2">Basic</h2>
<Steps CurrentStep="1">
    <StepsItem Title="Account" Description="Create your account" />
    <StepsItem Title="Profile" Description="Set up your profile" />
    <StepsItem Title="Complete" Description="All done" />
</Steps>

<h2 class="doc-h2">Clickable</h2>
<Steps CurrentStep="@step" CurrentStepChanged="v => step = v" Clickable>
    <StepsItem Title="Details" />
    <StepsItem Title="Payment" />
    <StepsItem Title="Review" />
    <StepsItem Title="Confirm" />
</Steps>
<div class="mt-2 flex gap-2">
    <Button Variant="outline" Size="sm" @onclick="() => step = Math.Max(0, step-1)">Previous</Button>
    <Button Variant="outline" Size="sm" @onclick="() => step = Math.Min(3, step+1)">Next</Button>
    <span class="text-sm text-muted-foreground">Current: @step</span>
</div>

<h2 class="doc-h2">Vertical + Error</h2>
<Steps Orientation="Vertical" CurrentStep="1">
    <StepsItem Title="Sign Up" Description="Create an account" />
    <StepsItem Title="Verify Email" Description="Confirm your email" Status="StepsItemStatus.Error" />
    <StepsItem Title="Set Password" Description="Choose a secure password" />
</Steps>

@code { int step = 0; }
