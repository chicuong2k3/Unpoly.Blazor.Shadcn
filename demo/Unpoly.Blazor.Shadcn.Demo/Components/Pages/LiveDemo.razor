@page "/live-demo"

<PageTitle>Live Demo — Unpoly.Blazor.Shadcn</PageTitle>

<Breadcrumb>
    <BreadcrumbList>
        <BreadcrumbItem>
            <BreadcrumbLink Href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
            <BreadcrumbPage>Live Demo</BreadcrumbPage>
        </BreadcrumbItem>
    </BreadcrumbList>
</Breadcrumb>

@* Dashboard Analytics tối: panel .dark để token sang palette tối.
   Sparkline là SVG inline — số liệu tĩnh thì không cần lôi chart lib vào. *@
<div class="dark mt-4 overflow-hidden rounded-3xl bg-[#0a0a0b] px-6 py-6 text-white sm:px-8">
    <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
            <span class="flex size-7 items-center justify-center rounded-lg bg-white text-sm font-bold text-black">A</span>
            <span class="text-sm font-semibold">Aster Insights</span>
        </div>
        <nav class="flex items-center gap-1.5 text-xs text-white/45">
            <a href="/live-demo" class="transition hover:text-white">Aster Cloud</a>
            <span>/</span>
            <span class="text-white/80">Segment Builder</span>
        </nav>
        <div class="ml-auto flex items-center gap-2">
            <Button Variant="outline" Size="sm" Class="rounded-lg border-white/15 bg-transparent text-white">
                <Icon Name="share-2" Title="Share" /> Share
            </Button>
            <Button Variant="outline" Size="sm" Class="rounded-lg border-white/15 bg-transparent text-white">
                <Icon Name="hammer" Title="Build" /> Build
            </Button>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/[0.04] px-2.5 py-1.5 text-xs text-white/80">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>SEQ-307 activation
            </span>
        </div>
    </div>

    <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.02] p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="text-base font-semibold tracking-tight">Segment Health</h1>
                <p class="mt-0.5 text-xs text-white/50">47 Sources · 3 Conflicts</p>
            </div>
            <div class="flex items-center gap-1 rounded-lg border border-white/10 bg-white/[0.03] p-0.5 text-xs">
                <button type="button" class="rounded-md bg-white/10 px-2.5 py-1 font-medium text-white">Week</button>
                <button type="button" class="rounded-md px-2.5 py-1 text-white/55 transition hover:text-white">Month</button>
                <button type="button" class="rounded-md px-2.5 py-1 text-white/55 transition hover:text-white">Year</button>
            </div>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="flex items-center gap-1.5 text-xs text-white/50"><Icon Name="check-check" Title="Matched" Class="size-3.5" /> Matched</p>
                    <p class="mt-1 text-2xl font-semibold tracking-tight">488k</p>
                    <p class="text-xs text-white/45">+12% this week</p>
                </div>
                <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="h-8 w-24 text-white/40" aria-hidden="true">
                    <polyline points="0,24 12,20 24,22 36,14 48,16 60,10 72,12 84,6 100,8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="flex items-center gap-1.5 text-xs text-white/50"><Icon Name="git-fork" Title="Conflicts" Class="size-3.5" /> Conflicts</p>
                    <p class="mt-1 text-2xl font-semibold tracking-tight">12</p>
                    <p class="text-xs text-rose-300">-2.4% fewer</p>
                </div>
                <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="h-8 w-24 text-white/40" aria-hidden="true">
                    <polyline points="0,10 12,14 24,12 36,20 48,18 60,24 72,22 84,26 100,24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="flex items-center gap-1.5 text-xs text-white/50"><Icon Name="layers" Title="Cohorts" Class="size-3.5" /> Cohorts</p>
                    <p class="mt-1 text-2xl font-semibold tracking-tight">8</p>
                    <p class="text-xs text-white/45">0% spread</p>
                </div>
                <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="h-8 w-24 text-white/40" aria-hidden="true">
                    <polyline points="0,20 12,18 24,20 36,18 48,20 60,18 72,20 84,18 100,20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="flex items-center gap-1.5 text-xs text-white/50"><Icon Name="bell" Title="Alerts" Class="size-3.5" /> Alerts</p>
                    <p class="mt-1 text-2xl font-semibold tracking-tight">3</p>
                    <p class="text-xs text-amber-300">Pending</p>
                </div>
                <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="h-8 w-24 text-white/40" aria-hidden="true">
                    <polyline points="0,26 12,24 24,26 36,18 48,20 60,12 72,14 84,8 100,10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-white/10 pt-4 text-xs">
            <p class="text-white/50">488K events validated · 3 alert rules need review</p>
            <a href="/live-demo" class="flex items-center gap-1 text-white/70 transition hover:text-white">
                Open Report <Icon Name="chevron-right" Title="Open" Class="size-3.5" />
            </a>
        </div>
    </div>

    <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.02] p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 class="text-base font-semibold tracking-tight">Segment Validation Reviews</h2>
                <p class="mt-0.5 text-xs text-white/50">6 in review · Jun 10</p>
            </div>
            <div class="flex items-center gap-2">
                <Select name="reviewer">
                    <SelectItem Value="all">All reviewers</SelectItem>
                    <SelectItem Value="mina">Mina Stone</SelectItem>
                    <SelectItem Value="leo">Leo Grant</SelectItem>
                </Select>
                <Button Variant="default" Size="sm" Class="rounded-lg">Review</Button>
            </div>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-5">
            <div class="rounded-xl border border-white/10 bg-white/[0.02] p-3 lg:col-span-2">
                <div class="flex items-center justify-between px-1 text-xs text-white/55">
                    <button type="button" aria-label="Previous month" class="transition hover:text-white"><Icon Name="chevron-left" Title="Previous" Class="size-3.5" /></button>
                    <span class="font-medium text-white/80">June 2026</span>
                    <button type="button" aria-label="Next month" class="transition hover:text-white"><Icon Name="chevron-right" Title="Next" Class="size-3.5" /></button>
                </div>
                <div class="mt-2 grid grid-cols-7 text-center text-[11px] text-white/40">
                    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                </div>
                <div class="mt-1 grid grid-cols-7 gap-y-1 text-center text-xs">
                    <span class="py-1 text-white/25">31</span>
                    <span class="py-1 text-white/80">1</span><span class="py-1 text-white/80">2</span><span class="py-1 text-white/80">3</span><span class="py-1 text-white/80">4</span><span class="py-1 text-white/80">5</span><span class="py-1 text-white/80">6</span>
                    <span class="py-1 text-white/80">7</span><span class="py-1 text-white/80">8</span><span class="py-1 text-white/80">9</span><span class="rounded-md bg-white py-1 font-semibold text-black">10</span><span class="py-1 text-white/80">11</span><span class="py-1 text-white/80">12</span><span class="py-1 text-white/80">13</span>
                    <span class="py-1 text-white/80">14</span><span class="py-1 text-white/80">15</span><span class="py-1 text-white/80">16</span><span class="py-1 text-white/80">17</span><span class="py-1 text-white/80">18</span><span class="py-1 text-white/80">19</span><span class="py-1 text-white/80">20</span>
                    <span class="py-1 text-white/80">21</span><span class="py-1 text-white/80">22</span><span class="py-1 text-white/80">23</span><span class="py-1 text-white/80">24</span><span class="py-1 text-white/80">25</span><span class="py-1 text-white/80">26</span><span class="py-1 text-white/80">27</span>
                    <span class="py-1 text-white/80">28</span><span class="py-1 text-white/80">29</span><span class="py-1 text-white/80">30</span><span class="py-1 text-white/25">1</span><span class="py-1 text-white/25">2</span><span class="py-1 text-white/25">3</span><span class="py-1 text-white/25">4</span>
                </div>
            </div>

            <div class="flex flex-col gap-2 lg:col-span-3">
                <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">SEQ-307 Activation Review</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
                            <span class="rounded bg-sky-400/15 px-1.5 py-0.5 font-medium text-sky-300">Upcoming</span>
                            <span class="flex -space-x-1.5">
                                <Avatar Size="sm"><AvatarFallback Class="bg-violet-100 text-violet-700">MS</AvatarFallback></Avatar>
                                <Avatar Size="sm"><AvatarFallback Class="bg-sky-100 text-sky-700">LG</AvatarFallback></Avatar>
                            </span>
                            <span>Jun 10 · 9:00 am</span>
                            <span class="flex items-center gap-1"><Icon Name="map-pin" Title="Where" Class="size-3" /> Insights Room</span>
                        </span>
                    </span>
                    <span class="text-white/35"><Icon Name="calendar-check" Title="Review" Class="size-4" /></span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">CON-071 Cohort Replay</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
                            <span class="rounded bg-amber-400/15 px-1.5 py-0.5 font-medium text-amber-300">Pending</span>
                            <span>Jun 10 · 11:30 am</span>
                            <span class="flex items-center gap-1"><Icon Name="video" Title="Where" Class="size-3" /> Google Meet</span>
                        </span>
                    </span>
                    <span class="text-white/35"><Icon Name="history" Title="Replay" Class="size-4" /></span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">EXP-224 Checklist QA</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
                            <span class="rounded bg-sky-400/15 px-1.5 py-0.5 font-medium text-sky-300">Upcoming</span>
                            <span>Jun 10 · 2:00 pm</span>
                            <span class="flex items-center gap-1"><Icon Name="map-pin" Title="Where" Class="size-3" /> Remote</span>
                        </span>
                    </span>
                    <span class="text-white/35"><Icon Name="list-checks" Title="Checklist" Class="size-4" /></span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">SEQ-307 Holdout Check</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
                            <span class="rounded bg-sky-400/15 px-1.5 py-0.5 font-medium text-sky-300">Upcoming</span>
                            <span class="flex -space-x-1.5">
                                <Avatar Size="sm"><AvatarFallback Class="bg-emerald-100 text-emerald-700">NV</AvatarFallback></Avatar>
                            </span>
                            <span>Jun 11 · 9:30 am</span>
                            <span class="flex items-center gap-1"><Icon Name="map-pin" Title="Where" Class="size-3" /> Insights Room</span>
                        </span>
                    </span>
                    <span class="text-white/35"><Icon Name="pause" Title="Holdout" Class="size-4" /></span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium">COH-954 Retention Gate</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/50">
                            <span class="rounded bg-amber-400/15 px-1.5 py-0.5 font-medium text-amber-300">Pending</span>
                            <span>Jun 12 · 4:15 pm</span>
                            <span class="flex items-center gap-1"><Icon Name="video" Title="Where" Class="size-3" /> Google Meet</span>
                        </span>
                    </span>
                    <span class="text-white/35"><Icon Name="door-open" Title="Gate" Class="size-4" /></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4 text-xs text-white/45">
        <span>Analytics</span>
        <span>9 blocks</span>
    </div>
</div>

<p class="doc-note">
    Dịch từ ảnh: topbar Aster, Segment Health 4 chỉ số + sparkline SVG inline,
    lịch tháng 6/2026 chọn ngày 10, 5 review items đúng pill/avatar/giờ/địa điểm.
</p>
