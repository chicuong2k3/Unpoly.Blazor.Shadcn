@* An example is the rendered component and the source that produced it, on two tabs.

   The source is READ FROM THE FILE that was just rendered, not retyped beside it. Docs that carry
   a copy of their own code start lying the first time someone edits one half, and this library
   exists partly to make that impossible — it would be a poor showing to reintroduce it here.

   Every part of this is a component from the library: Tabs, Card and CodeBlock. That is not
   decoration. A component library whose own documentation is built out of hand-rolled markup has
   not shown that the components are enough to build anything — it has shown the opposite. *@

<Tabs Value="preview" Class="mt-4">
    <div class="flex items-center justify-between gap-4">
        <TabsList>
            <TabsTrigger Value="preview">Preview</TabsTrigger>
            <TabsTrigger Value="code">Code</TabsTrigger>
        </TabsList>
        <span class="font-mono text-xs text-muted-foreground">@Source</span>
    </div>

    <TabsContent Value="preview">
        <Card Class="border border-dashed">
            <CardContent Class="flex flex-wrap items-start gap-4 px-6">@ChildContent</CardContent>
        </Card>
    </TabsContent>

    <TabsContent Value="code" Hidden>
        <CodeBlock Code="@SourceText" Language="razor" Title="@Source" />
    </TabsContent>
</Tabs>

@code {
    /// <summary>File name of the sample, e.g. "ButtonVariants.razor".</summary>
    [Parameter, EditorRequired] public string Source { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    string SourceText = "";

    protected override void OnParametersSet()
    {
        var path = Path.Combine(AppContext.BaseDirectory, "samples", Source);
        SourceText = File.Exists(path)
            ? Trim(File.ReadAllText(path))
            : $"(sample not found: samples/{Source} — is it under Components/Examples?)";
    }

    /// <summary>
    /// Drops the leading `@inherits`/`@using` lines and the trailing @@code block: a reader wants
    /// the markup, and the plumbing above it is noise they would skip past every time.
    /// </summary>
    static string Trim(string text)
    {
        var lines = text.Replace("\r\n", "\n").Split('\n').ToList();
        while (lines.Count > 0 && (lines[0].StartsWith('@') || lines[0].Length == 0))
            lines.RemoveAt(0);

        var code = lines.FindIndex(l => l.StartsWith("@code"));
        if (code >= 0) lines = lines[..code];

        return string.Join('\n', lines).Trim();
    }
}
