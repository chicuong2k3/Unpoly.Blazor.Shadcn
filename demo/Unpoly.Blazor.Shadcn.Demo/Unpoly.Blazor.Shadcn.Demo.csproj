<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- RZ10012 is "that element is not a component I know about", and it is the only thing that
         notices an example referring to a component this library does not actually have: Razor
         emits the unknown tag as literal markup, the page renders, the demo looks fine, and the
         component was never there. It shipped that way once. RZ2012 is a required parameter left
         unset, which for DropdownMenuContent means a popover with no id and a trigger pointing at
         nothing. Both are errors here because both are silent in the browser. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012;RZ2012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Unpoly.Blazor" Version="0.1.0" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn/Unpoly.Blazor.Shadcn.csproj" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.ECharts/Unpoly.Blazor.Shadcn.ECharts.csproj" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.Maps/Unpoly.Blazor.Shadcn.Maps.csproj" />
  </ItemGroup>

  <!-- Every example is rendered AND shown as source, from the same file. Copying the .razor
       files to the output is what makes those two the same thing rather than two things that
       drift: <Example> reads the file it just rendered. -->
  <!-- A plain Copy rather than item metadata: .razor files are already Content items owned by
       the Razor SDK, and re-declaring them to add CopyToOutputDirectory either duplicates the
       item or takes them out of compilation. Copying after the build touches neither. -->
  <Target Name="CopySamples" AfterTargets="Build">
    <ItemGroup>
      <SampleFile Include="Components/Examples/**/*.razor;Components/Blocks/**/*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleFile)" DestinationFolder="$(OutDir)samples" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="Tailwind"
          Condition="!Exists('node_modules') And '$(SkipTailwind)' != 'true'">
    <Exec Command="npm install" />
  </Target>

  <Target Name="Tailwind" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true'">
    <Exec Command="npm run css" />
  </Target>

</Project>
