<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- RZ10012 is "that element is not a component I know about", and it is the only thing that
         notices an example referring to a component this library does not actually have: Razor
         emits the unknown tag as literal markup, the page renders, the demo looks fine, and the
         component was never there. It shipped that way once. RZ2012 is a required parameter left
         unset, which for DropdownMenuContent means a popover with no id and a trigger pointing at
         nothing. Both are errors here because both are silent in the browser. -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012;RZ2012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Unpoly.Blazor" Version="0.1.0" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn/Unpoly.Blazor.Shadcn.csproj" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.ECharts/Unpoly.Blazor.Shadcn.ECharts.csproj" />
    <ProjectReference Include="../../src/Unpoly.Blazor.Shadcn.Maps/Unpoly.Blazor.Shadcn.Maps.csproj" />
  </ItemGroup>

  <!-- Every example is rendered AND shown as source, from the same file. Copying the .razor
       files to the output is what makes those two the same thing rather than two things that
       drift: <Example> reads the file it just rendered. -->
  <!-- A plain Copy rather than item metadata: .razor files are already Content items owned by
       the Razor SDK, and re-declaring them to add CopyToOutputDirectory either duplicates the
       item or takes them out of compilation. Copying after the build touches neither. -->
  <Target Name="CopySamples" AfterTargets="Build">
    <ItemGroup>
      <SampleFile Include="Components/Examples/**/*.razor;Components/Blocks/**/*.razor" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleFile)" DestinationFolder="$(OutDir)samples" SkipUnchangedFiles="true" />
    <!-- dotnet publish does not carry loose OutDir files, so without this second
         copy every code tab reads "sample not found" in production while working
         locally. PublishDir is empty on a plain build, so the condition keeps
         `dotnet build` to a single copy. -->
    <Copy SourceFiles="@(SampleFile)"
          DestinationFolder="$([System.IO.Path]::Combine('$(PublishDir)', 'samples'))"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- Build the v3 stylesheet for the demo by default; v4 remains available for rollback. -->
  <PropertyGroup>
    <Tailwind3Preview Condition="'$(Tailwind3Preview)' == ''">true</Tailwind3Preview>
  </PropertyGroup>
  <Target Name="RequireTailwind3DemoCss" BeforeTargets="PrepareForBuild" Condition="'$(Tailwind3Preview)' != 'true'">
    <Error Text="The demo host links app.v3.css by default; Tailwind3Preview=false would create a broken build. Use ?demo-css=v4 for runtime comparison." />
  </Target>
  <Target Name="RemoveTailwind3Preview" BeforeTargets="PrepareForBuild"
          Condition="'$(Tailwind3Preview)' != 'true'">
    <!-- Switching back to v4 must not leave a stale opt-in asset in an
         incremental build output (especially after a preview publish). -->
    <Delete Files="wwwroot/app.v3.css;$(OutDir)wwwroot/app.v3.css;wwwroot/container-fallback.v3.js;$(OutDir)wwwroot/container-fallback.v3.js" />
  </Target>
  <ItemGroup Condition="'$(Tailwind3Preview)' != 'true'">
    <Content Remove="wwwroot/app.v3.css;wwwroot/container-fallback.v3.js" />
  </ItemGroup>
  <!-- Include before SDK static-asset evaluation; target-time Include is too late
       for Web's endpoint manifest on a fresh profile. -->
  <ItemGroup Condition="'$(Tailwind3Preview)' == 'true'">
    <Content Include="wwwroot/app.v3.css" Condition="!Exists('wwwroot/app.v3.css')" />
    <Content Include="wwwroot/container-fallback.v3.js" Condition="!Exists('wwwroot/container-fallback.v3.js')" />
  </ItemGroup>
  <Target Name="Tailwind3PreviewBuild" BeforeTargets="PrepareForBuild"
          DependsOnTargets="NpmInstall" Condition="'$(Tailwind3Preview)' == 'true'">
    <Exec Command="node ../../tools/build-tailwind3-probe.cjs --preview web" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="Tailwind"
          Condition="'$(SkipTailwind)' != 'true'">
    <Exec Command="npm ci" Condition="!Exists('node_modules')" />
    <!-- The postprocessor resolves modules relative to tools/, not to the demo cwd. -->
    <Exec Command="npm ci --prefix ../../tools" Condition="!Exists('../../tools/node_modules')" />
  </Target>

  <!-- Hot reload: khi `dotnet watch` chạy, Tailwind do `npm run css:watch` lo ở terminal
       riêng. Chạy lại Tailwind trong mỗi lần watch build vừa chậm vừa giật preview,
       nên target này nghỉ dưới watch. `DotNetWatchBuild` là property watch truyền cho
       mọi build nó kích hoạt; `DOTNET_WATCH` là env var watch đặt cho tiến trình con,
       giữ lại làm dự phòng. Build/publish thường vẫn chạy. -->
  <Target Name="Tailwind" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true' And '$(DotNetWatchBuild)' != 'true' And '$(DOTNET_WATCH)' != '1'">
    <Exec Command="npm run css" />
  </Target>

</Project>
