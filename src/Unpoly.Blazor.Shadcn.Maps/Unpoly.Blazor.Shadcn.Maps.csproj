<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Unpoly.Blazor.Shadcn.Maps</RootNamespace>
    <AssemblyName>Unpoly.Blazor.Shadcn.Maps</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Description>Maps for Unpoly.Blazor.Shadcn — MapLibre GL geographic maps for Blazor static SSR with Unpoly. Separated so apps without maps never fetch MapLibre.</Description>
    <PackageTags>blazor;shadcn;map;maplibre;unpoly;ssr;tailwind</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/chicuong2k3/Unpoly.Blazor.Shadcn</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unpoly.Blazor.Shadcn/Unpoly.Blazor.Shadcn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
