@inherits UiComponentBase

@* Renders an <a> when given an Href, which is the usual case: a hover card previews the thing a
   link points at, and the link has to work whether or not anyone hovers. *@

@if (Href is not null)
{
    <a href="@Href" data-slot="hover-card-trigger" data-target="@Target" data-delay="@Delay"
       class="@Class" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button type="button" data-slot="hover-card-trigger" data-target="@Target" data-delay="@Delay"
            class="@Class" @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter, EditorRequired] public string Target { get; set; } = default!;
    [Parameter] public string? Href { get; set; }

    /// <summary>Milliseconds of hover before it opens. Focus opens it after the same delay.</summary>
    [Parameter] public int Delay { get; set; } = 600;
}
