@inherits UiComponentBase
<div data-slot="media-timeline" data-duration="@F(Duration)" data-snap="@F(Snap)" class="@Class" role="group" aria-label="@Label" @attributes="AdditionalAttributes">
    <div data-timeline-viewport tabindex="0" role="region" aria-label="Timeline tracks">
        <div data-timeline-surface>
    <div data-timeline-ruler aria-hidden="true">
        @for (var tick = 0; tick <= 5; tick++) { <span>@F(Math.Round(Duration * tick / 5, 2))s</span> }
    </div>
    @foreach (var clip in Clips)
    {
        <div data-media-clip="@clip.Id" data-start="@F(clip.Start)" data-length="@F(clip.Duration)" data-track="@clip.Track" @key="clip.Id">
            <Button Type="button" Variant="ghost" Size="icon" data-clip-start aria-label="@($"Trim start of {clip.Label}")" title="Trim start"><Icon Name="grip-vertical" /></Button>
            <Button Type="button" Variant="ghost" data-clip-move aria-label="@($"Move {clip.Label}")">@clip.Label</Button>
            <Button Type="button" Variant="ghost" Size="icon" data-clip-end aria-label="@($"Trim end of {clip.Label}")" title="Trim end"><Icon Name="grip-vertical" /></Button>
            <span data-clip-meta aria-hidden="true">@($"Track {clip.Track + 1} · {F(clip.Duration)}s")</span>
        </div>
    }
        </div>
    </div>
    <p data-timeline-hint>Scroll horizontally to see the full timeline.</p>
    <span data-media-feedback role="status" aria-atomic="true"></span>
    @ChildContent
</div>
@code {
    [Parameter] public IReadOnlyList<MediaClip> Clips { get; set; } = Array.Empty<MediaClip>();
    [Parameter] public double Duration { get; set; } = 60;
    [Parameter] public double Snap { get; set; } = .1;
    [Parameter] public string Label { get; set; } = "Media timeline. Arrows move or trim clips; up and down change tracks.";
    static string F(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if (!double.IsFinite(Duration) || Duration <= 0 || !double.IsFinite(Snap) || Snap <= 0 || Snap > Duration) throw new ArgumentOutOfRangeException(nameof(Duration));
        if (Clips.Select(c => c.Id).Distinct().Count() != Clips.Count || Clips.Any(c => !double.IsFinite(c.Start) || !double.IsFinite(c.Duration) || c.Start < 0 || c.Duration < Snap || c.Start + c.Duration > Duration || c.Track < 0 || c.Track > 99)) throw new ArgumentException("Clips require unique IDs and valid timeline bounds.", nameof(Clips));
    }
}
