@inherits UiComponentBase

@* CodeBlock — now with Prism.js (https://prismjs.com).

   Shadcn''s docs use MDX and export nothing; this component is the docs site itself.
   Previously it rendered raw text with no highlighting ("colour comes back the day
   someone wants it enough to pay for it"). That day is now: Prism core + autoloader +
   normalize-whitespace + line-numbers, vendored under wwwroot/prism/ and highlighted
   via up.compiler(''[data-slot="code-block"]'') so it survives Unpoly fragment swaps.

   Decisions:
   - Code is still a string, not ChildContent — Razor would parse `<Button>` as a component.
   - Language is a Prism language (`csharp`, `cshtml`/`razor`, `javascript`, `typescript`,
     `css`, `html`, `json`, `bash`, `yaml`, `sql`, …). Class `language-xxxx` is added to
     both <pre> and <code> as Prism recommends; `data-language` is kept for parity/tests.
   - `ShowLineNumbers` adds `line-numbers` to <pre> (prism-line-numbers.css). Off by default.
   - Copy button is unchanged — compiler in ui.js reveals it when navigator.clipboard exists.
     Prism''s own copy plugin is not used to avoid duplicate buttons.
   - Prism is loaded `data-manual` so it does not auto-highlight on DOMContentLoaded;
     the compiler calls `Prism.highlightElement` per block and re-runs on every Unpoly swap.
*@

<div data-slot="code-block" class="@Classes" @attributes="AdditionalAttributes">
    @if (Title is not null || ShowCopy)
    {
        <div data-slot="code-block-header"
             class="flex items-center justify-between gap-2 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">@Title</span>
            @if (ShowCopy)
            {
                <button type="button" data-slot="code-block-copy" hidden
                        class="@ButtonVariants.Of("ghost", "sm")" aria-label="@CopyLabel">
                    <Icon Name="copy" />
                    <span class="sr-only">@CopyLabel</span>
                </button>
            }
        </div>
    }

    <pre data-slot="code-block-pre"
         class="@PreClasses"
         tabindex="0"><code data-slot="code-block-code"
                            data-language="@Language"
                            class="@CodeClasses">@Code</code></pre>
</div>

@code {
    /// <summary>The snippet. A string, not markup — Razor would otherwise parse it.</summary>
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    /// <summary>Shown in the header, usually a file name.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Prism language: csharp, cshtml, razor, javascript, typescript, css, html, json, bash, yaml, sql, diff, docker, etc.</summary>
    [Parameter] public string? Language { get; set; }

    [Parameter] public bool ShowCopy { get; set; } = true;

    [Parameter] public string CopyLabel { get; set; } = "Copy";

    /// <summary>When true, adds Prism line-numbers (requires prism-line-numbers.css/js).</summary>
    [Parameter] public bool ShowLineNumbers { get; set; }

    const string Base =
        "bg-card text-card-foreground overflow-hidden rounded-lg border font-mono";

    string Classes => Cn(Base, Class);

    // Normalize Language for Prism: `razor` → `cshtml`, `cs` → `csharp`, `js` → `javascript`, `ts` → `typescript`, `sh` → `bash`, `yml` → `yaml`.
    string? NormalizedLanguage => Language?.Trim().ToLowerInvariant() switch
    {
        "razor" => "cshtml",
        "cs" => "csharp",
        "js" => "javascript",
        "ts" => "typescript",
        "sh" or "shell" => "bash",
        "yml" => "yaml",
        null or "" => null,
        var other => other
    };

    string CodeClasses => NormalizedLanguage is null ? "" : $"language-{NormalizedLanguage}";

    string PreClasses => Cn(
        "overflow-x-auto p-4 text-[12.5px] leading-relaxed",
        NormalizedLanguage is not null ? $"language-{NormalizedLanguage}" : null,
        ShowLineNumbers ? "line-numbers" : null);
}
