@inherits UiComponentBase

@* Cropper.js is initialized by the platform compiler on both hosts. The crop is emitted
   as a PNG data URL in the image-crop:apply CustomEvent (detail.dataUrl). *@
<div data-slot="image-crop" data-aspect-ratio="@AspectRatio?.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-circular="@(Circular ? "true" : "false")"
     data-max-image-size="@MaxImageSize" class="@Class" @attributes="AdditionalAttributes">
    <div data-crop-stage><img src="@Src" alt="@Alt" style="display:block;max-width:100%" /></div>
    <div data-crop-toolbar>
        <div role="group" aria-label="Crop zoom">
            <Button Type="button" Variant="outline" Size="icon" data-crop-zoom="-0.1" aria-label="Zoom out"><Icon Name="zoom-out" /></Button>
            <Button Type="button" Variant="outline" Size="icon" data-crop-zoom="0.1" aria-label="Zoom in"><Icon Name="zoom-in" /></Button>
        </div>
        <div data-crop-ratio-control>
            <span>Aspect ratio</span>
            <Select Size="sm" data-crop-ratio aria-label="Crop aspect ratio" disabled="@Circular">
                <SelectItem Value="free" Selected="@(AspectRatio is null && !Circular)">Free</SelectItem>
                @foreach (var ratio in Ratios)
                {
                    <SelectItem Value="@F(ratio.Value)" Selected="@(Circular ? ratio.Value == 1 : AspectRatio == ratio.Value)">@ratio.Label</SelectItem>
                }
                @if (!Circular && AspectRatio is double custom && !Ratios.Any(r => r.Value == custom))
                {
                    <SelectItem Value="@F(custom)" Selected="true">@($"{custom:0.###}:1")</SelectItem>
                }
            </Select>
        </div>
        <div data-crop-actions>
            <Button Type="button" Variant="outline" Size="sm" data-slot="image-crop-reset">@ResetLabel</Button>
            <Button Type="button" Size="sm" data-slot="image-crop-apply"><Icon Name="crop" /> @ApplyLabel</Button>
        </div>
    </div>
    <details data-crop-details>
        <summary>Crop position and size</summary>
        <div data-crop-fields role="group" aria-label="Crop position and size">
            @foreach (var field in new[] { "x", "y", "width", "height" })
            {
                <label>@field <Input type="number" min="0" step="1" data-crop-field="@field" aria-label="@($"Crop {field}")" /></label>
            }
        </div>
    </details>
    <p data-crop-status role="status" aria-live="polite"></p>
    @ChildContent
</div>

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string Alt { get; set; } = "Image to crop";
    /// <summary>Width divided by height; null allows free-form cropping.</summary>
    [Parameter] public double? AspectRatio { get; set; }
    [Parameter] public bool Circular { get; set; }
    /// <summary>Maximum exported PNG size in bytes (0 means unlimited).</summary>
    [Parameter] public long MaxImageSize { get; set; }
    [Parameter] public string ApplyLabel { get; set; } = "Apply crop";
    [Parameter] public string ResetLabel { get; set; } = "Reset crop";
    static readonly (double Value, string Label)[] Ratios = { (1, "1:1"), (4d / 3, "4:3"), (16d / 9, "16:9") };
    static string F(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if (AspectRatio is double ratio && (!double.IsFinite(ratio) || ratio <= 0)) throw new ArgumentOutOfRangeException(nameof(AspectRatio));
        if (MaxImageSize < 0) throw new ArgumentOutOfRangeException(nameof(MaxImageSize));
    }
}
