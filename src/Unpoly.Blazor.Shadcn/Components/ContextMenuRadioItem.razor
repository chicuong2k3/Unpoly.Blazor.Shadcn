@inherits UiComponentBase

@* As with the checkbox item: the state is a real radio input, so the group posts. All items in
   one group share a Name, which is what makes them a group in the DOM. *@

<label data-slot="context-menu-radio-item" role="menuitemradio"
       aria-checked="@(Checked ? "true" : "false")"
       data-disabled="@(Disabled ? "" : null)" class="@Classes"
       @attributes="AdditionalAttributes">
    @* bg-current painted the dot whether or not the item was chosen, so every row in the group
       looked selected. The dot is the input's own ::after, which appears on :checked and nowhere
       else — so the background here has to be nothing at all. *@
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
        <RadioGroupItem name="@Name" value="@Value" checked="@Checked" disabled="@Disabled"
                        Class="size-2 border-0 bg-transparent shadow-none" />
    </span>
    @ChildContent
</label>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }

    const string Base =
        "relative flex cursor-default items-center gap-2 rounded-sm py-1.5 pr-2 pl-8 " +
        "text-control outline-hidden select-none focus:bg-accent focus:text-accent-foreground " +
        "data-[disabled]:pointer-events-none data-[disabled]:opacity-50 " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4";

    string Classes => Cn(Base, Class);
}
