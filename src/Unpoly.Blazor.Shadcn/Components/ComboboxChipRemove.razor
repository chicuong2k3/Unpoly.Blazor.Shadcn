@inherits UiComponentBase

@* "Remove Summer", never "Remove". A row of buttons all announced the same way is a row nobody
   can navigate by name. *@

<button type="button" data-slot="combobox-chip-remove" aria-label="@Label" class="@Classes"
        @attributes="AdditionalAttributes">
    <Icon Name="x" Class="size-3" />
</button>

@code {
    [Parameter] public string Label { get; set; } = "Remove";

    const string Base =
        "ml-0.5 opacity-60 hover:opacity-100 rounded-sm";

    string Classes => Cn("ml-0.5 rounded-sm opacity-60 hover:opacity-100", Base, Class);
}
