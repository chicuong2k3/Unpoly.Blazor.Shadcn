@inherits UiComponentBase

@* shadcn's own unenhanced select, kept separate from <Select> on purpose: this one is never
   upgraded by ui.js, so it always shows the OS panel. Use it where that is what you want — a
   long list on a phone, a form that must not depend on any script at all. *@

<div data-slot="native-select-wrapper" class="relative">
    <select data-slot="native-select" data-size="@Size" class="@Classes"
            @attributes="AdditionalAttributes">@ChildContent</select>
    <Icon Name="chevron-down" data-slot="native-select-icon"
          Class="pointer-events-none absolute top-1/2 end-3 size-4 -translate-y-1/2 opacity-50" />
</div>

@code {
    /// <summary>default | sm</summary>
    [Parameter] public string Size { get; set; } = "default";

    const string Base =
        "h-control w-full min-w-0 appearance-none rounded-md border border-input " +
        "bg-transparent px-3 py-2 pe-9 text-control shadow-xs transition-[color,box-shadow] " +
        "outline-none selection:bg-primary selection:text-primary-foreground " +
        "placeholder:text-muted-foreground disabled:pointer-events-none " +
        "disabled:cursor-not-allowed data-[size=sm]:h-8 data-[size=sm]:py-1 dark:bg-input/30 " +
        "dark:hover:bg-input/50 focus-visible:border-ring focus-visible:ring-[3px] " +
        "focus-visible:ring-ring/50 aria-invalid:border-destructive " +
        "aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40";

    string Classes => Cn(Base, Class);
}
