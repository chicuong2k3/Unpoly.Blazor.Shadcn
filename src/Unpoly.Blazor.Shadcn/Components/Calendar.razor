@inherits UiComponentBase

@* A month, as a table — because a calendar is a table: seven columns of days under seven column
   headers, and every screen reader already knows how to read one. react-day-picker builds it out
   of divs and then reimplements that, mostly correctly.

   Months renders several side by side under one nav, as shadcn's numberOfMonths does.

   Mode decides what a day IS, and that is the whole of range selection here:

     single  a radio named Name. One of them wins, the browser gives the arrow keys, Home and
             End inside the group for nothing, and choosing one posts a date with no script.

     range   a CHECKBOX named Name. Tick the first day and the last and the server takes the min
             and the max — a working range picker with JavaScript switched off, which is not
             something a component built on a state variable can offer. ui.js then makes it
             behave the way a range picker should: a third click starts again, and the days
             between fill in as you go.

   For picking a single date in a form, <DatePicker> around <input type="date"> is smaller and
   better still. This is for when the month has to be visible — availability, a booking grid,
   anything where the shape of the month is the information. *@

<div data-slot="calendar" data-mode="@Mode" data-month="@Month.ToString("yyyy-MM")"
     data-months="@Months" class="@Classes" @attributes="AdditionalAttributes">
    @if (MonthUrl is not null)
    {
        @* Two links to two real URLs, not two buttons and a state variable — so a month is
           bookmarkable, the back button moves through months, and it all works before any
           JavaScript has run. Give it an up-target and only the calendar is swapped. *@
        <div data-slot="calendar-nav" class="mb-2 flex items-center justify-between gap-2">
            <a href="@MonthUrl(Month.AddMonths(-1))"
               class="@Cn(ButtonVariants.Of("ghost", "icon-sm"))"
               aria-label="@PreviousLabel"><Icon Name="chevron-left" Class="rtl:rotate-180" /></a>

            <span class="text-sm font-medium" aria-live="polite">@Caption</span>

            <a href="@MonthUrl(Month.AddMonths(Span))"
               class="@Cn(ButtonVariants.Of("ghost", "icon-sm"))"
               aria-label="@NextLabel"><Icon Name="chevron-right" Class="rtl:rotate-180" /></a>
        </div>
    }

    <div data-slot="calendar-months" class="flex flex-col gap-4 sm:flex-row">
        @for (var offset = 0; offset < Span; offset++)
        {
            var month = First.AddMonths(offset);
            <table data-slot="calendar-month" class="w-full border-separate border-spacing-y-1">
                <caption class="@(MonthUrl is null && Span == 1 ? "sr-only" : "pb-2 text-sm font-medium")">
                    @month.ToString("MMMM yyyy")
                </caption>
                <thead>
                    <tr>
                        @foreach (var day in Weekdays)
                        {
                            <th scope="col" class="pb-2 text-xs font-normal text-muted-foreground">
                                <span aria-hidden="true">@day[..1]</span>
                                <span class="sr-only">@day</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var week in WeeksOf(month))
                    {
                        <tr>
                            @foreach (var date in week)
                            {
                                <td class="@CellClasses(date)">
                                    @if (date is { } d)
                                    {
                                        var disabled = Disabled?.Invoke(d) ?? false;
                                        <label aria-current="@(d == Today ? "date" : null)"
                                               class="@DayClasses(d, disabled)">
                                            <input type="@(Mode == "range" ? "checkbox" : "radio")"
                                                   name="@Name" value="@d.ToString("yyyy-MM-dd")"
                                                   class="sr-only peer" checked="@IsChecked(d)"
                                                   disabled="@disabled" />
                                            <span class="num">@d.Day</span>
                                        </label>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    /// <summary>Any date in the first month to show. Only the year and month are read.</summary>
    [Parameter] public DateOnly Month { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>How many consecutive months to draw, as shadcn's numberOfMonths.</summary>
    [Parameter] public int Months { get; set; } = 1;

    /// <summary>single | range. Range makes each day a checkbox — see the note above.</summary>
    [Parameter] public string Mode { get; set; } = "single";

    /// <summary>The field the chosen day posts under. Without it nothing is selectable.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public DateOnly? Selected { get; set; }

    /// <summary>The first day of the range, when Mode is range.</summary>
    [Parameter] public DateOnly? From { get; set; }

    /// <summary>The last day of the range, when Mode is range.</summary>
    [Parameter] public DateOnly? To { get; set; }

    /// <summary>Today, marked with aria-current. Null in tests, so the render is deterministic.</summary>
    [Parameter] public DateOnly? Today { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>Days that cannot be chosen — a booked date, a closing day, the past.</summary>
    [Parameter] public Func<DateOnly, bool>? Disabled { get; set; }

    /// <summary>Monday first. Set it for a locale that starts on Sunday.</summary>
    [Parameter] public DayOfWeek FirstDay { get; set; } = DayOfWeek.Monday;

    /// <summary>
    /// Where the previous and next months live, as a function of the month. Without it no
    /// navigation is drawn at all — a component cannot invent an application's URLs, and two
    /// arrows that go nowhere are worse than none.
    /// </summary>
    [Parameter] public Func<DateOnly, string>? MonthUrl { get; set; }

    [Parameter] public string PreviousLabel { get; set; } = "Previous month";
    [Parameter] public string NextLabel { get; set; } = "Next month";

    int Span => Math.Max(1, Months);

    DateOnly First => new(Month.Year, Month.Month, 1);

    string Caption
    {
        get
        {
            var last = First.AddMonths(Span - 1);
            return First == last
                ? First.ToString("MMMM yyyy")
                : First.ToString("MMMM yyyy") + " – " + last.ToString("MMMM yyyy");
        }
    }

    bool IsChecked(DateOnly d) => Mode == "range" ? d == From || d == To : d == Selected;

    bool Between(DateOnly d) => From is { } f && To is { } t && d > f && d < t;

    bool IsEnd(DateOnly d) => From is not null && To is not null && (d == From || d == To);

    string[] Weekdays =>
        Enumerable.Range(0, 7)
            .Select(i => System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat
                .GetAbbreviatedDayName((DayOfWeek)(((int)FirstDay + i) % 7)))
            .ToArray();

    IEnumerable<DateOnly?[]> WeeksOf(DateOnly month)
    {
        var first = new DateOnly(month.Year, month.Month, 1);
        var lead = ((int)first.DayOfWeek - (int)FirstDay + 7) % 7;
        var days = DateTime.DaysInMonth(month.Year, month.Month);

        var cells = new List<DateOnly?>();
        cells.AddRange(Enumerable.Repeat((DateOnly?)null, lead));
        cells.AddRange(Enumerable.Range(1, days).Select(d => (DateOnly?)first.AddDays(d - 1)));
        while (cells.Count % 7 != 0) cells.Add(null);

        for (var i = 0; i < cells.Count; i += 7) yield return cells.GetRange(i, 7).ToArray();
    }

    // The band between the two ends is painted on the CELL, not on the day, so it runs edge to
    // edge across the gap between columns. The day itself keeps its own rounded box on top.
    string CellClasses(DateOnly? date) => date is not { } d ? "p-0" : Cn(
        "p-0",
        Between(d) || IsEnd(d) ? "bg-accent" : "",
        d == From && To is not null ? "rounded-s-md" : "",
        d == To && From is not null ? "rounded-e-md" : "");

    // aria-current is what tells a screen reader which day is today; a ring only tells eyes, and
    // a calendar where today is a colour and nothing else is one half its readers cannot orient in.
    string DayClasses(DateOnly date, bool disabled) => Cn(
        "flex size-9 items-center justify-center rounded-md text-sm",
        disabled ? "pointer-events-none opacity-40" : "cursor-pointer hover:bg-accent",
        "has-[:checked]:bg-primary has-[:checked]:text-primary-foreground",
        "has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-ring/50",
        date == Today ? "ring-1 ring-primary" : "");

    string Classes => Cn("", Class);
}
