@inherits UiComponentBase

<div data-slot="bubble-reactions" data-side="@Side" data-align="@Align" class="@Classes"
     @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>top | bottom — which edge of the bubble they sit against.</summary>
    [Parameter] public string Side { get; set; } = "bottom";

    /// <summary>start | end. End, as upstream: reactions hang off the trailing corner.</summary>
    [Parameter] public string Align { get; set; } = "end";

    const string Base =
        "absolute z-10 flex w-fit shrink-0 items-center justify-center gap-1 rounded-full " +
        "bg-muted px-1.5 py-0.5 text-control ring-3 ring-card has-[button]:p-0";

    string SideClass => Side switch
    {
        "top" => "top-0 -translate-y-3/4",
        _ => "bottom-0 translate-y-3/4",
    };

    string AlignClass => Align switch
    {
        "start" => "left-3",
        _ => "right-3",
    };

    string Classes => Cn(Base, SideClass, AlignClass, Class);
}
