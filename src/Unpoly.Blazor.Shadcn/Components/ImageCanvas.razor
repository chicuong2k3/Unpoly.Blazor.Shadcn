@inherits UiComponentBase
<div data-slot="image-canvas" data-width="@Width" data-height="@Height" class="@Class" @attributes="AdditionalAttributes">
    <div data-canvas-toolbar>
        <div data-canvas-view-controls role="group" aria-label="Canvas view">
            <span data-canvas-caption>Canvas</span>
            <Button Type="button" Variant="ghost" Size="icon" data-canvas-action="zoom-out" aria-label="Zoom out"><Icon Name="zoom-out" /></Button>
            <Button Type="button" Variant="ghost" Size="icon" data-canvas-action="zoom-in" aria-label="Zoom in"><Icon Name="zoom-in" /></Button>
            <Button Type="button" Variant="outline" Size="sm" data-canvas-action="fit"><Icon Name="maximize" /> Fit image</Button>
        </div>
    </div>
    <div data-canvas-viewport tabindex="0" role="group" aria-label="@Label">
        <div data-canvas-plane>
            @if (Src is not null) { <img src="@Src" alt="@Alt" draggable="false" /> }
            @ChildContent
        </div>
    </div>
</div>
@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string Alt { get; set; } = "Canvas image";
    [Parameter] public string Label { get; set; } = "Image canvas. Use arrows to pan, plus and minus to zoom, Home to fit.";
    [Parameter] public int Width { get; set; } = 1024;
    [Parameter] public int Height { get; set; } = 1024;
    protected override void OnParametersSet()
    {
        if (Width < 1 || Height < 1 || Width > 8192 || Height > 8192) throw new ArgumentOutOfRangeException(nameof(Width), "Canvas dimensions must be 1–8192.");
    }
}
