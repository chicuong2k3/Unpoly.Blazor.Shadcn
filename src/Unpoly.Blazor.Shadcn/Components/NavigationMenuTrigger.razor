@inherits UiComponentBase

@* popovertarget opens the panel with no script at all. The chevron turns on the open state,
   which the compiler that mirrors popover state supplies. *@

<button type="button" data-slot="navigation-menu-trigger" data-target="@Target"
        popovertarget="@Target" aria-expanded="false" class="@Classes"
        @attributes="AdditionalAttributes">
    @ChildContent
    <Icon Name="chevron-down"
          Class="relative top-[1px] ms-1 size-3 transition duration-300 group-data-[state=open]:rotate-180"
          aria-hidden="true" />
</button>

@code {
    /// <summary>The id of the <see cref="NavigationMenuContent"/> this opens.</summary>
    [Parameter, EditorRequired] public string Target { get; set; } = default!;

    // The whole recipe, which the component had dropped: upstream renders
    // cn(navigationMenuTriggerStyle(), "group", className) and this carried only the "group".
    // A trigger with no height, no padding and no background is bare text with a chevron after
    // it, which is what the menu bar looked like.
    string Classes => NavigationMenuTriggerStyle.Of(Cn("group", Class));
}
