@inherits UiComponentBase
@* role="group": aria-label on an element with no role is ignored, so without it the library was
   never announced by name. *@
<div data-slot="media-grid" data-lightbox-target="@LightboxTarget" class="@Class" role="group" aria-label="@Label" aria-busy="@(Loading ? "true" : null)" @attributes="AdditionalAttributes">
    @if (Loading) { <div data-media-loading role="status"><Skeleton style="height:8rem" /><span>@LoadingLabel</span></div> }
    else if (Error is not null) { <p role="alert">@Error</p> }
    else if (Items.Count == 0) { <p role="status">@EmptyLabel</p> }
    else
    {
        <div data-media-tiles>
        @foreach (var item in Items)
        {
            <figure data-media-id="@item.Id" data-selected="@(Selectable && SelectedIds.Contains(item.Id) ? "" : null)" @key="item.Id">
                <button type="button" data-media-preview="@item.Id" aria-label="@($"Preview {item.Alt}")">
                    @* A video's own source is never fetched here, so one without a thumbnail has no
                       image at all. An <img> with no src is invalid and draws as broken; the tile
                       keeps its shape with a placeholder instead. *@
                    @if (Thumbnail(item) is { } thumbnail)
                    {
                        <img data-media-thumbnail src="@thumbnail" alt="@item.Alt" loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <span data-media-placeholder aria-hidden="true"></span>
                    }
                    <span data-media-fallback hidden role="img" aria-label="@($"{item.Alt}: {ThumbnailErrorLabel}")">@ThumbnailErrorLabel</span>
                    @if (item.IsVideo) { <span data-media-kind><Icon Name="play" /> Video</span> }
                </button>
                @if (Selectable)
                {
                    <label><Checkbox name="assets" value="@item.Id" Checked="@(SelectedIds.Contains(item.Id))" /> @item.Alt</label>
                }
                else { <figcaption>@item.Alt</figcaption> }
            </figure>
        }
        </div>
    }
    @ChildContent
    @if (NextPageHref is not null) { <a href="@NextPageHref" rel="next">@MoreLabel</a> }
</div>
@code {
    [Parameter] public IReadOnlyList<MediaAsset> Items { get; set; } = Array.Empty<MediaAsset>();
    [Parameter] public IReadOnlySet<string> SelectedIds { get; set; } = new HashSet<string>();
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? NextPageHref { get; set; }
    [Parameter] public string? LightboxTarget { get; set; }
    [Parameter] public string Label { get; set; } = "Media library";
    [Parameter] public string EmptyLabel { get; set; } = "No media found.";
    [Parameter] public string LoadingLabel { get; set; } = "Loading media…";
    [Parameter] public string ThumbnailErrorLabel { get; set; } = "Preview unavailable";
    [Parameter] public string MoreLabel { get; set; } = "Next page";

    static string? Thumbnail(MediaAsset item) => item.ThumbnailSrc ?? (item.IsVideo ? null : item.Src);
}
