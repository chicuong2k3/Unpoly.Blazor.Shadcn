@inherits UiComponentBase

@* shadcn/ui <Input>. Everything but `type` arrives through @attributes, exactly as shadcn
   spreads `...props` — so `name`, `value`, `placeholder`, `required`, `up-validate` and the
   rest are written as plain HTML at the call site.

   Two-way binding via `@bind-Value` is also supported. When the caller passes ValueChanged
   (which `@bind-Value` generates), the input renders `value="@Value"` and an `@onchange` that
   raises it. When the caller does NOT bind — it splats a static `value="..."` like the docs do —
   the splat supplies the value and neither is emitted, so the two never conflict. *@

@if (ValueChanged.HasDelegate)
{
    <input type="@Type" data-slot="input" class="@Classes" value="@Value"
           @onchange="OnChange" @attributes="AdditionalAttributes" />
}
else
{
    <input type="@Type" data-slot="input" class="@Classes" @attributes="AdditionalAttributes" />
}

@code {
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>The bound value, from <c>@bind-Value</c>. Only rendered when binding is in use.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Raises on change when <c>@bind-Value</c> is used. Its presence decides whether the
    /// component renders the bound value/onchange or lets the <c>@attributes</c> splat do it.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    async Task OnChange(ChangeEventArgs e) =>
        await ValueChanged.InvokeAsync(e.Value?.ToString());

    const string Base =
        "h-control w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 " +
        "text-control shadow-xs transition-[color,box-shadow] outline-none " +
        "selection:bg-primary selection:text-primary-foreground file:inline-flex file:h-7 " +
        "file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground " +
        "placeholder:text-muted-foreground disabled:pointer-events-none " +
        "disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/30 " +
        "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 " +
        "aria-invalid:border-destructive aria-invalid:ring-destructive/20 " +
        "dark:aria-invalid:ring-destructive/40";

    string Classes => Cn(Base, Class);
}
