@inherits UiComponentBase

@* Video.js 10 default skin. <video-player> and <video-skin> are custom elements registered by ui.js,
   which imports videojs/video.js once when a [data-slot="video-player"] is on the page. The native
   controls stay on the <video> until the skin upgrades and takes over, so a failed import still
   leaves a usable player. The skin is themed through Video.js' public --media-* variables, mapped
   here onto this library's tokens. AspectRatio matters for portrait clips: the skin is a fixed box. *@
<video-player data-slot="video-player" class="@Class" content-title="@Title" lang="@Lang" style="display:block"
              @attributes="AdditionalAttributes">
    <video-skin style="display:block;width:100%;aspect-ratio:@AspectRatio;--media-accent-color:var(--primary);--media-accent-text-color:var(--primary-foreground);--media-border-radius:var(--radius);--media-font-family:var(--font-sans, inherit)">
        <video src="@Src" poster="@Poster" controls autoplay="@Autoplay" loop="@Loop" muted="@Muted"
               playsinline preload="@Preload">
            @ChildContent
        </video>
    </video-skin>
</video-player>

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Poster { get; set; }
    [Parameter] public bool Autoplay { get; set; }
    [Parameter] public bool Loop { get; set; }
    [Parameter] public bool Muted { get; set; }
    [Parameter] public string Preload { get; set; } = "metadata";

    /// <summary>Content title shown by the skin (the player's <c>content-title</c> attribute).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>CSS <c>aspect-ratio</c> of the player box, e.g. <c>16/9</c> or <c>9/16</c> for portrait clips.</summary>
    [Parameter] public string AspectRatio { get; set; } = "16/9";

    /// <summary>UI language; the Vietnamese locale is loaded by ui.js.</summary>
    [Parameter] public string Lang { get; set; } = "vi";
}
