@inherits UiComponentBase
@using Unpoly.Blazor.Shadcn.ECharts.Models
@* ECharts area chart — Lumeo parity *@
@if (IsLoading)
{
    <div data-slot="chart-skeleton" class="@SkeletonClasses" style="@($"height:{Height};width:{(Width ?? "100%")}")" role="status"><div class="h-full w-full animate-pulse rounded-md bg-muted"></div></div>
}
else
{
    <EChart Options="@BuildOptions()" Height="@Height" Width="@Width" Theme="@Theme" AriaLabel="@AriaLabel" Class="@Class" AdditionalAttributes="@AdditionalAttributes" />
}
@code {
    [Parameter] public string[] Categories { get; set; } = [];
    [Parameter] public double[] Values { get; set; } = [];
    [Parameter] public IReadOnlyList<ChartSeriesData>? Series { get; set; }
    [Parameter] public string SeriesName { get; set; } = "Value";
    [Parameter] public bool Smooth { get; set; } = true;
    [Parameter] public bool Stacked { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public bool GradientFill { get; set; }
    [Parameter] public string[]? Colors { get; set; }
    [Parameter] public string[]? Color { get; set; }
    [Parameter] public bool DataZoom { get; set; }
    [Parameter] public bool Toolbox { get; set; }
    [Parameter] public string Height { get; set; } = "350px";
    [Parameter] public string? Width { get; set; }
    [Parameter] public string Theme { get; set; } = "default";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool AccessibilityLayer { get; set; } = true;
    [Parameter] public Dictionary<string, object?>? OptionOverride { get; set; }
    string[] Palette => Colors ?? Color ?? [];
    string SkeletonClasses => Cn("block w-full max-w-full rounded-md border p-4", Class);
    object BuildOptions()
    {
        EChartsSeries[] series = Series is { Count: > 0 }
            ? Series.Select(s => new EChartsSeries { Type = "line", Name = s.Name, Data = s.Values, Smooth = Smooth, Stack = Stacked ? "total" : null, AreaStyle = GradientFill ? new { color = new { type = "linear", x=0, y=0, x2=0, y2=1, colorStops = new[] { new { offset=0, color = "rgba(59,130,246,0.5)" }, new { offset=1, color = "rgba(59,130,246,0)" } } } } : new { }, ShowSymbol=false }).ToArray()
            : [ new EChartsSeries { Type = "line", Name = SeriesName, Data = Values, Smooth = Smooth, Stack = Stacked ? "total" : null, AreaStyle = GradientFill ? new { color = new { type = "linear", x=0, y=0, x2=0, y2=1, colorStops = new[] { new { offset=0, color = "rgba(59,130,246,0.5)" }, new { offset=1, color = "rgba(59,130,246,0)" } } } } : new { }, ShowSymbol=false }];
        return new EChartsOption
        {
            Color = Palette.Length>0?Palette:null, Tooltip = ShowTooltip?new EChartsTooltip{Trigger="axis"}:null,
            Legend = ShowLegend && series.Length>1?new EChartsLegend{Data=series.Select(s=>s.Name!).ToArray(),Bottom="0"}:null,
            Grid = new EChartsGrid{Left="3%",Right="4%",Bottom=ShowLegend&&series.Length>1?"12%":"3%",ContainLabel=true},
            XAxis = new EChartsAxis{Type="category",Data=Categories,BoundaryGap=false}, YAxis = new{type="value"}, Series=series,
            DataZoom = DataZoom?new[]{new{type="slider"}}:null, Toolbox=Toolbox?new{feature=new{saveAsImage=new{},dataZoom=new{}}}:null, ExtensionData=OptionOverride
        };
    }
}
