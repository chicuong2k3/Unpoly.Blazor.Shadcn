<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Unpoly.Blazor.Shadcn.ECharts</RootNamespace>
    <AssemblyName>Unpoly.Blazor.Shadcn.ECharts</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <Description>Charts for Unpoly.Blazor.Shadcn — Apache ECharts rendering for Blazor static SSR with Unpoly. Separated from the core so the core ships no charting JS.</Description>
    <PackageTags>blazor;shadcn;echarts;charts;unpoly;ssr;tailwind</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/chicuong2k3/Unpoly.Blazor.Shadcn</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Unpoly.Blazor.Shadcn/Unpoly.Blazor.Shadcn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TailwindMerge.NET" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
